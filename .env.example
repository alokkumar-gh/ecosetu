# ECOSETU — Master Environment Variables Template
# Copy this file to .env or create environment-specific configs

# ==============================================================================
# 1. BACKEND SERVICE CONFIGURATION (backend/.env)
# ==============================================================================
NODE_ENV=development
PORT=3001

# PostgreSQL Connection String (Prisma format)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecosetu_dev?schema=public

# JWT Security Secrets (Use random 64-character hex strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin
CORS_ORIGIN=*

# AI Vision Service Configuration
AI_PROVIDER=roboflow
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=e-waste-dataset-r0ojc/43
ROBOFLOW_TIMEOUT_MS=15000
AI_SERVICE_URL=https://ecosetu-ai.onrender.com

# Local / Cloud Storage Configuration
UPLOAD_DIR=./uploads

# Firebase / Push Notification Credentials
FIREBASE_PROJECT_ID=ecosetu-production
FIREBASE_STORAGE_BUCKET=ecosetu-production.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=./ecosetu-firebase-credentials.json

# Razorpay Payment Gateway (Server-side)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==============================================================================
# 2. MOBILE APP CONFIGURATION (mobile/.env)
# ==============================================================================
EXPO_PUBLIC_API_URL=https://ecosetu-backend.onrender.com/api/v1
EXPO_PUBLIC_AI_API_URL=https://ecosetu-ai.onrender.com
EXPO_PUBLIC_APP_ENV=production
