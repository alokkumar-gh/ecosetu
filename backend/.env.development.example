# EcoSetu Backend — Development Environment Template
# Canonical Reference: docs/15_DEPLOYMENT_GUIDE.md Section 2.3

NODE_ENV=development
PORT=3001

# Local PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecosetu_dev?schema=public

# Development JWT Secrets
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_64chars_abcdef0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_64chars_abcdef0123456789
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origin for local testing
CORS_ORIGIN=*

# Local AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Cloud Storage (Optional - leave blank for local uploads in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Upload Directory
UPLOAD_DIR=./uploads

# Logging Level
LOG_LEVEL=debug
