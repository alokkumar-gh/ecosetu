# EcoSetu Backend — Production Environment Template
# Canonical Reference: docs/15_DEPLOYMENT_GUIDE.md Section 5, docs/13_SECURITY_PRIVACY.md Section 8
#
# CRITICAL:
# 1. Do NOT commit the actual production .env file to version control.
# 2. Production secrets must be strong, unique, and randomly generated.
# 3. Supply secrets via Google Cloud Secret Manager or Cloud Run Environment Variables.
# 4. Replace all CHANGE_ME placeholders with genuine production secrets before launching.

NODE_ENV=production
# In Google Cloud Run, $PORT is dynamically injected by the runtime (defaults to 8080 or 3001)
PORT=8080

# Production PostgreSQL Database URL (Google Cloud SQL or Managed PostgreSQL with SSL enforced)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Cloud SQL Auth Proxy socket format: postgresql://USER:PASSWORD@localhost/DATABASE?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgresql://ecosetu_user:CHANGE_ME_DATABASE_PASSWORD@CHANGE_ME_POSTGRES_HOST:5432/ecosetu_production?sslmode=require

# JWT Secrets — Generate using: openssl rand -hex 32 (minimum 64 hex characters)
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_HEX_ACCESS_SECRET_0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_HEX_REFRESH_SECRET_0123456789abcdef0123456789abcdef
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Production CORS — Comma-separated list of allowed web origins (do NOT use '*' in production)
# Note: Native Android mobile apps and server-to-server requests without Origin headers are allowed.
CORS_ORIGIN=https://ecosetu.org,https://admin.ecosetu.org

# Production AI Microservice URL (FastAPI running on Google Cloud Run)
# Secure service-to-service Cloud Run endpoint
AI_SERVICE_URL=https://ecosetu-ai-CHANGE_ME-uc.a.run.app

# Firebase Project Configuration (Push Notifications & Media Storage)
FIREBASE_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=CHANGE_ME_FIREBASE_PROJECT_ID.firebasestorage.app
# Firebase Service Account Credentials (loaded via GOOGLE_APPLICATION_CREDENTIALS or individual env vars)
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-service-account.json
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@CHANGE_ME_FIREBASE_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME_KEY\n-----END PRIVATE KEY-----\n"

# Cloud Media Storage (Optional Cloudinary legacy support or Firebase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local Fallback Upload Directory
UPLOAD_DIR=/tmp/ecosetu_uploads

# Logging Level (error, warn, info)
LOG_LEVEL=info
