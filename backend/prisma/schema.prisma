  transaction          TransactionRecord   @relation("TransactionRazorpayPayments", fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId], map: "idx_rzp_transaction")
  @@index([orderId], map: "idx_rzp_order")
  @@index([paymentId], map: "idx_rzp_payment")
  @@index([status], map: "idx_rzp_status")
  @@map("razorpay_payment_records")
}

model TransactionBill {
  id                   String           @id @default(uuid()) @db.Uuid
  billNumber           String           @unique @map("bill_number") @db.VarChar(50)
  transactionId        String           @unique @map("transaction_id") @db.Uuid
  materialLotId        String           @map("material_lot_id") @db.Uuid
  quoteId              String           @map("quote_id") @db.Uuid
  handoverId           String           @map("handover_id") @db.Uuid
  buyerUserId          String           @map("buyer_user_id") @db.Uuid
  buyerRole            UserRole         @map("buyer_role")
  sellerUserId         String           @map("seller_user_id") @db.Uuid
  sellerRole           UserRole         @map("seller_role")
  materialCategory     MaterialCategory @map("material_category")
  materialSubcategory  String?          @map("material_subcategory") @db.VarChar(100)
  quantity             Decimal          @db.Decimal(10, 2)
  unit                 PriceUnit        @default(PER_KG)
  agreedRate           Decimal          @map("agreed_rate") @db.Decimal(12, 2)
  subtotal             Decimal          @db.Decimal(12, 2)
  adjustments          Decimal          @default(0.00) @db.Decimal(12, 2)
  finalAmount          Decimal          @map("final_amount") @db.Decimal(12, 2)
  paymentMethod        PaymentMethod    @map("payment_method")
  paymentStatus        PaymentStatus    @map("payment_status")
  transactionDate      DateTime         @map("transaction_date") @db.Timestamptz(6)
  generatedAt          DateTime         @default(now()) @map("generated_at") @db.Timestamptz(6)
  currency             String           @default("INR") @db.VarChar(10)
  providerReference    String?          @map("provider_reference") @db.VarChar(150)
  disputeReference     String?          @map("dispute_reference") @db.VarChar(50)
  verificationHash     String?          @map("verification_hash") @db.VarChar(255)
  notes                String?          @db.Text
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction          TransactionRecord @relation("TransactionBillRecord", fields: [transactionId], references: [id], onDelete: Restrict)
  materialLot          MaterialLot      @relation("LotBills", fields: [materialLotId], references: [id], onDelete: Restrict)
  quote                Quote            @relation("QuoteBills", fields: [quoteId], references: [id], onDelete: Restrict)
  handover             HandoverRecord   @relation("HandoverBills", fields: [handoverId], references: [id], onDelete: Restrict)
  buyerUser            User             @relation("BuyerBills", fields: [buyerUserId], references: [id], onDelete: Restrict)
  sellerUser           User             @relation("SellerBills", fields: [sellerUserId], references: [id], onDelete: Restrict)

  @@index([billNumber], map: "idx_bill_number")
  @@index([transactionId], map: "idx_bill_transaction")
  @@index([materialLotId], map: "idx_bill_lot")
  @@index([buyerUserId], map: "idx_bill_buyer")
  @@index([sellerUserId], map: "idx_bill_seller")
  @@index([paymentStatus], map: "idx_bill_status")
  @@index([generatedAt], map: "idx_bill_generated")
  @@map("transaction_bills")
}




