  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  recycler              RecyclerProfile   @relation("RecyclerPickupBatches", fields: [recyclerId], references: [id], onDelete: Restrict)
  collector             CollectorProfile? @relation("CollectorPickupBatches", fields: [collectorId], references: [id], onDelete: Restrict)
  createdBy             User              @relation("UserCreatedPickupBatches", fields: [createdById], references: [id], onDelete: Restrict)
  lots                  PickupBatchLot[]  @relation("BatchLotsList")
  handovers             HandoverRecord[]  @relation("BatchHandoversList")
  disputes              MarketplaceDispute[] @relation("BatchDisputes")

  @@index([recyclerId], map: "idx_pb_recycler")
  @@index([collectorId], map: "idx_pb_collector")
  @@index([status], map: "idx_pb_status")
  @@index([scheduledDate], map: "idx_pb_scheduled")
  @@index([createdAt], map: "idx_pb_created")
  @@map("pickup_batches")
}

model PickupBatchLot {
  id             String         @id @default(uuid()) @db.Uuid
  batchId        String         @map("batch_id") @db.Uuid
  materialLotId  String         @map("material_lot_id") @db.Uuid
  addedById      String         @map("added_by_id") @db.Uuid
  status         String         @default("ACTIVE") @db.VarChar(30)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  batch          PickupBatch    @relation("BatchLotsList", fields: [batchId], references: [id], onDelete: Cascade)
  materialLot    MaterialLot    @relation("LotPickupBatches", fields: [materialLotId], references: [id], onDelete: Restrict)
  addedBy        User           @relation("UserAddedBatchLots", fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([batchId, materialLotId])
  @@index([batchId], map: "idx_pbl_batch")
  @@index([materialLotId], map: "idx_pbl_lot")
  @@map("pickup_batch_lots")
}

model SourcingRequest {
  id                    String                @id @default(uuid()) @db.Uuid
  referenceNumber       String                @unique @map("reference_number") @db.VarChar(50)
  recyclerId            String                @map("recycler_id") @db.Uuid
  materialCategory      MaterialCategory      @map("material_category")
  materialSubcategory   String?               @map("material_subcategory") @db.VarChar(100)
  condition             ItemCondition         @default(UNKNOWN)
  minimumWeightKg       Decimal               @map("minimum_weight_kg") @db.Decimal(10, 2)
  targetWeightKg        Decimal?              @map("target_weight_kg") @db.Decimal(10, 2)
  maximumWeightKg       Decimal?              @map("maximum_weight_kg") @db.Decimal(10, 2)
  requestedByDate       DateTime?             @map("requested_by_date") @db.Timestamptz(6)
  pickupRequired        Boolean               @default(false) @map("pickup_required")
  pickupArea            String?               @map("pickup_area") @db.VarChar(255)
  offeredRatePerKg      Decimal?              @map("offered_rate_per_kg") @db.Decimal(10, 2)
  rateUnit              PriceUnit             @default(PER_KG) @map("rate_unit")
  notes                 String?               @db.Text
  status                SourcingRequestStatus @default(OPEN)
  createdById           String                @map("created_by_id") @db.Uuid
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason    String?               @map("cancellation_reason") @db.VarChar(255)
  fulfilledAt           DateTime?             @map("fulfilled_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  recycler              RecyclerProfile       @relation("RecyclerSourcingRequests", fields: [recyclerId], references: [id], onDelete: Restrict)
  createdBy             User                  @relation("UserCreatedSourcingRequests", fields: [createdById], references: [id], onDelete: Restrict)
  responses             SourcingResponse[]    @relation("RequestSourcingResponses")

  @@index([recyclerId], map: "idx_sr_recycler")
  @@index([materialCategory], map: "idx_sr_category")
  @@index([status], map: "idx_sr_status")
  @@index([requestedByDate], map: "idx_sr_requested_by")
  @@index([createdAt], map: "idx_sr_created")
  @@map("sourcing_requests")
}

model SourcingResponse {
  id                    String                 @id @default(uuid()) @db.Uuid
  referenceNumber       String                 @unique @map("reference_number") @db.VarChar(50)
  sourcingRequestId     String                 @map("sourcing_request_id") @db.Uuid
  collectorId           String                 @map("collector_id") @db.Uuid
  availableWeightKg     Decimal                @map("available_weight_kg") @db.Decimal(10, 2)
  condition             ItemCondition          @default(UNKNOWN)
  pickupAddress         String?                @map("pickup_address") @db.VarChar(255)
  latitude              Decimal?               @db.Decimal(10, 7)
  longitude             Decimal?               @db.Decimal(10, 7)
  availableDate         DateTime?              @map("available_date") @db.Timestamptz(6)
  notes                 String?                @db.Text
  status                SourcingResponseStatus @default(PENDING)
  materialLotId         String?                @map("material_lot_id") @db.Uuid
  createdById           String                 @map("created_by_id") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sourcingRequest       SourcingRequest        @relation("RequestSourcingResponses", fields: [sourcingRequestId], references: [id], onDelete: Cascade)
  collector             CollectorProfile       @relation("CollectorSourcingResponses", fields: [collectorId], references: [id], onDelete: Restrict)
  materialLot           MaterialLot?           @relation("LotSourcingResponses", fields: [materialLotId], references: [id], onDelete: SetNull)
  createdBy             User                   @relation("UserCreatedSourcingResponses", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([sourcingRequestId], map: "idx_sres_request")
  @@index([collectorId], map: "idx_sres_collector")
  @@index([status], map: "idx_sres_status")
  @@index([createdAt], map: "idx_sres_created")
  @@map("sourcing_responses")
}

model MarketplaceDispute {
  id                         String                 @id @default(uuid()) @db.Uuid
  disputeReference           String                 @unique @map("dispute_reference") @db.VarChar(50)
  materialLotId              String                 @map("material_lot_id") @db.Uuid
  quoteId                    String?                @map("quote_id") @db.Uuid
  handoverId                 String?                @map("handover_id") @db.Uuid
  transactionId              String?                @map("transaction_id") @db.Uuid
  pickupBatchId              String?                @map("pickup_batch_id") @db.Uuid
  openedByUserId             String                 @map("opened_by_user_id") @db.Uuid
  openedByRole               UserRole               @map("opened_by_role")
  disputeType                DisputeType            @map("dispute_type")
  description                String                 @db.Text
  evidenceUrls               String[]               @default([]) @map("evidence_urls")
  disputedEstimatedWeightKg  Decimal?               @map("disputed_estimated_weight_kg") @db.Decimal(10, 2)
  disputedFinalWeightKg      Decimal?               @map("disputed_final_weight_kg") @db.Decimal(10, 2)
  disputedQuantityKg         Decimal?               @map("disputed_quantity_kg") @db.Decimal(10, 2)
  disputedAmount             Decimal?               @map("disputed_amount") @db.Decimal(12, 2)
  resolvedWeightKg           Decimal?               @map("resolved_weight_kg") @db.Decimal(10, 2)
  resolvedAmount             Decimal?               @map("resolved_amount") @db.Decimal(12, 2)
  acceptedQuantityKg         Decimal?               @map("accepted_quantity_kg") @db.Decimal(10, 2)
  rejectedQuantityKg         Decimal?               @map("rejected_quantity_kg") @db.Decimal(10, 2)
  returnTrackingNotes        String?                @map("return_tracking_notes") @db.Text
  returnedAt                 DateTime?              @map("returned_at") @db.Timestamptz(6)
  status                     DisputeStatus          @default(OPEN)
  resolutionType             DisputeResolutionType? @map("resolution_type")
  resolutionNotes            String?                @map("resolution_notes") @db.Text
  resolvedByUserId           String?                @map("resolved_by_user_id") @db.Uuid
  resolvedAt                 DateTime?              @map("resolved_at") @db.Timestamptz(6)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  materialLot                MaterialLot            @relation("LotDisputes", fields: [materialLotId], references: [id], onDelete: Restrict)
  quote                      Quote?                 @relation("QuoteDisputes", fields: [quoteId], references: [id], onDelete: SetNull)
  handover                   HandoverRecord?        @relation("HandoverDisputes", fields: [handoverId], references: [id], onDelete: SetNull)
  transaction                TransactionRecord?     @relation("TransactionDisputes", fields: [transactionId], references: [id], onDelete: SetNull)
  pickupBatch                PickupBatch?           @relation("BatchDisputes", fields: [pickupBatchId], references: [id], onDelete: SetNull)
  openedByUser               User                   @relation("UserOpenedDisputes", fields: [openedByUserId], references: [id], onDelete: Restrict)
  resolvedByUser             User?                  @relation("UserResolvedDisputes", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  events                     MarketplaceDisputeEvent[] @relation("DisputeEvents")
  cashConfirmations          CashPaymentConfirmation[] @relation("DisputeCashConfirmations")

  @@index([materialLotId], map: "idx_disp_lot")
  @@index([quoteId], map: "idx_disp_quote")
  @@index([handoverId], map: "idx_disp_handover")
  @@index([transactionId], map: "idx_disp_transaction")
  @@index([status], map: "idx_disp_status")
  @@index([openedByUserId], map: "idx_disp_opened_by")
  @@index([createdAt], map: "idx_disp_created")
  @@map("marketplace_disputes")
}

model MarketplaceDisputeEvent {
  id             String        @id @default(uuid()) @db.Uuid
  disputeId      String        @map("dispute_id") @db.Uuid
  actorUserId    String        @map("actor_user_id") @db.Uuid
  actorRole      UserRole      @map("actor_role")
  eventType      String        @map("event_type") @db.VarChar(50)
  previousStatus DisputeStatus @map("previous_status")
  newStatus      DisputeStatus @map("new_status")
  note           String?       @db.Text
  metadata       Json?         @db.JsonB
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  dispute        MarketplaceDispute @relation("DisputeEvents", fields: [disputeId], references: [id], onDelete: Cascade)
  actorUser      User               @relation("UserDisputeEvents", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([disputeId], map: "idx_dispe_dispute")
  @@index([actorUserId], map: "idx_dispe_actor")
  @@index([createdAt], map: "idx_dispe_created")
  @@map("marketplace_dispute_events")
}

model CashPaymentConfirmation {
  id                   String                 @id @default(uuid()) @db.Uuid
  transactionId        String                 @map("transaction_id") @db.Uuid
  payerUserId          String                 @map("payer_user_id") @db.Uuid
  payerRole            UserRole               @map("payer_role")
  receiverUserId       String                 @map("receiver_user_id") @db.Uuid
  receiverRole         UserRole               @map("receiver_role")
  expectedAmount       Decimal                @map("expected_amount") @db.Decimal(12, 2)
  confirmedAmount      Decimal?               @map("confirmed_amount") @db.Decimal(12, 2)
  payerConfirmedAt     DateTime?              @map("payer_confirmed_at") @db.Timestamptz(6)
  receiverConfirmedAt  DateTime?              @map("receiver_confirmed_at") @db.Timestamptz(6)
  status               CashConfirmationStatus @default(PENDING)
  discrepancyAmount    Decimal?               @map("discrepancy_amount") @db.Decimal(12, 2)
  disputeId            String?                @map("dispute_id") @db.Uuid
  notes                String?                @db.Text
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transaction          TransactionRecord      @relation("TransactionCashConfirmations", fields: [transactionId], references: [id], onDelete: Restrict)
  payerUser            User                   @relation("PayerCashConfirmations", fields: [payerUserId], references: [id], onDelete: Restrict)
  receiverUser         User                   @relation("ReceiverCashConfirmations", fields: [receiverUserId], references: [id], onDelete: Restrict)
  dispute              MarketplaceDispute?    @relation("DisputeCashConfirmations", fields: [disputeId], references: [id], onDelete: SetNull)

  @@index([transactionId], map: "idx_cpc_transaction")
  @@index([payerUserId], map: "idx_cpc_payer")
  @@index([receiverUserId], map: "idx_cpc_receiver")
  @@index([status], map: "idx_cpc_status")
  @@map("cash_payment_confirmations")
}

model RazorpayPaymentRecord {
  id                   String              @id @default(uuid()) @db.Uuid
  transactionId        String              @map("transaction_id") @db.Uuid
  orderId              String              @unique @map("order_id") @db.VarChar(100)
  paymentId            String?             @unique @map("payment_id") @db.VarChar(100)
  signature            String?             @db.VarChar(255)
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @default("INR") @db.VarChar(10)
  status               OnlinePaymentStatus @default(CREATED)
  method               String?             @db.VarChar(50)
  bank                 String?             @db.VarChar(100)
  wallet               String?             @db.VarChar(100)
  vpa                  String?             @db.VarChar(100)
  errorCode            String?             @map("error_code") @db.VarChar(100)
  errorDescription     String?             @map("error_description") @db.Text
  verifiedAt           DateTime?           @map("verified_at") @db.Timestamptz(6)
  webhookReceivedAt    DateTime?           @map("webhook_received_at") @db.Timestamptz(6)
  refundId             String?             @map("refund_id") @db.VarChar(100)
  refundAmount         Decimal?            @map("refund_amount") @db.Decimal(12, 2)
