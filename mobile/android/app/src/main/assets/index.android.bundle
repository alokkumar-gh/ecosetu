\u094d\u0937\u093e \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u093f\u0915\u093e \u0906\u092a\u0915\u0947 \u092b\u094b\u0928 \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964',learnSafety:'\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u092e \u0926\u0947\u0916\u0947\u0902',topics:{batteries:{title:'\u092c\u0948\u091f\u0930\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0916\u0930\u093e\u092c \u0935 \u092a\u0941\u0930\u093e\u0928\u0940 \u092c\u0948\u091f\u0930\u093f\u092f\u094b\u0902 \u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916-\u0930\u0916\u093e\u0935',warning:'\u092b\u091f\u0940 \u092f\u093e \u0917\u0930\u094d\u092e \u092c\u0948\u091f\u0930\u0940 \u092e\u0947\u0902 \u0906\u0917 \u0932\u0917 \u0938\u0915\u0924\u0940 \u0939\u0948, \u0935\u093f\u0938\u094d\u092b\u094b\u091f \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u092f\u093e \u091c\u0939\u0930\u0940\u0932\u093e \u0930\u0938\u093e\u092f\u0928 \u092c\u0939 \u0938\u0915\u0924\u093e \u0939\u0948\u0964',whyDangerous:'\u092c\u0948\u091f\u0930\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0930\u093e\u0938\u093e\u092f\u0928\u093f\u0915 \u090a\u0930\u094d\u091c\u093e \u0938\u0902\u091a\u093f\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u091b\u0947\u0926 \u0915\u0930\u0928\u0947, \u0915\u0941\u091a\u0932\u0928\u0947 \u092f\u093e \u0917\u0930\u094d\u092e \u0915\u0930\u0928\u0947 \u092a\u0930 \u092f\u0947 \u0924\u0947\u091c\u0940 \u0938\u0947 \u092d\u0921\u093c\u0915 \u0938\u0915\u0924\u0940 \u0939\u0948\u0902 \u092f\u093e \u0935\u093f\u0937\u0948\u0932\u093e \u090f\u0938\u093f\u0921 \u091b\u094b\u0921\u093c \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964',dont1:'\u092c\u0948\u091f\u0930\u0940 \u0915\u094b \u0915\u092d\u0940 \u091b\u0947\u0926\u0947\u0902, \u0915\u093e\u091f\u0947\u0902, \u0915\u0941\u091a\u0932\u0947\u0902, \u0916\u094b\u0932\u0947\u0902 \u092f\u093e \u091c\u0932\u093e\u090f\u0902 \u0928\u0939\u0940\u0902\u0964',dont2:'\u0915\u094d\u0937\u0924\u093f\u0917\u094d\u0930\u0938\u094d\u0924 \u092f\u093e \u092b\u0942\u0932\u0940 \u0939\u0941\u0908 \u092c\u0948\u091f\u0930\u0940 \u0915\u094b \u0917\u0930\u094d\u092e\u0940, \u0927\u0942\u092a \u092f\u093e \u091a\u093f\u0902\u0917\u093e\u0930\u0940 \u0915\u0947 \u092a\u093e\u0938 \u0928 \u0930\u0916\u0947\u0902\u0964',dont3:'\u0916\u0941\u0932\u0940 \u092f\u093e \u0932\u0940\u0915 \u0939\u094b\u0924\u0940 \u092c\u0948\u091f\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u0927\u093e\u0924\u0941 \u0915\u0947 \u092c\u0930\u094d\u0924\u0928\u094b\u0902 \u092f\u093e \u0905\u0928\u094d\u092f \u0915\u092c\u093e\u0921\u093c \u092e\u0947\u0902 \u0928 \u092e\u093f\u0932\u093e\u090f\u0902\u0964',do1:'\u092c\u0948\u091f\u0930\u0940 \u0915\u094b \u0916\u094b\u0932\u0947 \u092f\u093e \u0924\u094b\u0921\u093c\u0947 \u092c\u093f\u0928\u093e \u0915\u0947\u0935\u0932 \u092c\u093e\u0939\u0930 \u0938\u0947 \u091c\u093e\u0902\u091a\u0947\u0902\u0964',do2:'\u0915\u094d\u0937\u0924\u093f\u0917\u094d\u0930\u0938\u094d\u0924 \u092c\u0948\u091f\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u0938\u0942\u0916\u0947, \u0917\u0948\u0930-\u0927\u093e\u0924\u0941 \u0915\u0947 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0921\u093f\u092c\u094d\u092c\u0947 \u092e\u0947\u0902 \u0905\u0932\u0917 \u0930\u0916\u0947\u0902\u0964',do3:'\u0938\u092d\u0940 \u092c\u0948\u091f\u0930\u093f\u092f\u094b\u0902 \u0915\u094b \u0938\u0940\u0927\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0908-\u0915\u091a\u0930\u093e \u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u0930 \u092f\u093e \u0938\u0902\u0915\u0932\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u094b \u0938\u094c\u0902\u092a\u0947\u0902\u0964'},crts:{title:'\u0938\u0940\u0906\u0930\u091f\u0940 \u092e\u0949\u0928\u093f\u091f\u0930 \u0935 \u091f\u0940\u0935\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u092a\u093f\u0915\u094d\u091a\u0930 \u091f\u094d\u092f\u0942\u092c \u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u094d\u0930\u092c\u0902\u0927\u0928',warning:'\u0938\u0940\u0906\u0930\u091f\u0940 \u0915\u093e\u0902\u091a \u091f\u094d\u092f\u0942\u092c \u092e\u0947\u0902 \u0928\u093f\u0930\u094d\u0935\u093e\u0924 (\u0935\u0948\u0915\u094d\u092f\u0942\u092e) \u0939\u094b\u0924\u093e \u0939\u0948, \u091f\u0942\u091f\u0928\u0947 \u092a\u0930 \u0915\u093e\u0902\u091a \u0915\u0947 \u091f\u0941\u0915\u0921\u093c\u0947 \u0924\u0947\u091c\u0940 \u0938\u0947 \u092c\u093f\u0916\u0930\u0924\u0947 \u0939\u0948\u0902\u0964',whyDangerous:'\u0938\u0940\u0906\u0930\u091f\u0940 \u092a\u093f\u0915\u094d\u091a\u0930 \u091f\u094d\u092f\u0942\u092c \u0915\u0947 \u0905\u0902\u0926\u0930 \u092d\u093e\u0930\u0940 \u0935\u0948\u0915\u094d\u092f\u0942\u092e \u0914\u0930 \u0939\u093e\u0928\u093f\u0915\u093e\u0930\u0915 \u0932\u0947\u0921 \u0927\u093e\u0924\u0941 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0939\u0925\u094c\u0921\u093c\u093e \u092e\u093e\u0930\u0928\u0947 \u092a\u0930 \u0915\u093e\u0902\u091a \u0905\u0902\u0926\u0930 \u0915\u0940 \u0913\u0930 \u092b\u091f\u0924\u093e \u0939\u0948 \u0914\u0930 \u0928\u0941\u0915\u0940\u0932\u0947 \u091f\u0941\u0915\u0921\u093c\u0947 \u0909\u0921\u093c\u0924\u0947 \u0939\u0948\u0902\u0964',dont1:'\u0938\u0940\u0906\u0930\u091f\u0940 \u092a\u093f\u0915\u094d\u091a\u0930 \u091f\u094d\u092f\u0942\u092c \u0915\u094b \u0915\u092d\u0940 \u0939\u0925\u094c\u0921\u093c\u0947 \u0938\u0947 \u0928 \u092b\u094b\u0921\u093c\u0947\u0902 \u092f\u093e \u0924\u094b\u0921\u093c\u0947\u0902\u0964',dont2:'\u0938\u0940\u0906\u0930\u091f\u0940 \u092c\u0949\u0921\u0940, \u092f\u094b\u0915 \u0915\u0949\u0907\u0932 \u092f\u093e \u0905\u0902\u0926\u0930\u0942\u0928\u0940 \u0939\u093f\u0938\u094d\u0938\u094b\u0902 \u0915\u094b \u0906\u0917 \u092e\u0947\u0902 \u0928 \u091c\u0932\u093e\u090f\u0902\u0964',dont3:'\u0918\u0930 \u092f\u093e \u0926\u0941\u0915\u093e\u0928 \u092a\u0930 \u0938\u0940\u0906\u0930\u091f\u0940 \u0938\u0947 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0928\u093f\u0915\u093e\u0932\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0928 \u0915\u0930\u0947\u0902\u0964',do1:'\u092e\u0949\u0928\u093f\u091f\u0930 \u0914\u0930 \u091f\u0940\u0935\u0940 \u0915\u094b \u091c\u0939\u093e\u0902 \u0924\u0915 \u0938\u0902\u092d\u0935 \u0939\u094b \u092a\u0942\u0930\u0940 \u092c\u0949\u0921\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0902\u0964',do2:'\u092a\u093f\u0915\u094d\u091a\u0930 \u091f\u094d\u092f\u0942\u092c \u0915\u094b \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u0938\u0947 \u0909\u0920\u093e\u090f\u0902 \u0914\u0930 \u0915\u093e\u0902\u091a \u0915\u0947 \u0938\u093e\u092e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0939\u093f\u0938\u094d\u0938\u0947 \u0915\u094b \u091a\u094b\u091f \u0938\u0947 \u092c\u091a\u093e\u090f\u0902\u0964',do3:'\u092a\u0942\u0930\u0940 \u0938\u0940\u0906\u0930\u091f\u0940 \u092f\u0942\u0928\u093f\u091f \u0915\u094b \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u093f\u0902\u0917 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u094c\u0902\u092a\u0947\u0902\u0964'},pcbs:{title:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 (\u092a\u0940\u0938\u0940\u092c\u0940) \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 \u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916-\u0930\u0916\u093e\u0935',warning:'\u092c\u094b\u0930\u094d\u0921 \u091c\u0932\u093e\u0928\u0947 \u092f\u093e \u0924\u0947\u091c\u093e\u092c (\u090f\u0938\u093f\u0921) \u092e\u0947\u0902 \u0927\u094b\u0928\u0947 \u0938\u0947 \u091c\u093e\u0928\u0932\u0947\u0935\u093e \u091c\u0939\u0930\u0940\u0932\u093e \u0927\u0941\u0906\u0902 \u0928\u093f\u0915\u0932\u0924\u093e \u0939\u0948\u0964',whyDangerous:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 \u092e\u0947\u0902 \u0930\u093e\u0932, \u0938\u094b\u0932\u094d\u0921\u0930 \u0914\u0930 \u092d\u093e\u0930\u0940 \u0927\u093e\u0924\u0941\u090f\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u0906\u0917 \u092a\u0930 \u0917\u0930\u094d\u092e \u0915\u0930\u0928\u0947 \u092f\u093e \u0924\u0947\u091c\u093e\u092c \u0921\u093e\u0932\u0928\u0947 \u0938\u0947 \u0932\u0947\u0921 \u0935 \u091c\u0939\u0930\u0940\u0932\u0940 \u0917\u0948\u0938\u0947\u0902 \u0928\u093f\u0915\u0932\u0924\u0940 \u0939\u0948\u0902 \u091c\u094b \u092b\u0947\u092b\u0921\u093c\u094b\u0902 \u0915\u094b \u0928\u0941\u0915\u0938\u093e\u0928 \u092a\u0939\u0941\u0902\u091a\u093e\u0924\u0940 \u0939\u0948\u0902\u0964',dont1:'\u0924\u0947\u091c\u093e\u092c (\u090f\u0938\u093f\u0921) \u0938\u0947 \u0927\u094b\u0928\u0947 \u092f\u093e \u0926\u0947\u0938\u0940 \u0930\u093e\u0938\u093e\u092f\u0928\u093f\u0915 \u0936\u094b\u0927\u0928 \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u092c\u093f\u0932\u094d\u0915\u0941\u0932 \u0928 \u0915\u0930\u0947\u0902\u0964',dont2:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 \u0915\u094b \u0906\u0917 \u092e\u0947\u0902 \u0915\u092d\u0940 \u0928 \u091c\u0932\u093e\u090f\u0902\u0964',dont3:'\u0916\u0941\u0932\u0940 \u0906\u0917 \u092a\u0930 \u0915\u0902\u092a\u094b\u0928\u0947\u0902\u091f\u094d\u0938 \u0915\u094b \u0928 \u092a\u093f\u0918\u0932\u093e\u090f\u0902 \u0914\u0930 \u0928 \u0939\u0940 \u0927\u0941\u090f\u0902 \u092e\u0947\u0902 \u0938\u093e\u0902\u0938 \u0932\u0947\u0902\u0964',do1:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 \u0915\u094b \u092c\u093f\u0928\u093e \u0924\u094b\u0921\u093c\u0947, \u0938\u0942\u0916\u093e \u0914\u0930 \u0938\u093e\u092c\u0941\u0924 \u0907\u0915\u091f\u094d\u0920\u093e \u0915\u0930\u0947\u0902\u0964',do2:'\u092a\u0940\u0938\u0940\u092c\u0940 \u0915\u094b \u0938\u093e\u092b \u092c\u094b\u0930\u093f\u092f\u094b\u0902 \u092f\u093e \u0921\u093f\u092c\u094d\u092c\u094b\u0902 \u092e\u0947\u0902 \u092c\u091a\u094d\u091a\u094b\u0902 \u0914\u0930 \u0916\u093e\u0928\u0947-\u092a\u0940\u0928\u0947 \u0915\u0940 \u091a\u0940\u091c\u094b\u0902 \u0938\u0947 \u0926\u0942\u0930 \u0930\u0916\u0947\u0902\u0964',do3:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 \u0938\u0940\u0927\u0947 \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u093f\u0902\u0917 \u092b\u0948\u0915\u094d\u091f\u094d\u0930\u0940 \u0915\u094b \u092c\u0947\u091a\u0947\u0902\u0964'},cables:{title:'\u0915\u0947\u092c\u0932 \u0935 \u0924\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0924\u093e\u0902\u092c\u093e \u0928\u093f\u0915\u093e\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u093e\u0930 \u091c\u0932\u093e\u0928\u0947 \u0938\u0947 \u092c\u091a\u0947\u0902',warning:'\u0924\u093e\u0902\u092c\u093e \u0928\u093f\u0915\u093e\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u093e\u0930\u094b\u0902 \u0915\u094b \u0915\u092d\u0940 \u0928 \u091c\u0932\u093e\u090f\u0902\u0964 \u0915\u0947\u092c\u0932 \u0915\u093e \u0927\u0941\u0906\u0902 \u091c\u0939\u0930\u0940\u0932\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964',whyDangerous:'\u0915\u0947\u092c\u0932 \u0915\u0940 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u092a\u0930\u0924 \u091c\u0932\u0928\u0947 \u092a\u0930 \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u0935\u093f\u0937\u0948\u0932\u093e \u0921\u093e\u0907\u0911\u0915\u094d\u0938\u093f\u0928 \u0927\u0941\u0906\u0902 \u091b\u094b\u0921\u093c\u0924\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0927\u0941\u0906\u0902 \u092b\u0947\u092b\u0921\u093c\u094b\u0902 \u0915\u094b \u092d\u093e\u0930\u0940 \u0928\u0941\u0915\u0938\u093e\u0928 \u092a\u0939\u0941\u0902\u091a\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0906\u0938\u092a\u093e\u0938 \u0915\u0947 \u0935\u093e\u0924\u093e\u0935\u0930\u0923 \u0915\u094b \u092a\u094d\u0930\u0926\u0942\u0937\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964',dont1:'\u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0939\u091f\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u093e\u0930\u094b\u0902 \u092f\u093e \u0915\u0947\u092c\u0932\u094b\u0902 \u0915\u094b \u0915\u092d\u0940 \u0906\u0917 \u092e\u0947\u0902 \u0928 \u091c\u0932\u093e\u090f\u0902\u0964',dont2:'\u0916\u0941\u0932\u0940 \u0906\u0902\u091a \u092f\u093e \u0939\u0940\u091f\u0930 \u0938\u0947 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0915\u0940 \u092a\u0930\u0924 \u0915\u094b \u0928 \u092a\u093f\u0918\u0932\u093e\u090f\u0902\u0964',dont3:'\u0924\u093e\u0930 \u091c\u0932\u0928\u0947 \u0938\u0947 \u0928\u093f\u0915\u0932\u0928\u0947 \u0935\u093e\u0932\u0947 \u0927\u0941\u090f\u0902 \u0915\u0947 \u092a\u093e\u0938 \u0916\u0921\u093c\u0947 \u0928 \u0939\u094b\u0902\u0964',do1:'\u0915\u0947\u092c\u0932\u094b\u0902 \u0915\u094b \u092c\u093f\u0928\u093e \u091c\u0932\u093e\u090f, \u0938\u093e\u092c\u0941\u0924 \u0914\u0930 \u0938\u0942\u0916\u093e \u0907\u0915\u091f\u094d\u0920\u093e \u0915\u0930\u0947\u0902\u0964',do2:'\u0924\u093e\u0930\u094b\u0902 \u0915\u094b \u0938\u0941\u0932\u091d\u093e\u0915\u0930 \u092c\u0902\u0921\u0932 \u092c\u0928\u093e\u090f\u0902 \u0924\u093e\u0915\u093f \u0932\u0947 \u091c\u093e\u0928\u0947 \u092e\u0947\u0902 \u0906\u0938\u093e\u0928\u0940 \u0939\u094b\u0964',do3:'\u0924\u093e\u0930\u094b\u0902 \u0915\u094b \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u0930 \u0915\u094b \u0926\u0947\u0902 \u091c\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092e\u0936\u0940\u0928\u094b\u0902 \u0938\u0947 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0905\u0932\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964'},lcds:{title:'\u090f\u0932\u0938\u0940\u0921\u0940 \u0935 \u090f\u0932\u0908\u0921\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0935 \u092c\u0948\u0915\u0932\u093e\u0907\u091f \u0915\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0902\u091a\u093e\u0932\u0928',warning:'\u092a\u0941\u0930\u093e\u0928\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0940 \u092c\u0948\u0915\u0932\u093e\u0907\u091f \u092e\u0947\u0902 \u092a\u093e\u0930\u093e (\u092e\u0930\u094d\u0915\u0930\u0940) \u0939\u094b\u0924\u093e \u0939\u0948; \u091f\u0942\u091f\u093e \u0915\u093e\u0902\u091a \u092c\u0939\u0941\u0924 \u0928\u0941\u0915\u0940\u0932\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964',whyDangerous:'\u092a\u0941\u0930\u093e\u0928\u0940 \u090f\u0932\u0938\u0940\u0921\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092e\u0947\u0902 \u092b\u094d\u0932\u094b\u0930\u094b\u0938\u0947\u0902\u091f \u0932\u0948\u0902\u092a \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u091c\u093f\u0928\u092e\u0947\u0902 \u0935\u093f\u0937\u0948\u0932\u0940 \u092a\u093e\u0930\u0947 \u0915\u0940 \u092d\u093e\u092a \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u091f\u0942\u091f\u0928\u0947 \u092a\u0930 \u092a\u093e\u0930\u093e \u0939\u0935\u093e \u092e\u0947\u0902 \u092b\u0948\u0932\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u093e\u0902\u091a \u0938\u0947 \u0939\u093e\u0925 \u0915\u091f \u0938\u0915\u0924\u093e \u0939\u0948\u0964',dont1:'\u090f\u0932\u0938\u0940\u0921\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u094b \u0915\u092d\u0940 \u0928 \u092a\u091f\u0915\u0947\u0902 \u092f\u093e \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 \u0928 \u0924\u094b\u0921\u093c\u0947\u0902\u0964',dont2:'\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0947 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u092b\u094d\u0930\u0947\u092e \u092f\u093e \u0921\u093f\u092b\u094d\u092f\u0942\u091c\u093c\u0930 \u0936\u0940\u091f \u0915\u094b \u0915\u092d\u0940 \u0928 \u091c\u0932\u093e\u090f\u0902\u0964',dont3:'\u092c\u0948\u0915\u0932\u093e\u0907\u091f \u091f\u094d\u092f\u0942\u092c \u0915\u094b \u0939\u093e\u0925 \u0938\u0947 \u0916\u094b\u0932\u0928\u0947 \u092f\u093e \u0924\u094b\u0921\u093c\u0928\u0947 \u0915\u0940 \u0915\u094b\u0936\u093f\u0936 \u0928 \u0915\u0930\u0947\u0902\u0964',do1:'\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u094b \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u0938\u0947 \u092a\u0915\u0921\u093c\u0947\u0902 \u0914\u0930 \u0932\u0947 \u091c\u093e\u0924\u0947 \u0938\u092e\u092f \u0938\u0940\u0927\u093e \u0916\u0921\u093c\u093e \u0930\u0916\u0947\u0902\u0964',do2:'\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0940 \u0938\u0924\u0939 \u0915\u094b \u0928\u0941\u0915\u0940\u0932\u0940 \u091a\u0940\u091c\u094b\u0902 \u0914\u0930 \u092d\u093e\u0930\u0940 \u0926\u092c\u093e\u0935 \u0938\u0947 \u092c\u091a\u093e\u090f\u0902\u0964',do3:'\u092a\u0942\u0930\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u094b \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u093f\u0902\u0917 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u094c\u0902\u092a\u0947\u0902\u0964'},general:{title:'\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0908-\u0915\u091a\u0930\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0938\u092d\u0940 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0915\u092c\u093e\u0921\u093c \u0915\u0947 \u0932\u093f\u090f \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0938\u093e\u0935\u0927\u093e\u0928\u093f\u092f\u093e\u0902',warning:'\u0908-\u0915\u091a\u0930\u0947 \u092e\u0947\u0902 \u0915\u0908 \u0916\u0924\u0930\u0928\u093e\u0915 \u0924\u0924\u094d\u0935 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0938\u0947 \u0915\u092d\u0940 \u0928 \u091c\u0932\u093e\u090f\u0902, \u0928 \u0924\u094b\u0921\u093c\u0947\u0902 \u0914\u0930 \u0928 \u092b\u0947\u0902\u0915\u0947\u0902\u0964',whyDangerous:'\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u092e\u0947\u0902 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915, \u0927\u093e\u0924\u0941 \u0914\u0930 \u0916\u0924\u0930\u0928\u093e\u0915 \u0930\u0938\u093e\u092f\u0928 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0917\u0932\u0924 \u0924\u0930\u0940\u0915\u0947 \u0938\u0947 \u0924\u094b\u0921\u093c\u0928\u0947 \u092a\u0930 \u091c\u0939\u0930\u0940\u0932\u0940 \u0927\u0942\u0932 \u0909\u0921\u093c\u0924\u0940 \u0939\u0948 \u0914\u0930 \u091c\u092e\u0940\u0928 \u0935 \u092a\u093e\u0928\u0940 \u092a\u094d\u0930\u0926\u0942\u0937\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964',dont1:'\u0908-\u0915\u091a\u0930\u0947 \u0915\u094b \u0915\u092d\u0940 \u0916\u0941\u0932\u0947 \u092e\u0947\u0902 \u0928 \u091c\u0932\u093e\u090f\u0902 \u0914\u0930 \u0928 \u0939\u0940 \u0928\u093e\u0932\u093f\u092f\u094b\u0902 \u092f\u093e \u0916\u093e\u0932\u0940 \u092e\u0948\u0926\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u092b\u0947\u0902\u0915\u0947\u0902\u0964',dont2:'\u0939\u0925\u094c\u0921\u093c\u0947 \u0938\u0947 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u094b \u0905\u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0928 \u0924\u094b\u0921\u093c\u0947\u0902\u0964',dont3:'\u092c\u0948\u091f\u0930\u0940 \u0935 \u091c\u0939\u0930\u0940\u0932\u0947 \u0915\u091a\u0930\u0947 \u0915\u094b \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0932\u094b\u0939\u0947-\u0924\u093e\u0902\u092c\u0947 \u0915\u0947 \u0915\u092c\u093e\u0921\u093c \u092e\u0947\u0902 \u0928 \u092e\u093f\u0932\u093e\u090f\u0902\u0964',do1:'\u0908-\u0915\u091a\u0930\u0947 \u0915\u094b \u0905\u0932\u0917-\u0905\u0932\u0917 \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 (\u092c\u0948\u091f\u0930\u0940, \u092c\u094b\u0930\u094d\u0921, \u0924\u093e\u0930, \u0909\u092a\u0915\u0930\u0923) \u092e\u0947\u0902 \u091b\u093e\u0902\u091f\u0915\u0930 \u0930\u0916\u0947\u0902\u0964',do2:'\u0915\u091a\u0930\u0947 \u0915\u094b \u091c\u092e\u0940\u0928 \u0938\u0947 \u090a\u092a\u0930, \u0922\u0915\u0947 \u0939\u0941\u090f \u0938\u0942\u0916\u0947 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0902\u0964',do3:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093f\u092a\u091f\u093e\u0928 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u0935\u0932 \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u0930\u094d\u0938 \u0915\u0947 \u0938\u093e\u0925 \u0939\u0940 \u0915\u093e\u092e \u0915\u0930\u0947\u0902\u0964'},storage:{title:'\u092d\u0902\u0921\u093e\u0930\u0923 \u0935 \u092a\u0930\u093f\u0935\u0939\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0922\u093c\u0947\u0930 \u0932\u0917\u093e\u0928\u093e, \u092c\u093e\u0930\u093f\u0936 \u0938\u0947 \u092c\u091a\u093e\u0935 \u0935 \u0935\u093e\u0939\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',warning:'\u090a\u0902\u091a\u093e \u0922\u093c\u0947\u0930 \u0917\u093f\u0930\u0928\u0947 \u0938\u0947 \u091a\u094b\u091f \u0932\u0917 \u0938\u0915\u0924\u0940 \u0939\u0948; \u092d\u0940\u0917\u093e \u0915\u091a\u0930\u093e \u0914\u0930 \u0926\u092c\u0940 \u092c\u0948\u091f\u0930\u0940 \u0906\u0917 \u092a\u0915\u0921\u093c \u0938\u0915\u0924\u0940 \u0939\u0948\u0964',whyDangerous:'\u092d\u093e\u0930\u0940 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u0947 \u0905\u0938\u094d\u0925\u093f\u0930 \u0922\u0947\u0930 \u0922\u0939 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u093e\u0928\u0940 \u0930\u093f\u0938\u0928\u0947 \u0938\u0947 \u092c\u0948\u091f\u0930\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0936\u0949\u0930\u094d\u091f \u0938\u0930\u094d\u0915\u093f\u091f \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948 \u0914\u0930 \u0935\u093e\u0939\u0928 \u0938\u0947 \u0915\u092c\u093e\u0921\u093c \u0917\u093f\u0930\u0915\u0930 \u0926\u0941\u0930\u094d\u0918\u091f\u0928\u093e \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0964',dont1:'\u092c\u093f\u0928\u093e \u092e\u091c\u092c\u0942\u0924 \u0906\u0927\u093e\u0930 \u0915\u0947 \u092d\u093e\u0930\u0940 \u092e\u0949\u0928\u093f\u091f\u0930 \u092f\u093e \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u093e \u090a\u0902\u091a\u093e \u0922\u0947\u0930 \u0928 \u0932\u0917\u093e\u090f\u0902\u0964',dont2:'\u0908-\u0915\u091a\u0930\u0947 \u0915\u094b \u092c\u093e\u0930\u093f\u0936 \u092e\u0947\u0902 \u0916\u0941\u0932\u0947 \u092e\u0947\u0902 \u092f\u093e \u091a\u0942\u0932\u094d\u0939\u0947/\u0906\u0917 \u0915\u0947 \u092a\u093e\u0938 \u0928 \u0930\u0916\u0947\u0902\u0964',dont3:'\u0930\u093f\u0915\u094d\u0936\u093e, \u0930\u0947\u0939\u0921\u093c\u0940 \u092f\u093e \u092c\u093e\u0907\u0915 \u092a\u0930 \u0915\u092c\u093e\u0921\u093c \u0915\u094b \u092c\u093f\u0928\u093e \u0930\u0938\u094d\u0938\u0940 \u092c\u093e\u0902\u0927\u0947 \u0928 \u0932\u093e\u0926\u0947\u0902\u0964',do1:'\u0908-\u0915\u091a\u0930\u0947 \u0915\u094b \u0938\u0942\u0916\u093e, \u0939\u0935\u093e\u0926\u093e\u0930 \u0914\u0930 \u092c\u093e\u0930\u093f\u0936 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u092e\u0930\u0947 \u092f\u093e \u0936\u0947\u0921 \u092e\u0947\u0902 \u0930\u0916\u0947\u0902\u0964',do2:'\u091f\u0942\u091f\u0940 \u092f\u093e \u0932\u0940\u0915 \u0939\u094b\u0924\u0940 \u092c\u0948\u091f\u0930\u0940 \u0915\u094b \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0915\u0947 \u0905\u0932\u0917 \u0921\u093f\u092c\u094d\u092c\u0947 \u092e\u0947\u0902 \u0930\u0916\u0947\u0902\u0964',do3:'\u0917\u093e\u0921\u093c\u0940 \u092a\u0930 \u0938\u093e\u092e\u093e\u0928 \u0915\u094b \u092e\u091c\u092c\u0942\u0924\u0940 \u0938\u0947 \u092c\u093e\u0902\u0927\u0947\u0902 \u0914\u0930 \u092d\u093e\u0930\u0940 \u0938\u093e\u092e\u093e\u0928 \u0918\u0941\u091f\u0928\u0947 \u092e\u094b\u0921\u093c\u0915\u0930 \u0909\u0920\u093e\u090f\u0902\u0964'},ppe:{title:'\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0909\u092a\u0915\u0930\u0923 (\u092a\u0940\u092a\u0940\u0908)',subtitle:'\u0915\u092c\u093e\u0921\u093c \u0909\u0920\u093e\u0924\u0947 \u0938\u092e\u092f \u0905\u092a\u0928\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u091c\u0930\u0942\u0930\u0940 \u0938\u093e\u0927\u0928',warning:'\u0926\u0938\u094d\u0924\u093e\u0928\u0947 \u0914\u0930 \u091c\u0942\u0924\u0947 \u0915\u091f\u0928\u0947 \u0938\u0947 \u092c\u091a\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u092a\u0940\u092a\u0940\u0908 \u0915\u091a\u0930\u093e \u091c\u0932\u093e\u0928\u0947 \u092f\u093e \u0924\u0947\u091c\u093e\u092c \u0915\u0947 \u0916\u0924\u0930\u0947 \u0915\u094b \u0916\u0924\u094d\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964',whyDangerous:'\u091f\u0942\u091f\u0947 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u094d\u0938 \u0938\u0947 \u0939\u093e\u0925 \u0915\u091f\u0928\u0947, \u0915\u093e\u0902\u091a \u091a\u0941\u092d\u0928\u0947 \u0914\u0930 \u0939\u093e\u0925\u094b\u0902 \u092a\u0930 \u0930\u093e\u0938\u093e\u092f\u0928\u093f\u0915 \u0935 \u091c\u0939\u0930\u0940\u0932\u0940 \u0927\u0942\u0932 \u0932\u0917\u0928\u0947 \u0915\u093e \u0916\u0924\u0930\u093e \u0930\u0939\u0924\u093e \u0939\u0948\u0964',dont1:'\u091f\u0942\u091f\u093e \u0915\u093e\u0902\u091a, \u0928\u0941\u0915\u0940\u0932\u0947 \u0924\u093e\u0930 \u092f\u093e \u0927\u093e\u0924\u0941 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u0928\u0902\u0917\u0947 \u0939\u093e\u0925\u094b\u0902 \u0938\u0947 \u0928 \u091b\u0941\u090f\u0902\u0964',dont2:'\u0915\u092c\u093e\u0921\u093c \u091b\u0942\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092c\u093f\u0928\u093e \u0939\u093e\u0925 \u0927\u094b\u090f \u0916\u093e\u0928\u093e \u0928 \u0916\u093e\u090f\u0902 \u0914\u0930 \u092a\u093e\u0928\u0940 \u0928 \u092a\u093f\u090f\u0902\u0964',dont3:'\u092f\u0939 \u0915\u092d\u0940 \u0928 \u0938\u092e\u091d\u0947\u0902 \u0915\u093f \u0926\u0938\u094d\u0924\u093e\u0928\u0947 \u092a\u0939\u0928\u0915\u0930 \u0915\u091a\u0930\u093e \u091c\u0932\u093e\u0928\u093e \u092f\u093e \u0924\u0947\u091c\u093e\u092c \u0921\u093e\u0932\u0928\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948\u0964',do1:'\u0915\u092c\u093e\u0921\u093c \u0909\u0920\u093e\u0924\u0947 \u0914\u0930 \u091b\u093e\u0902\u091f\u0924\u0947 \u0938\u092e\u092f \u092e\u094b\u091f\u0947 \u092e\u091c\u092c\u0942\u0924 \u0926\u0938\u094d\u0924\u093e\u0928\u0947 \u091c\u0930\u0942\u0930 \u092a\u0939\u0928\u0947\u0902\u0964',do2:'\u092a\u0948\u0930 \u092e\u0947\u0902 \u092c\u0902\u0926 \u091c\u0942\u0924\u0947 \u092a\u0939\u0928\u0947\u0902 \u0914\u0930 \u0906\u0902\u0916\u094b\u0902 \u0915\u0947 \u092c\u091a\u093e\u0935 \u0915\u0947 \u0932\u093f\u090f \u091a\u0936\u094d\u092e\u093e \u0932\u0917\u093e\u090f\u0902\u0964',do3:'\u0915\u093e\u092e \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0939\u093e\u0925\u094b\u0902 \u0915\u094b \u0938\u093e\u092c\u0941\u0928 \u0914\u0930 \u092a\u093e\u0928\u0940 \u0938\u0947 \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0927\u094b\u090f\u0902\u0964'}}},recyclerDirectory:{title:'\u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u0930 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e',subtitle:'\u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u0930\u094d\u0938 \u0914\u0930 \u090f\u0917\u094d\u0930\u0940\u0917\u0947\u091f\u0930\u094d\u0938 \u0916\u094b\u091c\u0947\u0902',openDirectory:'\u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u0930 \u0916\u094b\u091c\u0947\u0902',searchPlaceholder:'\u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u0930 \u0915\u093e \u0928\u093e\u092e, \u0936\u093