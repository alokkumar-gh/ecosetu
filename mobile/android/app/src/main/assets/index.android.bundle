b13 \u0b2e\u0b3e\u0b30\u0b4d\u0b17\u0b26\u0b30\u0b4d\u0b36\u0b3f\u0b15\u0b3e\u0964 \u0b28\u0b3f\u0b2c\u0b3e\u0b30\u0b23 \u0b0f\u0b2c\u0b02 \u0b38\u0b1a\u0b47\u0b24\u0b28\u0b24\u0b3e \u0b39\u0b3f\u0b01 \u0b2a\u0b4d\u0b30\u0b25\u0b2e\u0964',whyDangerous:'\u0b0f\u0b39\u0b3e \u0b15\u0b3e\u0b39\u0b3f\u0b01\u0b15\u0b3f \u0b2c\u0b3f\u0b2a\u0b1c\u0b4d\u0b1c\u0b28\u0b15?',dontTitle:'\u0b15\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01 (\u0b05\u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f)',doTitle:'\u0b15\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b47 (\u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f)',speakGuide:'\u0b0f\u0b39\u0b3f \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b3e\u0b2c\u0b33\u0b40 \u0b36\u0b41\u0b23\u0b28\u0b4d\u0b24\u0b41',speakOverview:'\u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b38\u0b3e\u0b30\u0b3e\u0b02\u0b36 \u0b36\u0b41\u0b23\u0b28\u0b4d\u0b24\u0b41',disclaimer:'\u0b0f\u0b39\u0b3f \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b2e\u0b3e\u0b30\u0b4d\u0b17\u0b26\u0b30\u0b4d\u0b36\u0b3f\u0b15\u0b3e \u0b15\u0b47\u0b2c\u0b33 \u0b38\u0b42\u0b1a\u0b28\u0b3e \u0b2a\u0b3e\u0b07\u0b01\u0964 \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b28\u0b3f\u0b5f\u0b2e \u0b0f\u0b2c\u0b02 \u0b05\u0b27\u0b3f\u0b15\u0b43\u0b24 \u0b2a\u0b41\u0b28\u0b03\u0b1a\u0b15\u0b4d\u0b30\u0b23\u0b15\u0b3e\u0b30\u0b40\u0b19\u0b4d\u0b15 \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b26\u0b47\u0b36 \u0b2a\u0b3e\u0b33\u0b28 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964 \u0b2c\u0b3f\u0b2a\u0b26\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b28\u0b3f\u0b1c\u0b47 \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',offlineNotice:'\u0b05\u0b2b\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b2e\u0b4b\u0b21\u0b4d: \u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b2e\u0b3e\u0b30\u0b4d\u0b17\u0b26\u0b30\u0b4d\u0b36\u0b3f\u0b15\u0b3e \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2b\u0b4b\u0b28\u0b30\u0b47 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27\u0964',learnSafety:'\u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b28\u0b3f\u0b5f\u0b2e \u0b36\u0b3f\u0b16\u0b28\u0b4d\u0b24\u0b41',topics:{batteries:{title:'\u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e',subtitle:'\u0b28\u0b37\u0b4d\u0b1f \u0b13 \u0b2a\u0b41\u0b30\u0b41\u0b23\u0b3e \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b30 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b28\u0b3e',warning:'\u0b2b\u0b3e\u0b1f\u0b3f\u0b2f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b3e \u0b17\u0b30\u0b2e \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b30\u0b47 \u0b28\u0b3f\u0b06\u0b01 \u0b32\u0b3e\u0b17\u0b3f\u0b2a\u0b3e\u0b30\u0b47, \u0b2c\u0b3f\u0b38\u0b4d\u0b2b\u0b4b\u0b30\u0b23 \u0b39\u0b4b\u0b07\u0b2a\u0b3e\u0b30\u0b47 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b30\u0b3e\u0b38\u0b3e\u0b5f\u0b28\u0b3f\u0b15 \u0b2a\u0b26\u0b3e\u0b30\u0b4d\u0b25 \u0b2c\u0b4b\u0b39\u0b3f\u0b2a\u0b3e\u0b30\u0b47\u0964',whyDangerous:'\u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40 \u0b2d\u0b3f\u0b24\u0b30\u0b47 \u0b30\u0b3e\u0b38\u0b3e\u0b5f\u0b28\u0b3f\u0b15 \u0b36\u0b15\u0b4d\u0b24\u0b3f \u0b38\u0b1e\u0b4d\u0b1a\u0b3f\u0b24 \u0b25\u0b3e\u0b0f\u0964 \u0b15\u0b23\u0b3e \u0b15\u0b32\u0b47, \u0b1a\u0b3e\u0b2a\u0b3f\u0b32\u0b47 \u0b2c\u0b3e \u0b17\u0b30\u0b2e \u0b15\u0b32\u0b47 \u0b0f\u0b25\u0b3f\u0b30\u0b47 \u0b39\u0b20\u0b3e\u0b24\u0b4d \u0b28\u0b3f\u0b06\u0b01 \u0b32\u0b3e\u0b17\u0b3f\u0b2a\u0b3e\u0b30\u0b47 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b0f\u0b38\u0b3f\u0b21\u0b4d \u0b32\u0b3f\u0b15\u0b4d \u0b39\u0b4b\u0b07\u0b2a\u0b3e\u0b30\u0b47\u0964',dont1:'\u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b15\u0b41 \u0b15\u0b47\u0b2c\u0b47 \u0b15\u0b3e\u0b1f\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b1a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b1c\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont2:'\u0b28\u0b37\u0b4d\u0b1f \u0b2c\u0b3e \u0b2b\u0b41\u0b32\u0b3f\u0b2f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b15\u0b41 \u0b09\u0b24\u0b4d\u0b24\u0b3e\u0b2a, \u0b16\u0b30\u0b3e \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b3f\u0b06\u0b01 \u0b28\u0b3f\u0b15\u0b1f\u0b30\u0b47 \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont3:'\u0b32\u0b3f\u0b15\u0b4d \u0b39\u0b47\u0b09\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b15\u0b41 \u0b05\u0b28\u0b4d\u0b5f \u0b27\u0b3e\u0b24\u0b2c \u0b2d\u0b19\u0b4d\u0b17\u0b3e\u0b30\u0b41\u0b1c\u0b3e \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b38\u0b39\u0b3f\u0b24 \u0b2e\u0b3f\u0b36\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',do1:'\u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b15\u0b41 \u0b28 \u0b16\u0b4b\u0b32\u0b3f \u0b15\u0b47\u0b2c\u0b33 \u0b2c\u0b3e\u0b39\u0b3e\u0b30\u0b41 \u0b28\u0b3f\u0b30\u0b40\u0b15\u0b4d\u0b37\u0b23 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',do2:'\u0b28\u0b37\u0b4d\u0b1f \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b15\u0b41 \u0b36\u0b41\u0b16\u0b3f\u0b32\u0b3e \u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d \u0b2a\u0b3e\u0b24\u0b4d\u0b30\u0b30\u0b47 \u0b05\u0b32\u0b17\u0b3e \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964',do3:'\u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b15\u0b41 \u0b38\u0b3f\u0b27\u0b3e\u0b38\u0b33\u0b16 \u0b05\u0b27\u0b3f\u0b15\u0b43\u0b24 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b2c\u0b3e \u0b2a\u0b41\u0b28\u0b03\u0b1a\u0b15\u0b4d\u0b30\u0b23\u0b15\u0b3e\u0b30\u0b40\u0b19\u0b4d\u0b15\u0b41 \u0b39\u0b38\u0b4d\u0b24\u0b3e\u0b28\u0b4d\u0b24\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964'},crts:{title:'\u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b2e\u0b28\u0b3f\u0b1f\u0b30 \u0b13 \u0b1f\u0b3f\u0b2d\u0b3f \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e',subtitle:'\u0b2a\u0b3f\u0b15\u0b4d\u0b1a\u0b30 \u0b1f\u0b4d\u0b5f\u0b41\u0b2c\u0b4d \u0b30 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b28\u0b3e',warning:'\u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b15\u0b3e\u0b1a \u0b1f\u0b4d\u0b5f\u0b41\u0b2c\u0b4d \u0b2d\u0b3f\u0b24\u0b30\u0b47 \u0b36\u0b42\u0b28\u0b4d\u0b5f\u0b38\u0b4d\u0b25\u0b3e\u0b28 (\u0b2d\u0b4d\u0b5f\u0b3e\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b4d) \u0b25\u0b3e\u0b0f, \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b3f\u0b32\u0b47 \u0b15\u0b3e\u0b1a \u0b16\u0b23\u0b4d\u0b21\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b24\u0b40\u0b2c\u0b4d\u0b30 \u0b2c\u0b47\u0b17\u0b30\u0b47 \u0b1b\u0b3f\u0b1f\u0b3f\u0b15\u0b3f\u0b2a\u0b21\u0b3c\u0b47\u0964',whyDangerous:'\u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b2a\u0b3f\u0b15\u0b4d\u0b1a\u0b30 \u0b1f\u0b4d\u0b5f\u0b41\u0b2c\u0b4d \u0b2d\u0b3f\u0b24\u0b30\u0b47 \u0b09\u0b1a\u0b4d\u0b1a \u0b2d\u0b4d\u0b5f\u0b3e\u0b15\u0b4d\u0b5f\u0b41\u0b2e\u0b4d \u0b0f\u0b2c\u0b02 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b38\u0b40\u0b38\u0b3e (\u0b32\u0b47\u0b21\u0b4d) \u0b27\u0b3e\u0b24\u0b41 \u0b25\u0b3e\u0b0f\u0964 \u0b39\u0b3e\u0b24\u0b41\u0b21\u0b3c\u0b3f\u0b30\u0b47 \u0b2a\u0b3f\u0b1f\u0b3f\u0b32\u0b47 \u0b15\u0b3e\u0b1a \u0b2d\u0b3f\u0b24\u0b30\u0b15\u0b41 \u0b1f\u0b3e\u0b23\u0b3f \u0b39\u0b4b\u0b07 \u0b2c\u0b3f\u0b38\u0b4d\u0b2b\u0b4b\u0b30\u0b23 \u0b2a\u0b30\u0b3f \u0b1a\u0b3e\u0b30\u0b3f\u0b06\u0b21\u0b3c\u0b47 \u0b2c\u0b3f\u0b1b\u0b3e\u0b21\u0b3c\u0b3f \u0b39\u0b4b\u0b07\u0b2a\u0b21\u0b3c\u0b47\u0964',dont1:'\u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b2a\u0b3f\u0b15\u0b4d\u0b1a\u0b30 \u0b1f\u0b4d\u0b5f\u0b41\u0b2c\u0b4d \u0b15\u0b41 \u0b39\u0b3e\u0b24\u0b41\u0b21\u0b3c\u0b3f\u0b30\u0b47 \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont2:'\u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b2c\u0b21\u0b3f, \u0b15\u0b0f\u0b32\u0b4d \u0b2c\u0b3e \u0b2d\u0b3f\u0b24\u0b30 \u0b05\u0b02\u0b36\u0b15\u0b41 \u0b28\u0b3f\u0b06\u0b01\u0b30\u0b47 \u0b1c\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont3:'\u0b18\u0b30\u0b47 \u0b2c\u0b3e \u0b26\u0b4b\u0b15\u0b3e\u0b28\u0b30\u0b47 \u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f\u0b30\u0b41 \u0b27\u0b3e\u0b24\u0b41 \u0b2c\u0b3e\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b47\u0b37\u0b4d\u0b1f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',do1:'\u0b2e\u0b28\u0b3f\u0b1f\u0b30 \u0b0f\u0b2c\u0b02 \u0b1f\u0b3f\u0b2d\u0b3f\u0b15\u0b41 \u0b2f\u0b25\u0b3e\u0b38\u0b2e\u0b4d\u0b2d\u0b2c \u0b05\u0b15\u0b4d\u0b37\u0b41\u0b23\u0b4d\u0b23 \u0b2c\u0b21\u0b3f \u0b38\u0b39\u0b3f\u0b24 \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964',do2:'\u0b2a\u0b3f\u0b15\u0b4d\u0b1a\u0b30 \u0b1f\u0b4d\u0b5f\u0b41\u0b2c\u0b4d \u0b15\u0b41 \u0b38\u0b3e\u0b2c\u0b27\u0b3e\u0b28\u0b24\u0b3e\u0b30 \u0b38\u0b39 \u0b09\u0b20\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b15\u0b3e\u0b1a \u0b38\u0b3e\u0b2e\u0b28\u0b3e \u0b2d\u0b3e\u0b17\u0b15\u0b41 \u0b06\u0b18\u0b3e\u0b24\u0b30\u0b41 \u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',do3:'\u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b5f\u0b41\u0b28\u0b3f\u0b1f\u0b4d \u0b15\u0b41 \u0b05\u0b27\u0b3f\u0b15\u0b43\u0b24 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b3f\u0b02 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b15\u0b41 \u0b39\u0b38\u0b4d\u0b24\u0b3e\u0b28\u0b4d\u0b24\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964'},pcbs:{title:'\u0b38\u0b30\u0b4d\u0b15\u0b3f\u0b1f\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21 (\u0b2a\u0b3f\u0b38\u0b3f\u0b2c\u0b3f) \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e',subtitle:'\u0b07\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b4d\u0b30\u0b4b\u0b28\u0b3f\u0b15\u0b4d \u0b38\u0b30\u0b4d\u0b15\u0b3f\u0b1f\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21\u0b30 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b28\u0b3e',warning:'\u0b2c\u0b4b\u0b30\u0b4d\u0b21 \u0b1c\u0b33\u0b3e\u0b07\u0b32\u0b47 \u0b2c\u0b3e \u0b0f\u0b38\u0b3f\u0b21\u0b4d \u0b30\u0b47 \u0b27\u0b4b\u0b07\u0b32\u0b47 \u0b2a\u0b4d\u0b30\u0b3e\u0b23\u0b18\u0b3e\u0b24\u0b40 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b27\u0b42\u0b06\u0b01 \u0b2c\u0b3e\u0b39\u0b3e\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964',whyDangerous:'\u0b38\u0b30\u0b4d\u0b15\u0b3f\u0b1f\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21\u0b30\u0b47 \u0b30\u0b3e\u0b33, \u0b38\u0b4b\u0b32\u0b4d\u0b21\u0b30 \u0b0f\u0b2c\u0b02 \u0b38\u0b40\u0b38\u0b3e \u0b25\u0b3e\u0b0f\u0964 \u0b28\u0b3f\u0b06\u0b01\u0b30\u0b47 \u0b17\u0b30\u0b2e \u0b15\u0b32\u0b47 \u0b2c\u0b3e \u0b0f\u0b38\u0b3f\u0b21\u0b4d \u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e \u0b15\u0b32\u0b47 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b17\u0b4d\u0b5f\u0b3e\u0b38\u0b4d \u0b28\u0b3f\u0b30\u0b4d\u0b17\u0b24 \u0b39\u0b41\u0b0f \u0b2f\u0b3e\u0b39\u0b3e \u0b2b\u0b41\u0b38\u0b2b\u0b41\u0b38\u0b15\u0b41 \u0b15\u0b4d\u0b37\u0b24\u0b3f \u0b2a\u0b39\u0b1e\u0b4d\u0b1a\u0b3e\u0b0f\u0964',dont1:'\u0b0f\u0b38\u0b3f\u0b21\u0b4d \u0b30\u0b47 \u0b27\u0b4b\u0b07\u0b2c\u0b3e \u0b2c\u0b3e \u0b18\u0b30\u0b4b\u0b07 \u0b30\u0b3e\u0b38\u0b3e\u0b5f\u0b28\u0b3f\u0b15 \u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont2:'\u0b38\u0b30\u0b4d\u0b15\u0b3f\u0b1f\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21\u0b15\u0b41 \u0b28\u0b3f\u0b06\u0b01\u0b30\u0b47 \u0b1c\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont3:'\u0b16\u0b4b\u0b32\u0b3e \u0b28\u0b3f\u0b06\u0b01\u0b30\u0b47 \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b24\u0b30\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b0f\u0b2c\u0b02 \u0b27\u0b42\u0b06\u0b01\u0b30\u0b47 \u0b28\u0b3f\u0b36\u0b4d\u0b71\u0b3e\u0b38 \u0b28\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',do1:'\u0b38\u0b30\u0b4d\u0b15\u0b3f\u0b1f\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21\u0b15\u0b41 \u0b28 \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b3f \u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b13 \u0b36\u0b41\u0b16\u0b3f\u0b32\u0b3e \u0b05\u0b2c\u0b38\u0b4d\u0b25\u0b3e\u0b30\u0b47 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',do2:'\u0b2a\u0b3f\u0b38\u0b3f\u0b2c\u0b3f\u0b15\u0b41 \u0b38\u0b2b\u0b3e \u0b2c\u0b38\u0b4d\u0b24\u0b3e \u0b2c\u0b3e \u0b2c\u0b3e\u0b15\u0b4d\u0b38\u0b30\u0b47 \u0b2a\u0b3f\u0b32\u0b3e\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15 \u0b13 \u0b16\u0b3e\u0b26\u0b4d\u0b5f\u0b20\u0b3e\u0b30\u0b41 \u0b26\u0b42\u0b30\u0b30\u0b47 \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964',do3:'\u0b38\u0b30\u0b4d\u0b15\u0b3f\u0b1f\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21\u0b15\u0b41 \u0b38\u0b3f\u0b27\u0b3e\u0b38\u0b33\u0b16 \u0b05\u0b27\u0b3f\u0b15\u0b43\u0b24 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b3f\u0b02 \u0b15\u0b3e\u0b30\u0b16\u0b3e\u0b28\u0b3e\u0b15\u0b41 \u0b2c\u0b3f\u0b15\u0b4d\u0b30\u0b5f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964'},cables:{title:'\u0b15\u0b47\u0b2c\u0b41\u0b32\u0b4d \u0b13 \u0b24\u0b3e\u0b30 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e',subtitle:'\u0b24\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b3e\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b24\u0b3e\u0b30 \u0b1c\u0b33\u0b3e\u0b07\u0b2c\u0b3e \u0b2c\u0b28\u0b4d\u0b26 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41',warning:'\u0b24\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b3e\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b24\u0b3e\u0b30 \u0b15\u0b47\u0b2c\u0b47 \u0b1c\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b15\u0b47\u0b2c\u0b41\u0b32\u0b4d \u0b30 \u0b27\u0b42\u0b06\u0b01 \u0b05\u0b24\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24\u0964',whyDangerous:'\u0b15\u0b47\u0b2c\u0b41\u0b32\u0b4d \u0b30 \u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d \u0b1c\u0b33\u0b3f\u0b2c\u0b3e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b05\u0b24\u0b3f \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b21\u0b3e\u0b07\u0b05\u0b15\u0b4d\u0b38\u0b3f\u0b28\u0b4d \u0b27\u0b42\u0b06\u0b01 \u0b2c\u0b3e\u0b39\u0b3e\u0b30\u0b3f\u0b25\u0b3e\u0b0f\u0964 \u0b0f\u0b39\u0b3f \u0b27\u0b42\u0b06\u0b01 \u0b36\u0b4d\u0b71\u0b3e\u0b38\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b36\u0b30\u0b40\u0b30\u0b15\u0b41 \u0b17\u0b32\u0b47 \u0b2b\u0b41\u0b38\u0b2b\u0b41\u0b38\u0b4d \u0b28\u0b37\u0b4d\u0b1f \u0b39\u0b41\u0b0f \u0b0f\u0b2c\u0b02 \u0b2a\u0b30\u0b3f\u0b2c\u0b47\u0b36 \u0b2a\u0b4d\u0b30\u0b26\u0b42\u0b37\u0b3f\u0b24 \u0b39\u0b41\u0b0f\u0964',dont1:'\u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d \u0b24\u0b30\u0b33\u0b3e\u0b07\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b24\u0b3e\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b15\u0b47\u0b2c\u0b41\u0b32\u0b4d \u0b15\u0b41 \u0b28\u0b3f\u0b06\u0b01\u0b30\u0b47 \u0b1c\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont2:'\u0b16\u0b4b\u0b32\u0b3e \u0b28\u0b3f\u0b06\u0b01 \u0b2c\u0b3e \u0b39\u0b3f\u0b1f\u0b30 \u0b38\u0b3e\u0b39\u0b3e\u0b2f\u0b4d\u0b5f\u0b30\u0b47 \u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d \u0b1b\u0b21\u0b3c\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont3:'\u0b24\u0b3e\u0b30 \u0b1c\u0b33\u0b3f\u0b2c\u0b3e \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b2c\u0b3e\u0b39\u0b3e\u0b30\u0b41\u0b25\u0b3f\u0b2c\u0b3e \u0b27\u0b42\u0b06\u0b01 \u0b28\u0b3f\u0b15\u0b1f\u0b30\u0b47 \u0b1b\u0b3f\u0b21\u0b3c\u0b3e \u0b39\u0b41\u0b05\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',do1:'\u0b15\u0b47\u0b2c\u0b41\u0b32\u0b4d \u0b15\u0b41 \u0b28 \u0b1c\u0b33\u0b3e\u0b07 \u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b0f\u0b2c\u0b02 \u0b36\u0b41\u0b16\u0b3f\u0b32\u0b3e \u0b05\u0b2c\u0b38\u0b4d\u0b25\u0b3e\u0b30\u0b47 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',do2:'\u0b24\u0b3e\u0b30\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15\u0b41 \u0b2d\u0b32\u0b2d\u0b3e\u0b2c\u0b47 \u0b17\u0b41\u0b21\u0b3c\u0b3e\u0b07 \u0b2c\u0b23\u0b4d\u0b21\u0b32\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b2f\u0b3e\u0b39\u0b3e\u0b2b\u0b33\u0b30\u0b47 \u0b28\u0b47\u0b2c\u0b3e \u0b06\u0b23\u0b3f\u0b2c\u0b3e \u0b38\u0b39\u0b1c \u0b39\u0b47\u0b2c\u0964',do3:'\u0b24\u0b3e\u0b30\u0b15\u0b41 \u0b05\u0b27\u0b3f\u0b15\u0b43\u0b24 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30\u0b19\u0b4d\u0b15\u0b41 \u0b26\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41 \u0b2f\u0b47\u0b09\u0b01\u0b2e\u0b3e\u0b28\u0b47 \u0b2e\u0b47\u0b38\u0b3f\u0b28\u0b4d \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d \u0b05\u0b32\u0b17\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b3f\u0964'},lcds:{title:'\u0b0f\u0b32\u0b38\u0b3f\u0b21\u0b3f \u0b13 \u0b0f\u0b32\u0b07\u0b21\u0b3f \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e',subtitle:'\u0b21\u0b3f\u0b38\u0b2a\u0b4d\u0b32\u0b47 \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b13 \u0b2c\u0b4d\u0b5f\u0b3e\u0b15\u0b32\u0b3e\u0b07\u0b1f\u0b4d \u0b30 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b28\u0b3e',warning:'\u0b2a\u0b41\u0b30\u0b41\u0b23\u0b3e \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b30 \u0b2c\u0b4d\u0b5f\u0b3e\u0b15\u0b32\u0b3e\u0b07\u0b1f\u0b4d \u0b30\u0b47 \u0b2a\u0b3e\u0b30\u0b26 \u0b25\u0b3e\u0b0f; \u0b2d\u0b19\u0b4d\u0b17\u0b3e \u0b15\u0b3e\u0b1a \u0b05\u0b24\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b27\u0b3e\u0b30\u0b41\u0b06 \u0b39\u0b4b\u0b07\u0b25\u0b3e\u0b0f\u0964',whyDangerous:'\u0b2a\u0b41\u0b30\u0b41\u0b23\u0b3e \u0b0f\u0b32\u0b38\u0b3f\u0b21\u0b3f \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b30\u0b47 \u0b2a\u0b3e\u0b30\u0b26 \u0b2c\u0b3e\u0b37\u0b4d\u0b2a \u0b25\u0b3f\u0b2c\u0b3e \u0b32\u0b4d\u0b5f\u0b3e\u0b2e\u0b4d\u0b2a\u0b4d \u0b25\u0b3e\u0b0f\u0964 \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b3f\u0b17\u0b32\u0b47 \u0b2a\u0b3e\u0b30\u0b26 \u0b2c\u0b3e\u0b37\u0b4d\u0b2a \u0b2c\u0b3e\u0b5f\u0b41\u0b30\u0b47 \u0b2e\u0b3f\u0b36\u0b3f\u0b2f\u0b3e\u0b0f \u0b0f\u0b2c\u0b02 \u0b15\u0b3e\u0b1a\u0b30\u0b47 \u0b39\u0b3e\u0b24 \u0b15\u0b1f\u0b3f\u0b2f\u0b3e\u0b0f\u0964',dont1:'\u0b0f\u0b32\u0b38\u0b3f\u0b21\u0b3f \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b15\u0b41 \u0b15\u0b1a\u0b3e\u0b21\u0b3c\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b1c\u0b3e\u0b23\u0b3f\u0b36\u0b41\u0b23\u0b3f \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont2:'\u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b30 \u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d \u0b2b\u0b4d\u0b30\u0b47\u0b2e\u0b4d \u0b2c\u0b3e \u0b05\u0b02\u0b36\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15\u0b41 \u0b28\u0b3f\u0b06\u0b01\u0b30\u0b47 \u0b1c\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont3:'\u0b2c\u0b4d\u0b5f\u0b3e\u0b15\u0b32\u0b3e\u0b07\u0b1f\u0b4d \u0b1f\u0b4d\u0b5f\u0b41\u0b2c\u0b4d \u0b15\u0b41 \u0b39\u0b3e\u0b24\u0b30\u0b47 \u0b16\u0b4b\u0b32\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b47\u0b37\u0b4d\u0b1f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',do1:'\u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b15\u0b41 \u0b38\u0b3e\u0b2c\u0b27\u0b3e\u0b28\u0b24\u0b3e\u0b30 \u0b38\u0b39 \u0b27\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b28\u0b47\u0b2c\u0b3e \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b38\u0b3f\u0b27\u0b3e \u0b1b\u0b3f\u0b21\u0b3c\u0b3e \u0b15\u0b30\u0b3f \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964',do2:'\u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b30 \u0b06\u0b17 \u0b2d\u0b3e\u0b17\u0b15\u0b41 \u0b27\u0b3e\u0b30\u0b41\u0b06 \u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b05\u0b24\u0b4d\u0b5f\u0b27\u0b3f\u0b15 \u0b1a\u0b3e\u0b2a\u0b30\u0b41 \u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',do3:'\u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b4d \u0b15\u0b41 \u0b05\u0b27\u0b3f\u0b15\u0b43\u0b24 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b3f\u0b02 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b15\u0b41 \u0b39\u0b38\u0b4d\u0b24\u0b3e\u0b28\u0b4d\u0b24\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964'},general:{title:'\u0b38\u0b3e\u0b27\u0b3e\u0b30\u0b23 \u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e',subtitle:'\u0b38\u0b2e\u0b38\u0b4d\u0b24 \u0b07\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b4d\u0b30\u0b4b\u0b28\u0b3f\u0b15\u0b4d \u0b2d\u0b19\u0b4d\u0b17\u0b3e\u0b30\u0b41\u0b1c\u0b3e \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b4d\u0b30\u0b3e\u0b25\u0b2e\u0b3f\u0b15 \u0b38\u0b24\u0b30\u0b4d\u0b15\u0b24\u0b3e',warning:'\u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41\u0b30\u0b47 \u0b05\u0b28\u0b47\u0b15 \u0b2c\u0b3f\u0b2a\u0b26\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b09\u0b2a\u0b3e\u0b26\u0b3e\u0b28 \u0b25\u0b3e\u0b0f\u0964 \u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b15\u0b26\u0b3e\u0b2a\u0b3f \u0b1c\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b2c\u0b3e \u0b16\u0b4b\u0b32\u0b3e\u0b30\u0b47 \u0b2b\u0b3f\u0b19\u0b4d\u0b17\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',whyDangerous:'\u0b07\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b4d\u0b30\u0b4b\u0b28\u0b3f\u0b15\u0b4d \u0b09\u0b2a\u0b15\u0b30\u0b23\u0b30\u0b47 \u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d, \u0b27\u0b3e\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b30\u0b38\u0b3e\u0b5f\u0b28 \u0b25\u0b3e\u0b0f\u0964 \u0b2d\u0b41\u0b32\u0b4d \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b3f\u0b32\u0b47 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b27\u0b42\u0b33\u0b3f \u0b09\u0b21\u0b3c\u0b47 \u0b0f\u0b2c\u0b02 \u0b2e\u0b3e\u0b1f\u0b3f \u0b13 \u0b2a\u0b3e\u0b23\u0b3f \u0b2a\u0b4d\u0b30\u0b26\u0b42\u0b37\u0b3f\u0b24 \u0b39\u0b41\u0b0f\u0964',dont1:'\u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41\u0b15\u0b41 \u0b16\u0b4b\u0b32\u0b3e\u0b30\u0b47 \u0b1c\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b3e\u0b33 \u0b2c\u0b3e \u0b16\u0b3e\u0b32\u0b3f \u0b2a\u0b21\u0b3c\u0b3f\u0b06\u0b30\u0b47 \u0b2b\u0b3f\u0b19\u0b4d\u0b17\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont2:'\u0b39\u0b3e\u0b24\u0b41\u0b21\u0b3c\u0b3f\u0b30\u0b47 \u0b2f\u0b28\u0b4d\u0b24\u0b4d\u0b30\u0b3e\u0b02\u0b36\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15\u0b41 \u0b05\u0b28\u0b3f\u0b5f\u0b28\u0b4d\u0b24\u0b4d\u0b30\u0b3f\u0b24 \u0b2d\u0b3e\u0b2c\u0b47 \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont3:'\u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40 \u0b0f\u0b2c\u0b02 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f\u0b15\u0b41 \u0b38\u0b3e\u0b27\u0b3e\u0b30\u0b23 \u0b32\u0b41\u0b39\u0b3e-\u0b24\u0b2e\u0b4d\u0b2c\u0b3e \u0b2d\u0b19\u0b4d\u0b17\u0b3e \u0b38\u0b39\u0b3f\u0b24 \u0b2e\u0b3f\u0b36\u0b3e\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',do1:'\u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41\u0b15\u0b41 \u0b2c\u0b3f\u0b2d\u0b3f\u0b28\u0b4d\u0b28 \u0b2c\u0b30\u0b4d\u0b17 (\u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40, \u0b2c\u0b4b\u0b30\u0b4d\u0b21, \u0b24\u0b3e\u0b30, \u0b09\u0b2a\u0b15\u0b30\u0b23) \u0b30\u0b47 \u0b05\u0b32\u0b17\u0b3e \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964',do2:'\u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40\u0b15\u0b41 \u0b2e\u0b3e\u0b1f\u0b3f\u0b30\u0b41 \u0b09\u0b2a\u0b30\u0b47, \u0b06\u0b1a\u0b4d\u0b1b\u0b3e\u0b26\u0b3f\u0b24 \u0b36\u0b41\u0b16\u0b3f\u0b32\u0b3e \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b30\u0b47 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964',do3:'\u0b28\u0b3f\u0b30\u0b3e\u0b2a\u0b26 \u0b28\u0b3f\u0b37\u0b4d\u0b15\u0b3e\u0b38\u0b28 \u0b2a\u0b3e\u0b07\u0b01 \u0b15\u0b47\u0b2c\u0b33 \u0b05\u0b27\u0b3f\u0b15\u0b43\u0b24 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30\u0b19\u0b4d\u0b15 \u0b38\u0b39\u0b3f\u0b24 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964'},storage:{title:'\u0b38\u0b02\u0b30\u0b15\u0b4d\u0b37\u0b23 \u0b13 \u0b2a\u0b30\u0b3f\u0b2c\u0b39\u0b28 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e',subtitle:'\u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b25\u0b3e\u0b15, \u0b2c\u0b30\u0b4d\u0b37\u0b3e\u0b30\u0b41 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b0f\u0b2c\u0b02 \u0b17\u0b3e\u0b21\u0b3c\u0b3f \u0b2a\u0b30\u0b3f\u0b2c\u0b39\u0b28 \u0b28\u0b3f\u0b5f\u0b2e',warning:'\u0b09\u0b1a\u0b4d\u0b1a \u0b25\u0b3e\u0b15 \u0b2d\u0b41\u0b36\u0b41\u0b21\u0b3c\u0b3f \u0b2a\u0b21\u0b3c\u0b3f\u0b32\u0b47 \u0b06\u0b18\u0b3e\u0b24 \u0b32\u0b3e\u0b17\u0b3f\u0b2a\u0b3e\u0b30\u0b47; \u0b13\u0b26\u0b3e \u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b13 \u0b1a\u0b3e\u0b2a\u0b3f \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40 \u0b28\u0b3f\u0b06\u0b01 \u0b32\u0b17\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b47\u0964',whyDangerous:'\u0b2d\u0b3e\u0b30\u0b40 \u0b09\u0b2a\u0b15\u0b30\u0b23\u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b20\u0b3f\u0b15\u0b4d \u0b2d\u0b3e\u0b2c\u0b47 \u0b28 \u0b30\u0b16\u0b3f\u0b32\u0b47 \u0b16\u0b38\u0b3f\u0b2a\u0b21\u0b3c\u0b3f \u0b26\u0b41\u0b30\u0b4d\u0b18\u0b1f\u0b23\u0b3e \u0b18\u0b1f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b47\u0964 \u0b2a\u0b3e\u0b23\u0b3f \u0b2a\u0b36\u0b3f\u0b32\u0b47 \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40 \u0b38\u0b30\u0b4d\u0b1f \u0b38\u0b30\u0b4d\u0b15\u0b3f\u0b1f\u0b4d \u0b39\u0b4b\u0b07\u0b2a\u0b3e\u0b30\u0b47 \u0b0f\u0b2c\u0b02 \u0b17\u0b3e\u0b21\u0b3c\u0b3f\u0b30\u0b41 \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b16\u0b38\u0b3f\u0b2a\u0b3e\u0b30\u0b47\u0964',dont1:'\u0b2e\u0b1c\u0b2c\u0b41\u0b24\u0b4d \u0b06\u0b27\u0b3e\u0b30 \u0b2c\u0b3f\u0b28\u0b3e \u0b2d\u0b3e\u0b30\u0b40 \u0b2e\u0b28\u0b3f\u0b1f\u0b30 \u0b2c\u0b3e \u0b09\u0b2a\u0b15\u0b30\u0b23\u0b15\u0b41 \u0b2c\u0b39\u0b41\u0b24 \u0b09\u0b1a\u0b4d\u0b1a\u0b30\u0b47 \u0b25\u0b3e\u0b15 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont2:'\u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41\u0b15\u0b41 \u0b2c\u0b30\u0b4d\u0b37\u0b3e\u0b30\u0b47 \u0b16\u0b4b\u0b32\u0b3e\u0b30\u0b47 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b1a\u0b41\u0b32\u0b3f/\u0b28\u0b3f\u0b06\u0b01 \u0b28\u0b3f\u0b15\u0b1f\u0b30\u0b47 \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont3:'\u0b30\u0b3f\u0b15\u0b4d\u0b38\u0b3e, \u0b20\u0b47\u0b32\u0b3e\u0b17\u0b3e\u0b21\u0b3c\u0b3f \u0b2c\u0b3e \u0b2c\u0b3e\u0b07\u0b15\u0b4d \u0b30\u0b47 \u0b2c\u0b3f\u0b28\u0b3e \u0b30\u0b36\u0b3f \u0b2c\u0b3e\u0b28\u0b4d\u0b27\u0b3f \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b2c\u0b4b\u0b39\u0b3f \u0b28\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',do1:'\u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41\u0b15\u0b41 \u0b36\u0b41\u0b16\u0b3f\u0b32\u0b3e, \u0b2a\u0b2c\u0b28 \u0b1a\u0b33\u0b3e\u0b1a\u0b33 \u0b15\u0b30\u0b41\u0b25\u0b3f\u0b2c\u0b3e \u0b0f\u0b2c\u0b02 \u0b2c\u0b30\u0b4d\u0b37\u0b3e\u0b30\u0b41 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b30\u0b47 \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964',do2:'\u0b28\u0b37\u0b4d\u0b1f \u0b2c\u0b3e \u0b32\u0b3f\u0b15\u0b4d \u0b39\u0b47\u0b09\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b15\u0b41 \u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d \u0b2a\u0b3e\u0b24\u0b4d\u0b30\u0b30\u0b47 \u0b05\u0b32\u0b17\u0b3e \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964',do3:'\u0b17\u0b3e\u0b21\u0b3c\u0b3f\u0b30\u0b47 \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40\u0b15\u0b41 \u0b26\u0b09\u0b21\u0b3c\u0b3f\u0b30\u0b47 \u0b2d\u0b32\u0b2d\u0b3e\u0b2c\u0b47 \u0b2c\u0b3e\u0b28\u0b4d\u0b27\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b2d\u0b3e\u0b30\u0b40 \u0b1c\u0b3f\u0b28\u0b3f\u0b37 \u0b06\u0b23\u0b4d\u0b20\u0b41 \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b3f \u0b09\u0b20\u0b3e\u0b28\u0b4d\u0b24\u0b41\u0964'},ppe:{title:'\u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b09\u0b2a\u0b15\u0b30\u0b23 (\u0b2a\u0b3f\u0b2a\u0b3f\u0b07)',subtitle:'\u0b2d\u0b19\u0b4d\u0b17\u0b3e \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b09\u0b20\u0b3e\u0b07\u0b2c\u0b3e \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b28\u0b3f\u0b1c \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15 \u0b09\u0b2a\u0b15\u0b30\u0b23',warning:'\u0b39\u0b3e\u0b24\u0b2e\u0b4b\u0b1c\u0b3e \u0b0f\u0b2c\u0b02 \u0b1c\u0b4b\u0b24\u0b3e \u0b15\u0b1f\u0b3f\u0b2f\u0b3f\u0b2c\u0b3e\u0b30\u0b41 \u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b30\u0b47\u0964 \u0b2a\u0b3f\u0b2a\u0b3f\u0b07 \u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b1c\u0b33\u0b3e\u0b07\u0b2c\u0b3e \u0b2c\u0b3e \u0b0f\u0b38\u0b3f\u0b21\u0b4d \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30\u0b15\u0b41 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b15\u0b30\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',whyDangerous:'\u0b2d\u0b19\u0b4d\u0b17\u0b3e \u0b07\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b4d\u0b30\u0b4b\u0b28\u0b3f\u0b15\u0b4d\u0b38 \u0b27\u0b30\u0b3f\u0b2c\u0b3e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b39\u0b3e\u0b24 \u0b15\u0b1f\u0b3f\u0b2c\u0b3e, \u0b15\u0b3e\u0b1a \u0b2b\u0b41\u0b1f\u0b3f\u0b2c\u0b3e \u0b0f\u0b2c\u0b02 \u0b39\u0b3e\u0b24\u0b30\u0b47 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b27\u0b42\u0b33\u0b3f \u0b32\u0b3e\u0b17\u0b3f\u0b2c\u0b3e\u0b30 \u0b2d\u0b5f \u0b25\u0b3e\u0b0f\u0964',dont1:'\u0b2d\u0b19\u0b4d\u0b17\u0b3e \u0b15\u0b3e\u0b1a, \u0b16\u0b4b\u0b32\u0b3e \u0b24\u0b3e\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b27\u0b3e\u0b30\u0b41\u0b06 \u0b27\u0b3e\u0b24\u0b41\u0b15\u0b41 \u0b16\u0b3e\u0b32\u0b3f \u0b39\u0b3e\u0b24\u0b30\u0b47 \u0b1b\u0b41\u0b05\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont2:'\u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b1b\u0b41\u0b07\u0b01\u0b2c\u0b3e \u0b2a\u0b30\u0b47 \u0b39\u0b3e\u0b24 \u0b28 \u0b27\u0b4b\u0b07 \u0b16\u0b3e\u0b26\u0b4d\u0b5f \u0b16\u0b3e\u0b06\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b3e\u0b23\u0b3f \u0b2a\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',dont3:'\u0b39\u0b3e\u0b24\u0b2e\u0b4b\u0b1c\u0b3e \u0b2a\u0b3f\u0b28\u0b4d\u0b27\u0b3f\u0b32\u0b47 \u0b2c\u0b3f \u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b1c\u0b33\u0b3e\u0b07\u0b2c\u0b3e \u0b2c\u0b3e \u0b0f\u0b38\u0b3f\u0b21\u0b4d \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b15\u0b26\u0b3e\u0b2a\u0b3f \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24 \u0b28\u0b41\u0b39\u0b47\u0b01\u0964',do1:'\u0b2d\u0b19\u0b4d\u0b17\u0b3e \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b09\u0b20\u0b3e\u0b07\u0b2c\u0b3e \u0b13 \u0b2c\u0b3e\u0b1b\u0b3f\u0b2c\u0b3e \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b2e\u0b4b\u0b1f\u0b3e \u0b2e\u0b1c\u0b2c\u0b41\u0b24\u0b4d \u0b39\u0b3e\u0b24\u0b2e\u0b4b\u0b1c\u0b3e \u0b2a\u0b3f\u0b28\u0b4d\u0b27\u0b28\u0b4d\u0b24\u0b41\u0964',do2:'\u0b2a\u0b3e\u0b26\u0b30\u0b47 \u0b2c\u0b28\u0b4d\u0b26 \u0b1c\u0b4b\u0b24\u0b3e \u0b2a\u0b3f\u0b28\u0b4d\u0b27\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b06\u0b16\u0b3f \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b1a\u0b37\u0b2e\u0b3e \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',do3:'\u0b15\u0b3e\u0b2e \u0b38\u0b30\