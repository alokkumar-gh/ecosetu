30\u0947\u0923\u0940 \u0916\u0941\u0926 \u091a\u0941\u0928\u0947\u0902\u0964",retryAnalysis:"AI \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902"},saathi:{clarification_prompt:"\u092e\u0941\u091d\u0947 \u0915\u0941\u091b \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0935\u093f\u0937\u092f \u092e\u093f\u0932\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a \u0915\u093f\u0938\u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0928\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?",actions:{open_disputes:"\u0935\u093f\u0935\u093e\u0926 \u0916\u094b\u0932\u0947\u0902",open_price_board:"\u092a\u094d\u0930\u093e\u0907\u0938 \u092c\u094b\u0930\u094d\u0921 \u0926\u0947\u0916\u0947\u0902",create_lot:"\u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0932\u0949\u091f \u092c\u0928\u093e\u090f\u0902",view_my_lots:"\u092e\u0947\u0930\u0947 \u0932\u0949\u091f\u094d\u0938 \u0926\u0947\u0916\u0947\u0902",citizen_submit:"\u0908-\u0915\u091a\u0930\u093e \u0926\u0947\u0902",view_requests:"\u0905\u0928\u0941\u0930\u094b\u0927 \u0926\u0947\u0916\u0947\u0902",open_marketplace:"\u092e\u093e\u0930\u094d\u0915\u0947\u091f\u092a\u094d\u0932\u0947\u0938 \u0926\u0947\u0916\u0947\u0902",open_deals:"\u0921\u0940\u0932 \u0914\u0930 \u0911\u092b\u0930 \u0926\u0947\u0916\u0947\u0902",view_transactions:"\u0932\u0947\u0928-\u0926\u0947\u0928 \u0926\u0947\u0916\u0947\u0902",open_earnings:"\u092e\u0947\u0930\u0940 \u0915\u092e\u093e\u0908 \u0916\u094b\u0932\u0947\u0902",open_safety_center:"\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u0916\u094b\u0932\u0947\u0902",view_traceability:"\u092a\u094d\u0930\u092e\u093e\u0923\u092a\u0924\u094d\u0930 \u0914\u0930 \u092a\u094d\u0930\u092d\u093e\u0935 \u0926\u0947\u0916\u0947\u0902",open_language_settings:"\u092d\u093e\u0937\u093e \u092c\u0926\u0932\u0947\u0902",open_profile:"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0916\u094b\u0932\u0947\u0902"},intents:{who_is_eco_saathi:{answer:"\u0928\u092e\u0938\u094d\u0924\u0947! \u092e\u0948\u0902 \u0907\u0915\u094b-\u0938\u093e\u0925\u0940 \u0939\u0942\u0901, \u0906\u092a\u0915\u093e \u0907\u0915\u094b\u0938\u0947\u0924\u0941 \u0938\u0939\u093e\u092f\u0915\u0964 \u092e\u0948\u0902 \u0906\u092a\u0915\u094b \u0915\u092c\u093e\u0921\u093c \u092c\u0947\u091a\u0928\u0947, \u092d\u093e\u0935 \u0926\u0947\u0916\u0928\u0947, \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u094b \u0938\u092e\u091d\u0928\u0947 \u0914\u0930 \u0938\u094c\u0926\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0942\u0901\u0964"},what_is_ecosetu:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0941 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902, \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0915\u092c\u093e\u0921\u093c\u0940\u0935\u093e\u0932\u094b\u0902 \u0914\u0930 \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930\u094d\u0938 \u0915\u094b \u091c\u094b\u0921\u093c\u0915\u0930 \u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924, \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u0940 \u0914\u0930 \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0908-\u0915\u091a\u0930\u093e \u092e\u0942\u0932\u094d\u092f \u0936\u094d\u0930\u0943\u0902\u0916\u0932\u093e \u092c\u0928\u093e\u0924\u093e \u0939\u0948\u0964"},support_help:{answer:"\u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u092a \u0935\u093f\u0935\u093e\u0926 \u0935 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u092e\u0947\u0902 \u0936\u093f\u0915\u093e\u092f\u0924 \u091f\u093f\u0915\u091f \u0926\u0930\u094d\u091c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e support@ecosetu.org \u092a\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},ai_classes:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0941 \u090f\u0906\u0908 \u0915\u0948\u092e\u0930\u093e \u092e\u094b\u092c\u093e\u0907\u0932 \u092b\u094b\u0928, \u091f\u0948\u092c\u0932\u0947\u091f \u0914\u0930 \u0915\u0940\u092c\u094b\u0930\u094d\u0921/\u092e\u093e\u0909\u0938 \u0915\u094b \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u092a\u0939\u091a\u093e\u0928\u0924\u093e \u0939\u0948\u0964 \u0905\u0928\u094d\u092f 13 \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 (\u092a\u0940\u0938\u0940\u092c\u0940, \u092c\u0948\u091f\u0930\u0940, \u0915\u0947\u092c\u0932 \u0906\u0926\u093f) \u0915\u0947 \u0932\u093f\u090f \u0906\u092a \u0938\u0942\u091a\u0940 \u0938\u0947 \u092e\u0948\u0928\u094d\u092f\u0941\u0905\u0932 \u0930\u0942\u092a \u0938\u0947 \u091a\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},ai_manual_selection:{answer:"\u092f\u0926\u093f \u0906\u092a\u0915\u093e \u0908-\u0915\u091a\u0930\u093e \u0909\u092a\u0915\u0930\u0923 \u092a\u0939\u091a\u093e\u0928\u093e \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u092e\u0947\u0928\u0942 \u0938\u0947 \u0938\u0939\u0940 \u0936\u094d\u0930\u0947\u0923\u0940 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0905\u0928\u0941\u092e\u093e\u0928\u093f\u0924 \u0935\u091c\u0928 \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964"},ai_accuracy:{answer:"\u090f\u0906\u0908 \u092a\u0939\u091a\u093e\u0928 \u0915\u0947\u0935\u0932 \u0906\u092a\u0915\u0940 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0939\u0948\u0964 \u092f\u0939 \u0905\u0902\u0924\u093f\u092e \u0915\u0940\u092e\u0924 \u0924\u092f \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e; \u0906\u092a\u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0935\u093f\u0935\u0930\u0923 \u092c\u0926\u0932\u0928\u0947 \u0914\u0930 \u091c\u093e\u0902\u091a\u0928\u0947 \u0915\u093e \u092a\u0942\u0930\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0939\u0948\u0964"},price_board:{answer:"\u0906\u092a \u092a\u094d\u0930\u093e\u0907\u0938 \u092c\u094b\u0930\u094d\u0921 \u092a\u0930 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092c\u0947\u0902\u091a\u092e\u093e\u0930\u094d\u0915 \u0938\u094d\u0915\u094d\u0930\u0948\u092a \u0926\u0930\u0947\u0902 \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0947 \u0926\u0930\u0947\u0902 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u0940\u092f \u092c\u093e\u091c\u093e\u0930 \u092e\u093e\u0902\u0917 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0905\u092a\u0921\u0947\u091f \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964"},todays_price:{answer:"\u0938\u094d\u0915\u094d\u0930\u0948\u092a \u0915\u0947 \u0926\u093e\u092e \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0914\u0930 \u0936\u0941\u0926\u094d\u0927\u0924\u093e \u092a\u0930 \u0928\u093f\u0930\u094d\u092d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u093e\u0907\u0935 \u0938\u093e\u0902\u0915\u0947\u0924\u093f\u0915 \u0926\u0930\u0947\u0902 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u093e\u0907\u0938 \u092c\u094b\u0930\u094d\u0921 \u0916\u094b\u0932\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948..."},price_determination:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0941 \u092a\u0930 \u0915\u0940\u092e\u0924\u0947\u0902 \u0915\u092c\u093e\u0921\u093c\u0940\u0935\u093e\u0932\u0947 \u0914\u0930 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0915\u0947 \u092c\u0940\u091a \u0906\u092a\u0938\u0940 \u0938\u0939\u092e\u0924\u093f \u0938\u0947 \u0924\u092f \u0939\u094b\u0924\u0940 \u0939\u0948\u0902, \u091c\u093f\u0938\u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u0907\u0938 \u092c\u094b\u0930\u094d\u0921 \u090f\u0915 \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u0940 \u092c\u0947\u0902\u091a\u092e\u093e\u0930\u094d\u0915 \u0915\u093e \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},how_to_create_lot:{answer:"\u0908-\u0915\u091a\u0930\u093e \u092c\u0947\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f '\u092c\u0947\u091a\u0947\u0902' \u092a\u0930 \u091c\u093e\u090f\u0902, \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u091a\u0941\u0928\u0947\u0902, \u090f\u0906\u0908 \u0915\u0948\u092e\u0930\u0947 \u0938\u0947 \u092b\u094b\u091f\u094b \u0932\u0947\u0902, \u0935\u091c\u0928 \u0921\u093e\u0932\u0947\u0902 \u0914\u0930 \u0905\u0927\u093f\u0915\u0943\u0924 \u0916\u0930\u0940\u0926\u093e\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0932\u0949\u091f \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"},my_lots_status:{answer:"\u0906\u092a\u0915\u0947 \u0938\u0915\u094d\u0930\u093f\u092f \u0932\u0949\u091f \u0914\u0930 \u0932\u093f\u0938\u094d\u091f\u093f\u0902\u0917 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948..."},lot_categories:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0941 16 \u092e\u093e\u0928\u0915 \u0908-\u0915\u091a\u0930\u093e \u0936\u094d\u0930\u0947\u0923\u093f\u092f\u094b\u0902 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u092e\u0947\u0902 \u092a\u0940\u0938\u0940\u092c\u0940, \u092c\u0948\u091f\u0930\u0940, \u0924\u093e\u0930, \u0938\u0940\u0906\u0930\u091f\u0940, \u090f\u0932\u0938\u0940\u0921\u0940, \u092e\u094b\u092c\u093e\u0907\u0932 \u0914\u0930 \u0932\u0948\u092a\u091f\u0949\u092a \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964"},citizen_give_ewaste:{answer:"\u0905\u092a\u0928\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u094d\u0938 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f '\u091c\u092e\u093e \u0915\u0930\u0947\u0902' \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902, \u092b\u094b\u091f\u094b \u0932\u0947\u0902, \u0905\u092a\u0928\u093e \u092a\u0924\u093e \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u092c\u093e\u0921\u093c\u0940\u0935\u093e\u0932\u093e \u0907\u0938\u0947 \u0932\u0947\u0928\u0947 \u0906\u090f\u0917\u093e\u0964"},citizen_requests_status:{answer:"\u0906\u092a\u0915\u0947 \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u0930\u094d\u091c \u0915\u093f\u090f \u0917\u090f \u092a\u093f\u0915\u0905\u092a \u0905\u0928\u0941\u0930\u094b\u0927\u094b\u0902 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948..."},marketplace_browse:{answer:"\u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u092a\u094d\u0932\u0947\u0938 \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0932\u0949\u091f \u0926\u0947\u0916 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0938\u0940\u0927\u0947 \u0916\u0930\u0940\u0926 \u092c\u094b\u0932\u093f\u092f\u093e\u0902 \u0932\u0917\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},view_offers:{answer:"\u0906\u092a\u0915\u0947 \u0932\u0949\u091f\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u092c\u094b\u0932\u093f\u092f\u094b\u0902 \u0914\u0930 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0911\u092b\u0930\u094d\u0938 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948..."},negotiate_offer:{answer:"\u091c\u092c \u0915\u094b\u0908 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0906\u092a\u0915\u0947 \u0932\u0949\u091f \u092a\u0930 \u092c\u094b\u0932\u0940 \u0932\u0917\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u0906\u092a '\u0921\u0940\u0932' \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u091c\u093e\u0915\u0930 \u0911\u092b\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0905\u092a\u0928\u093e \u0915\u093e\u0909\u0902\u091f\u0930-\u0930\u0947\u091f \u092d\u0947\u091c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},handover_protocol:{answer:"\u092d\u094c\u0924\u093f\u0915 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0915\u092c\u093e\u0921\u093c\u0940\u0935\u093e\u0932\u093e \u0914\u0930 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0935\u091c\u0928 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u091c\u0940\u092a\u0940\u090f\u0938 \u0938\u094d\u0925\u093e\u0928 \u0935 \u0930\u0947\u092b\u0930\u0947\u0902\u0938 \u0915\u094b\u0921 \u0915\u0947 \u0938\u093e\u0925 \u0921\u093f\u0932\u0940\u0935\u0930\u0940 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"},handover_qr_code:{answer:"\u0916\u0930\u0940\u0926\u093e\u0930 \u0915\u0947 \u0938\u093e\u0925 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u092a\u0942\u0930\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0915\u094d\u0930\u093f\u092f \u0938\u094c\u0926\u0947 \u092a\u0930 \u0926\u093f\u0916\u093e\u0908 \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u0947 \u0921\u093f\u091c\u093f\u091f\u0932 \u0930\u0947\u092b\u0930\u0947\u0902\u0938 \u0915\u094b\u0921 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"},payment_methods:{answer:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0941\u0917\u0924\u093e\u0928 \u0928\u0915\u0926, \u092f\u0942\u092a\u0940\u0906\u0908 (\u0910\u092a \u092e\u0947\u0902 \u0926\u0930\u094d\u091c) \u092f\u093e \u092c\u0948\u0902\u0915 \u091f\u094d\u0930\u093e\u0902\u0938\u092b\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u0940\u0927\u0947 \u0924\u092f \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"},payment_status:{answer:"\u0906\u092a\u0915\u0947 \u0926\u0930\u094d\u091c \u0932\u0947\u0928-\u0926\u0947\u0928 \u0914\u0930 \u0928\u093f\u092a\u091f\u093e\u0928 \u0915\u0940 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948..."},payment_non_custodial:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0941 \u090f\u0915 \u0917\u0948\u0930-\u0915\u0938\u094d\u091f\u094b\u0921\u093f\u092f\u0932 \u092a\u094d\u0932\u0947\u091f\u092b\u0949\u0930\u094d\u092e \u0939\u0948 \u091c\u094b \u092a\u0948\u0938\u0947 \u0930\u094b\u0915\u0947 \u092c\u093f\u0928\u093e \u0915\u0947\u0935\u0932 \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0932\u0947\u0928-\u0926\u0947\u0928 \u0915\u093e \u0911\u0921\u093f\u091f \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"},view_earnings:{answer:"\u0906\u092a\u0915\u0940 \u0915\u0941\u0932 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u092e\u093e\u0908 \u0914\u0930 \u0932\u0947\u0928-\u0926\u0947\u0928 \u0907\u0924\u093f\u0939\u093e\u0938 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948..."},safety_battery:{answer:"\u091a\u0947\u0924\u093e\u0935\u0928\u0940: \u092b\u0942\u0932\u0940 \u0939\u0941\u0908 \u0932\u093f\u0925\u093f\u092f\u092e-\u0906\u092f\u0928 \u092c\u0948\u091f\u0930\u0940 \u0915\u094b \u0915\u092d\u0940 \u0928 \u0926\u092c\u093e\u090f\u0902, \u0928 \u091b\u0947\u0926\u0947\u0902 \u0914\u0930 \u0928 \u0939\u0940 \u092a\u093e\u0928\u0940 \u092f\u093e \u0917\u0930\u094d\u092e\u0940 \u0915\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u092e\u0947\u0902 \u0932\u093e\u090f\u0902\u0964 \u0907\u0938\u0947 \u0938\u0942\u0916\u0947 \u0921\u093f\u092c\u094d\u092c\u0947 \u092e\u0947\u0902 \u0930\u0916\u0947\u0902\u0964"},safety_burning:{answer:"\u0916\u0924\u0930\u093e: \u0924\u093e\u0902\u092c\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u093e\u0930\u094b\u0902 \u092f\u093e \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0915\u094b \u0915\u092d\u0940 \u0928 \u091c\u0932\u093e\u090f\u0902\u0964 \u0916\u0941\u0932\u0947 \u092e\u0947\u0902 \u091c\u0932\u093e\u0928\u0947 \u0938\u0947 \u091c\u0939\u0930\u0940\u0932\u093e \u0927\u0941\u0906\u0902 \u0914\u0930 \u0938\u0940\u0938\u093e \u0928\u093f\u0915\u0932\u0924\u093e \u0939\u0948\u0964 \u0915\u0947\u0935\u0932 \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0915\u094b \u092c\u0947\u091a\u0947\u0902\u0964"},safety_acid:{answer:"\u0917\u0902\u092d\u0940\u0930 \u0916\u0924\u0930\u093e: \u0938\u094b\u0928\u093e \u0928\u093f\u0915\u093e\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0918\u0930 \u092a\u0930 \u0924\u0947\u091c\u093e\u092c \u092f\u093e \u0930\u093e\u0938\u093e\u092f\u0928\u093f\u0915 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0928 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u091c\u093e\u0928\u0932\u0947\u0935\u093e \u0939\u0948 \u0914\u0930 \u092a\u093e\u0928\u0940 \u0915\u094b \u0926\u0942\u0937\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"},safety_ppe:{answer:"\u0908-\u0915\u091a\u0930\u093e \u0938\u0902\u092d\u093e\u0932\u0924\u0947 \u0938\u092e\u092f \u0939\u092e\u0947\u0936\u093e \u092e\u094b\u091f\u0947 \u0926\u0938\u094d\u0924\u093e\u0928\u0947, \u092e\u093e\u0938\u094d\u0915 \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e\u0924\u094d\u092e\u0915 \u091a\u0936\u094d\u092e\u093e \u092a\u0939\u0928\u0947\u0902 \u0924\u093e\u0915\u093f \u091a\u094b\u091f \u0914\u0930 \u0927\u0942\u0932 \u0938\u0947 \u092c\u091a\u093e\u0935 \u0939\u094b \u0938\u0915\u0947\u0964"},safety_crt:{answer:"\u0938\u093e\u0935\u0927\u093e\u0928\u0940: \u092a\u0941\u0930\u093e\u0928\u0947 \u091f\u0940\u0935\u0940 \u0914\u0930 \u0938\u0940\u0906\u0930\u091f\u0940 \u092e\u0949\u0928\u093f\u091f\u0930 \u092e\u0947\u0902 \u0935\u0948\u0915\u094d\u092f\u0942\u092e \u0914\u0930 \u091c\u0939\u0930\u0940\u0932\u093e \u0938\u0940\u0938\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u0938\u0940\u0906\u0930\u091f\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u094b \u0915\u092d\u0940 \u0928 \u092b\u094b\u0921\u093c\u0947\u0902\u0964"},report_dispute:{answer:"\u092f\u0926\u093f \u0935\u091c\u0928 \u092f\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0905\u0902\u0924\u0930 \u0906\u0924\u093e \u0939\u0948, \u0924\u094b \u0906\u092a \u092b\u094b\u091f\u094b \u092a\u094d\u0930\u092e\u093e\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0924\u0941\u0930\u0902\u0924 \u0935\u093f\u0935\u093e\u0926 \u091f\u093f\u0915\u091f \u0926\u0930\u094d\u091c \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},dispute_policy:{answer:"\u0935\u093f\u0935\u093e\u0926\u094b\u0902 \u0915\u0940 \u091c\u093e\u0902\u091a \u0907\u0915\u094b\u0938\u0947\u0924\u0941 \u090f\u0921\u092e\u093f\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u094b\u0928\u094b\u0902 \u092a\u0915\u094d\u0937\u094b\u0902 \u0915\u0947 \u0911\u0921\u093f\u091f \u0932\u0949\u0917, \u091c\u0940\u092a\u0940\u090f\u0938 \u0914\u0930 \u0930\u0938\u0940\u0926\u094b\u0902 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"},recycler_verification:{answer:"\u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930\u094d\u0938 \u0915\u094b \u0907\u0915\u094b\u0938\u0947\u0924\u0941 \u092a\u0930 \u0932\u0949\u091f \u0916\u0930\u0940\u0926\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0935\u0948\u0927 \u0938\u0940\u092a\u0940\u0938\u0940\u092c\u0940/\u090f\u0938\u092a\u0940\u0938\u0940\u092c\u0940 \u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u0914\u0930 \u091c\u0940\u090f\u0938\u091f\u0940 \u0928\u0902\u092c\u0930 \u091c\u092e\u093e \u0915\u0930\u0928\u093e \u0905\u0928\u093f\u0935\u093e\u0930\u094d\u092f \u0939\u0948\u0964"},green_certificate:{answer:"\u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0941\u0928\u0930\u094d\u091a\u0915\u094d\u0930\u093f\u0924 \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0908-\u0915\u091a\u0930\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0917\u094d\u0930\u0940\u0928 \u0938\u0930\u094d\u091f\u093f\u092b\u093f\u0915\u0947\u091f \u0914\u0930 \u092c\u091a\u093e\u0908 \u0917\u0908 \u0938\u0940\u0913\u0968 \u0915\u0940 \u0917\u0923\u0928\u093e \u091c\u093e\u0930\u0940 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"},offline_mode:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0941 \u0911\u092b\u0932\u093e\u0907\u0928 \u092d\u0940 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948! \u0906\u092a \u092c\u093f\u0928\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0915\u0947 \u0932\u0949\u091f \u092c\u0928\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902; \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0906\u0928\u0947 \u092a\u0930 \u0921\u0947\u091f\u093e \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u093f\u0902\u0915 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964"},change_language:{answer:"\u0906\u092a \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u091c\u093e\u0915\u0930 \u0915\u092d\u0940 \u092d\u0940 \u0939\u093f\u0902\u0926\u0940, \u0905\u0902\u0917\u094d\u0930\u0947\u091c\u0940, \u092e\u0930\u093e\u0920\u0940 \u092f\u093e \u0909\u0921\u093c\u093f\u092f\u093e \u092d\u093e\u0937\u093e \u091a\u0941\u0928 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},profile_settings:{answer:"\u0906\u092a \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u0947 \u0905\u092a\u0928\u093e \u0928\u093e\u092e, \u092b\u094b\u0928 \u0928\u0902\u092c\u0930 \u0914\u0930 \u092a\u0930\u093f\u091a\u093e\u0932\u0928 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"},verification_status:{answer:"\u090f\u0921\u092e\u093f\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0915\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u0928 \u0938\u094d\u0925\u093f\u0924\u093f \u091c\u093e\u0902\u091a\u0940 \u091c\u093e \u0930\u0939\u0940 \u0939\u0948..."},unknown:{answer:"\u092e\u0947\u0930\u0947 \u092a\u093e\u0938 \u0907\u0938\u0915\u0947 \u0932\u093f\u090f \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0909\u0924\u094d\u0924\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u0938\u094d\u0915\u094d\u0930\u0948\u092a \u092d\u093e\u0935, \u0932\u0949\u091f \u092c\u0928\u093e\u0928\u0947, \u092d\u0941\u0917\u0924\u093e\u0928, \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092f\u093e \u092d\u093e\u0937\u093e \u092c\u0926\u0932\u0928\u0947 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092a\u0942\u091b\u0947\u0902\u0964"}}}}},480,[]);
__d(function(e,t,i,a,o,n,s){Object.defineProperty(n,"__esModule",{value:!0}),n.mr=void 0;n.mr={common:{all:"\u0938\u0930\u094d\u0935",ok:"\u0920\u0940\u0915 \u0906\u0939\u0947",category:"\u092a\u094d\u0930\u0935\u0930\u094d\u0917",allTime:"\u090f\u0915\u0942\u0923 \u0935\u0947\u0933",thisMonth:"\u092f\u093e \u092e\u0939\u093f\u0928\u094d\u092f\u093e\u0924",thisWeek:"\u092f\u093e \u0906\u0920\u0935\u0921\u094d\u092f\u093e\u0924",results:"\u0928\u093f\u0915\u093e\u0932",clearFilters:"\u092b\u093f\u0932\u094d\u091f\u0930 \u0915\u093e\u0922\u093e",comingSoon:"\u0932\u0935\u0915\u0930\u091a \u092f\u0947\u0924 \u0906\u0939\u0947",material:"\u0938\u093e\u0939\u093f\u0924\u094d\u092f",appName:"\u0907\u0915\u094b\u0938\u0947\u0924\u0942",loading:"\u0932\u094b\u0921 \u0939\u094b\u0924 \u0906\u0939\u0947...",retry:"\u092a\u0941\u0928\u094d\u0939\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u093e",save:"\u091c\u0924\u0928 \u0915\u0930\u093e",cancel:"\u0930\u0926\u094d\u0926 \u0915\u0930\u093e",confirm:"\u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u093e",submit:"\u0938\u093e\u0926\u0930 \u0915\u0930\u093e",edit:"\u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u093e",delete:"\u0939\u091f\u0935\u093e",close:"\u092c\u0902\u0926 \u0915\u0930\u093e",back:"\u092e\u093e\u0917\u0947",next:"\u092a\u0941\u0922\u0947",done:"\u092a\u0942\u0930\u094d\u0923",search:"\u0936\u094b\u0927\u093e",refresh:"\u0930\u093f\u092b\u094d\u0930\u0947\u0936 \u0915\u0930\u093e",yes:"\u0939\u094b\u092f",no:"\u0928\u093e\u0939\u0940",error:"\u0924\u094d\u0930\u0941\u091f\u0940",success:"\u092f\u0936\u0938\u094d\u0935\u0940",offline:"\u0911\u092b\u0932\u093e\u0907\u0928",online:"\u0911\u0928\u0932\u093e\u0907\u0928",language:"\u092d\u093e\u0937\u093e",selectLanguage:"\u092d\u093e\u0937\u093e \u0928\u093f\u0935\u0921\u093e"},auth:{signingOut:"\u0938\u093e\u0907\u0928 \u0906\u0909\u091f \u0939\u094b\u0924 \u0906\u0939\u0947\u2026",login:"\u0932\u0949\u0917 \u0907\u0928",register:"\u0