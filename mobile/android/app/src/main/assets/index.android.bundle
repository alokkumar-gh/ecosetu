Item:'\u0935\u0938\u094d\u0924\u0942 \u0915\u093e\u0922\u093e',itemList:'\u092f\u093e \u0935\u093f\u0928\u0902\u0924\u0940\u0924\u0940\u0932 \u0908-\u0915\u091a\u0930\u093e \u0935\u0938\u094d\u0924\u0942',noItemsInRequest:'\u0905\u0926\u094d\u092f\u093e\u092a \u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0935\u0938\u094d\u0924\u0942 \u091c\u094b\u0921\u0932\u0947\u0932\u0940 \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u0915\u093f\u092e\u093e\u0928 \u090f\u0915 \u0935\u0938\u094d\u0924\u0942 \u091c\u094b\u0921\u093e.',totalItems:'\u090f\u0915\u0942\u0923 \u0935\u0938\u094d\u0924\u0942',takePhoto:'\u092b\u094b\u091f\u094b \u0915\u093e\u0922\u093e',retakePhoto:'\u092a\u0941\u0928\u094d\u0939\u093e \u092b\u094b\u091f\u094b \u0915\u093e\u0922\u093e',removePhoto:'\u092b\u094b\u091f\u094b \u0915\u093e\u0922\u093e',replacePhoto:'\u092b\u094b\u091f\u094b \u092c\u0926\u0932\u093e',cameraPermissionDenied:'\u092b\u094b\u091f\u094b \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0945\u092e\u0947\u0930\u093e \u092a\u0930\u0935\u093e\u0928\u0917\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947.',cameraUnavailable:'\u092f\u093e \u0909\u092a\u0915\u0930\u0923\u093e\u0935\u0930 \u0915\u0945\u092e\u0947\u0930\u093e \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947.',resolvingAddress:'\u0925\u0947\u091f \u0938\u094d\u0925\u093e\u0928\u093e\u0935\u0930\u0942\u0928 \u092a\u0924\u094d\u0924\u093e \u0936\u094b\u0927\u0932\u093e \u091c\u093e\u0924 \u0906\u0939\u0947...',reviewRequest:'\u092a\u093f\u0915\u0905\u092a \u0935\u093f\u0928\u0902\u0924\u0940\u091a\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u093e',confirmSubmitRequest:'\u0916\u093e\u0924\u094d\u0930\u0940 \u0915\u0930\u093e \u0906\u0923\u093f \u092a\u093f\u0915\u0905\u092a \u0935\u093f\u0928\u0902\u0924\u0940 \u0928\u094b\u0902\u0926\u0935\u093e',valSelectCategory:'\u0915\u0943\u092a\u092f\u093e \u0908-\u0915\u091a\u0930\u093e \u092a\u094d\u0930\u0935\u0930\u094d\u0917 \u0928\u093f\u0935\u0921\u093e.',valQuantity:'\u092a\u094d\u0930\u092e\u093e\u0923 1 \u0924\u0947 100 \u092e\u0927\u0940\u0932 \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915 \u0905\u0938\u093e\u0935\u0947.',valWeight:'\u0905\u0902\u0926\u093e\u091c\u0947 \u0935\u091c\u0928 0.01 \u0924\u0947 500 \u0915\u093f\u0932\u094b \u0926\u0930\u092e\u094d\u092f\u093e\u0928 \u0905\u0938\u093e\u0935\u0947.',valDescription:'\u0924\u092a\u0936\u0940\u0932 500 \u0905\u0915\u094d\u0937\u0930\u093e\u0902\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u093e\u0938\u094d\u0924 \u0928\u0938\u093e\u0935\u093e.',valPhotoUrl:'\u092b\u094b\u091f\u094b \u0932\u093f\u0902\u0915 500 \u0905\u0915\u094d\u0937\u0930\u093e\u0902\u092a\u0947\u0915\u094d\u0937\u093e \u091c\u093e\u0938\u094d\u0924 \u0928\u0938\u093e\u0935\u0940.',offlineDraftSuccess:'\u0908-\u0915\u091a\u0930\u093e \u0935\u0938\u094d\u0924\u0942 \u0911\u092b\u0932\u093e\u0907\u0928 \u092e\u0938\u0941\u0926\u093e \u092e\u094d\u0939\u0923\u0942\u0928 \u091c\u0924\u0928 \u0915\u0947\u0932\u0940. \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0938\u0941\u0930\u0942 \u091d\u093e\u0932\u094d\u092f\u093e\u0935\u0930 \u0924\u0940 \u0906\u092a\u094b\u0906\u092a \u0938\u0930\u094d\u0935\u094d\u0939\u0930\u0936\u0940 \u0938\u092e\u0915\u094d\u0930\u092e\u093f\u0924 \u0939\u094b\u0908\u0932.',submitSuccess:'\u0908-\u0915\u091a\u0930\u093e \u0935\u0938\u094d\u0924\u0942 \u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0935\u0932\u0940 \u0917\u0947\u0932\u0940! \u0906\u0924\u093e \u0924\u0940 \u0938\u0902\u0915\u0932\u0928\u093e\u0938\u093e\u0920\u0940 \u0924\u092f\u093e\u0930 \u0906\u0939\u0947.',submitError:'\u0908-\u0915\u091a\u0930\u093e \u0935\u0938\u094d\u0924\u0942 \u0928\u094b\u0902\u0926\u0935\u0923\u094d\u092f\u093e\u0924 \u0905\u092f\u0936\u0938\u094d\u0935\u0940. \u0915\u0943\u092a\u092f\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0924\u092a