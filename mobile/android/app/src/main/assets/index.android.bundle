ch:"Weight is Incorrect",materialMismatch:"Material is Different",conditionMismatch:"Condition Mismatch",partialAcceptance:"Only Part Accepted",handoverRejected:"Handover Rejected",handoverDispute:"Handover Dispute",paymentDispute:"Payment is Incorrect",cancellation:"Cancel Accepted Deal",returnRequest:"Request Return",other:"Other Issue",open:"Open",underReview:"Under Review",partiallyResolved:"Partially Resolved",resolved:"Resolved",rejected:"Rejected",cancelled:"Cancelled",returnPending:"Return Pending",returned:"Returned",submit:"Submit Dispute",respond:"Respond",resolve:"Resolve",accept:"Accept",reject:"Reject",returnRequested:"Return Requested",returnCompleted:"Return Completed",originalAmount:"Original Amount",adjustedAmount:"Adjusted Amount",originalWeight:"Original Weight",resolvedWeight:"Resolved Weight",resolutionNotes:"Resolution Notes",disputeReference:"Dispute Reference",timeline:"Timeline",evidence:"Evidence",noDisputes:"No Disputes"},payments:{payment:"Payment",choosePaymentMethod:"Choose Payment Method",cash:"Cash",upi:"UPI / Online",card:"Debit / Credit Card",netBanking:"Net Banking",paymentPending:"Payment Pending",paymentProcessing:"Payment Processing",paymentSuccessful:"Payment Successful",paymentFailed:"Payment Failed",cashConfirmation:"Cash Confirmation",cashPaid:"Cash Paid",cashReceived:"Cash Received",waitingForConfirmation:"Waiting for Confirmation",amountMismatch:"Amount Mismatch",reportPaymentIssue:"Report Payment Issue",payNow:"Pay Authoritative Amount",payer:"Payer",receiver:"Receiver",payerConfirmed:"Payer Confirmed",receiverConfirmed:"Receiver Confirmed",cashPaymentConfirmed:"Cash Payment Confirmed",amountDiffers:"Amount differs / Report issue",reportedCash:"Reported Cash",expectedAmount:"Expected Amount",difference:"Difference",discrepancyWarning:"Cash discrepancy detected. Routed to dispute resolution.",retryPayment:"Retry Payment",viewBill:"View Official Bill",testPaymentBadge:"TEST PAYMENT (Sandbox)"},billing:{bill:"Official Bill"