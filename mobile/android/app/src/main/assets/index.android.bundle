0935\u093f\u0928\u0902\u0924\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e\u0915\u0921\u0947 \u0938\u094b\u092a\u0935\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947. \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0932\u093e \u0915\u0933\u0935\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0905\u0938\u0942\u0928 \u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u093f\u0915\u0905\u092a \u0938\u092e\u0928\u094d\u0935\u092f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e.',conflictTitle:'\u0906\u0927\u0940\u091a \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u0940 \u0906\u0939\u0947',conflictMessage:'\u0907\u0924\u0930 \u0938\u0902\u0915\u0932\u0915\u093e\u0928\u0947 \u0939\u0940 \u0935\u093f\u0928\u0902\u0924\u0940 \u0906\u0927\u0940\u091a \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0932\u0940 \u0906\u0939\u0947.',accessDenied:'\u092a\u094d\u0930\u0935\u0947\u0936 \u0928\u093e\u0915\u093e\u0930\u0932\u093e',accessDeniedMessage:'\u0915\u0947\u0935\u0933 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u091d\u093e\u0932\u0947\u0932\u0947 \u0938\u0902\u0915\u0932\u0915\u091a \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0942 \u0936\u0915\u0924\u093e\u0924.',notFoundTitle:'\u0935\u093f\u0928\u0902\u0924\u0940 \u0906\u0922\u0933\u0932\u0940 \u0928\u093e\u0939\u0940',notFoundMessage:'\u0939\u0940 \u0938\u0902\u0915\u0932\u0928 \u0935\u093f\u0928\u0902\u0924\u0940 \u0906\u0924\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940 \u0915\u093f\u0902\u0935\u093e \u0928\u093e\u0917\u0930\u093f\u0915\u093e\u0928\u0947 \u0924\u0940 \u0930\u0926\u094d\u0926 \u0915\u0947\u0932\u0940 \u0906\u0939\u0947.',error:'\u0924\u094d\u0930\u0941\u091f\u0940',offlineAlert:'\u0911\u092b\u0932\u093e\u0907\u0928',offlineAvailability:'\u0911\u092b\u0932\u093e\u0907\u0928 \u0905\u0938\u0924\u093e\u0928\u093e \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e \u0938\u094d\u0925\u093f\u0924\u0940 \u092c\u0926\u0932\u0924\u093e \u092f\u0947\u0924 \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u0928\u0947\u091f\u0935\u0930\u094d\u0915\u0936\u0940 \u091c\u094b\u0921\u093e.',offlineAccept:'\u0911\u092b\u0932\u093e\u0907\u0928 \u0905\u0938\u0924\u093e\u0928\u093e \u0938\u0902\u0915\u0932\u0928 \u0935\u093f\u0928\u0902\u0924\u0940 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0924\u093e \u092f\u0947\u0924 \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u092a\u0941\u0928\u094d\u0939\u093e \u0915\u0928\u0947\u0915\u094d\u091f \u0915\u0930\u093e.',chainNote:'ECOSETU \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 \u0908-\u0915\u091a\u0930\u093e \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u0928\u093e\u0938\u093e\u0920\u0940 \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u0915\u092c\u093e\u0921\u0940\u0935\u093e\u0932\u093e \u092c\u093e\u0902\u0927\u0935\u093e\u0902\u0928\u093e \u0928\u093e\u0917\u0930\u093f\u0915 \u0935 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0936\u0940 \u091c\u094b\u0921\u0924\u0947.',suspendedNotice:'\u26a0\ufe0f \u0924\u0941\u092e\u091a\u0947 \u0938\u0902\u0915\u0932\u0915 \u0916\u093e\u0924\u0947 \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u0938\u092e\u0930\u094d\u0925\u0928\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.',pendingNotice:'\ud83d\udd50 \u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u0924\u0947 \u092a\u094d\u0930\u0936\u093e\u0938\u0915\u0940\u092f \u092a\u0921\u0924\u093e\u0933\u0923\u0940\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u0947\u0924 \u0906\u0939\u0947. \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0905\u0938\u0924\u093e\u0928\u093e \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u093f\u0928\u