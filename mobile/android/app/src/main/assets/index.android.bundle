al Amount',weight:'Weight',category:'Material',validity:'Valid Until',acceptAction:'Accept Offer',cancelAction:'Cancel',handoverConfirmTitle:'Confirm Material Handover',handoverConfirmMessage:'Please check the measured scale weight and buyer details before confirming.',handoverRef:'Handover Ref',locationStatus:'Location',photoCount:'Photos Attached',confirmHandoverAction:'Confirm Handover',saleConfirmTitle:'Confirm Sale Record',saleConfirmMessage:'Review the sale amount and payment method.',paymentMethod:'Payment Method',paymentStatus:'Payment Status',confirmSaleAction:'Record Sale',paymentDisclaimerShort:'Recording only. ECOSETU does not move money or process bank/UPI payments.',emptyBatchesTitle:'No Material Batches Yet',emptyBatchesDesc:'Capture scrap from your daily collections and build your inventory.',captureFirstBatch:'Capture First Batch',emptyOffersTitle:'No Offers Yet',emptyOffersDesc:'Check matching buyers in your area to receive price offers.',findBuyers:'Find Buyers',emptyEarningsTitle:'No Sales Recorded Yet',emptyEarningsDesc:'Record completed handovers and cash/UPI receipts to view earnings.',viewBatches:'View Batches',myEarningsQuickAction:'My Earnings & Sales',myEarningsSubtitle:'Recorded sales, cash received & pending balances',genericErrorTitle:'Action Incomplete',genericErrorMessage:'This action could not be completed right now. Please try again.',readLotDetails:'Listen to Lot Details',tapMatchingScrap:'Tap the picture that matches your collected scrap'},sync:{offlineMode:'Offline Mode',offlineNotice:'Working offline. Your records are saved safely on your device.',pendingSync:'Pending Sync',pendingCount:'records waiting to sync',syncing:'Syncing your records...',synced:'All records synced with server',syncFailed:'Sync incomplete. Touch to review or retry.',conflict:'Record Conflict',conflictReview:'Server record changed. Review required.',syncNow:'Sync Now',connectToSync:'Connect to the internet to synchronize records.',allSynced:'All records up