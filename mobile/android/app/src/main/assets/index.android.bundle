a\u094d\u0930\u0932\u0902\u092c\u093f\u0924',dueAmount:'\u092c\u093e\u0915\u0940',paidAmount:'\u092e\u093f\u0933\u093e\u0932\u0947',saleAmount:'\u090f\u0915\u0942\u0923 \u0935\u093f\u0915\u094d\u0930\u0940',loading:'\u0915\u092e\u093e\u0908\u091a\u093e \u0924\u092a\u0936\u0940\u0932 \u0932\u094b\u0921 \u0939\u094b\u0924 \u0906\u0939\u0947...',historicalPerformance:'\u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0915\u093e\u092e\u0917\u093f\u0930\u0940',recorded:'\u0928\u094b\u0902\u0926\u0935\u0932\u0947\u0932\u0947',paid:'\u092e\u093f\u0933\u093e\u0932\u0947\u0932\u0947',pending:'\u092c\u093e\u0915\u0940',viewAll:'\u0938\u0930\u094d\u0935 \u092a\u0939\u093e \u2192'},safety:{title:'\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947\u0902\u0926\u094d\u0930',subtitle:'\u0905\u0928\u094c\u092a\u091a\u093e\u0930\u093f\u0915 \u0915\u091a\u0930\u093e \u0935\u0947\u091a\u0915\u093e\u0902\u0938\u093e\u0920\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u093e\u0924\u093e\u0933\u0923\u0940 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915',centerTitle:'\u0915\u091a\u0930\u093e \u0935\u0947\u091a\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947\u0902\u0926\u094d\u0930',centerSubtitle:'\u0908-\u0915\u091a\u0930\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u093e\u0924\u093e\u0933\u0923\u0940\u0938\u093e\u0920\u0940 \u0938\u091a\u093f\u0924\u094d\u0930 \u0906\u0923\u093f \u0911\u0921\u093f\u0913 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915. \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927 \u0906\u0923\u093f \u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u092a\u094d\u0930\u0925\u092e.',whyDangerous:'\u0939\u0947 \u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u0915\u093e \u0906\u0939\u0947?',dontTitle:'\u0915\u093e\u092f \u0915\u0930\u0942 \u0928\u092f\u0947 (\u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u092a\u0926\u094d\u0927\u0924\u0940)',doTitle:'\u0915\u093e\u092f \u0915\u0930\u093e\u0935\u0947 (\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u0926\u094d\u0927\u0924\u0940)',speakGuide:'\u0939\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u093f\u0915\u093e \u0910\u0915\u093e',speakOverview:'\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u093e\u0930\u093e\u0902\u0936 \u0910\u0915\u093e',disclaimer:'\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915 \u0915\u0947\u0935\u0933 \u092e\u093e\u0939\u093f\u0924\u0940\u0938\u093e\u0920\u0940 \u0906\u0939\u0947. \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u0928\u093f\u092f\u092e \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930\u0926\u093e\u0930\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u0942\u091a\u0928\u093e\u0902\u091a\u0947 \u092a\u093e\u0932\u0928 \u0915\u0930\u093e. \u0927\u094b\u0915\u093e\u0926\u093e\u092f\u0915 \u0908-\u0915\u091a\u0930\u093e \u0938\u094d\u0935\u0924\u0903 \u0924\u094b\u0921\u0942 \u0928\u0915\u093e.',offlineNotice:'\u0911\u092b\u0932\u093e\u0907\u0928 \u092e\u094b\u0921: \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0915 \u0906\u092a\u0932\u094d\u092f\u093e \u092b\u094b\u0928\u0935\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947.',learnSafety:'\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0928\u093f\u092f\u092e \u0936\u093f\u0915\u093e',topics:{batteries:{title:'\u092c\u0945\u091f\u0930\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0916\u0930\u093e\u092c \u0935 \u091c\u0941\u0928\u094d\u092f\u093e \u092c\u0945\u091f\u0931\u094d\u092f\u093e\u0902\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u093e\u0924\u093e\u0933\u0923\u0940',warning:'\u092b\u0942\u091f\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u093f\u0902\u0935\u093e \u0917\u0930\u092e \u091d\u093e\u0932\u0947\u0932\u094d\u092f\u093e \u092c\u0945\u091f\u0931\u094d\u092f\u093e \u092a\u0947\u091f \u0918\u0947\u090a \u0936\u0915\u0924\u093e\u0924, \u0938\u094d\u092b\u094b\u091f \u0939\u094b\u090a \u0936\u0915\u0924\u094b \u0915\u093f\u0902\u0935\u093e \u0935\u093f\u0937\u093e\u0930\u0940 \u0930\u0938\u093e\u092f\u0928 \u0935\u093e\u0939\u0942 \u0936\u0915\u0924\u0947.',whyDangerous:'\u092c\u0945\u091f\u0931\u094d\u092f\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u0930\u093e\u0938\u093e\u092f\u0928\u093f\u0915 \u090a\u0930\u094d\u091c\u093e \u0938\u093e\u0920\u0935\u0932\u0947\u0932\u0940 \u0905\u0938\u0924\u0947. \u091b\u093f\u0926\u094d\u0930 \u092a\u093e\u0921\u0932\u094d\u092f\u093e\u0938, \u0926\u093e\u092c\u0932\u094d\u092f\u093e\u0938 \u0915\u093f\u0902\u0935\u093e \u0909\u0937\u094d\u0923\u0924\u093e \u0926\u093f\u0932\u094d\u092f\u093e\u0938 \u0924\u094d\u092f\u093e \u0935\u0947\u0917\u093e\u0928\u0947 \u092a\u0947\u091f \u0918\u0947\u090a \u0936\u0915\u0924\u093e\u0924 \u0915\u093f\u0902\u0935\u093e \u090d\u0938\u093f\u0921 \u0917\u0933\u0924\u0940 \u0939\u094b\u090a \u0936\u0915\u0924\u0947.',dont1:'\u092c\u0945\u091f\u0931\u094d\u092f\u093e\u0902\u0928\u093e \u0915\u0927\u0940\u0939\u0940 \u0915\u093e\u092a\u0942 \u0928\u0915\u093e, \u0924\u094b\u0921\u0942 \u0928\u0915\u093e, \u091a\u0947\u0902\u0926\u093e\u092e\u0947\u0902\u0926\u093e \u0915\u0930\u0942 \u0928\u0915\u093e \u0915\u093f\u0902\u0935\u093e \u091c\u093e\u0933\u0942 \u0928\u0915\u093e.',dont2:'\u0916\u0930\u093e\u092c \u0915\u093f\u0902\u0935\u093e \u092b\u0941\u0917\u0932\u0947\u0932\u094d\u092f\u093e \u092c\u0945\u091f\u0931\u094d\u092f\u093e \u0909\u0937\u094d\u0923\u0924\u093e, \u0925\u0947\u091f \u090a\u0928 \u0915\u093f\u0902\u0935\u093e \u0920\u093f\u0923\u0917\u094d\u092f\u093e\u0902\u091c\u0935\u0933 \u0920\u0947\u0935\u0942 \u0928\u0915\u093e.',dont3:'\u0917\u0933\u0924\u0940 \u0939\u094b\u0923\u093e\u0931\u094d\u092f\u093e \u092c\u0945\u091f\u0931\u094d\u092f\u093e \u0907\u0924\u0930 \u0927\u093e\u0924\u0942\u091a\u094d\u092f\u093e \u092d\u0902\u0917\u093e\u0930\u093e\u0924 \u090f\u0915\u0924\u094d\u0930 \u0920\u0947\u0935\u0942 \u0928\u0915\u093e.',do1:'\u092c\u0945\u091f\u0931\u094d\u092f\u093e \u0928 \u0909\u0918\u0921\u0924\u093e \u0915\u0947\u0935\u0933 \u092c\u093e\u0939\u0947\u0930\u0942\u0928 \u0924\u092a\u093e\u0938\u093e.',do2:'\u0916\u0930\u093e\u092c \u092c\u0945\u091f\u0931\u094d\u092f\u093e \u0915\u094b\u0930\u0921\u094d\u092f\u093e, \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915\u091a\u094d\u092f\u093e \u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0921\u092c\u094d\u092f\u093e\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u0947\u0935\u093e.',do3:'\u0938\u0930\u094d\u0935 \u092c\u0945\u091f\u0931\u094d\u092f\u093e \u0925\u0947\u091f \u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u0902\u0915\u0932\u0928 \u0915\u0947\u0902\u0926\u094d\u0930 \u0915\u093f\u0902\u0935\u093e \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930\u0926\u093e\u0930\u093e\u0915\u0921\u0947 \u0938\u094b\u092a\u0935\u093e.'},crts:{title:'\u0938\u0940\u0906\u0930\u091f\u0940 \u092e\u0949\u0928\u093f\u091f\u0930 \u0935 \u091f\u0940\u0935\u094d\u0939\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u092a\u093f\u0915\u094d\u091a\u0930 \u091f\u094d\u092f\u0942\u092c\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u093e\u0924\u093e\u0933\u0923\u0940',warning:'\u0938\u0940\u0906\u0930\u091f\u0940 \u0915\u093e\u091a\u0947\u091a\u094d\u092f\u093e \u091f\u094d\u092f\u0942\u092c\u092e\u0927\u094d\u092f\u0947 \u0935\u094d\u0939\u0945\u0915\u094d\u092f\u0942\u092e \u0905\u0938\u0924\u094b, \u0924\u0940 \u092b\u0941\u091f\u0932\u094d\u092f\u093e\u0938 \u0915\u093e\u091a\u0947\u091a\u0947 \u0924\u0941\u0915\u0921\u0947 \u0935\u0947\u0917\u093e\u0928\u0947 \u0909\u0921\u0924\u093e\u0924.',whyDangerous:'\u0938\u0940\u0906\u0930\u091f\u0940 \u092a\u093f\u0915\u094d\u091a\u0930 \u091f\u094d\u092f\u0942\u092c\u092e\u0927\u094d\u092f\u0947 \u0905\u0902\u0924\u0930\u094d\u0917\u0924 \u092a\u094b\u0915\u0933\u0940 \u0906\u0923\u093f \u0918\u093e\u0924\u0915 \u0936\u093f\u0938\u0947 (\u0932\u0947\u0921) \u0905\u0938\u0924\u0947. \u0939\u093e\u0924\u094b\u0921\u094d\u092f\u093e\u0928\u0947 \u092b\u094b\u0921\u0932\u094d\u092f\u093e\u0938 \u0915\u093e\u091a \u0906\u0924 \u0916\u0947\u091a\u0932\u0940 \u091c\u093e\u090a\u0928 \u0935\u0947\u0917\u093e\u0928\u0947 \u0909\u0921\u0924\u0947 \u0935 \u0917\u0902\u092d\u0940\u0930 \u0907\u091c\u093e \u0915\u0930\u0924\u0947.',dont1:'\u0938\u0940\u0906\u0930\u091f\u0940 \u092a\u093f\u0915\u094d\u091a\u0930 \u091f\u094d\u092f\u0942\u092c \u0915\u0927\u0940\u0939\u0940 \u0939\u093e\u0924\u094b\u0921\u094d\u092f\u093e\u0928\u0947 \u092b\u094b\u0921\u0942 \u0928\u0915\u093e.',dont2:'\u0938\u0940\u0906\u0930\u091f\u0940 \u092c\u0949\u0921\u0940, \u0915\u0949\u0907\u0932\u094d\u0938 \u0915\u093f\u0902\u0935\u093e \u0906\u0924\u0940\u0932 \u092d\u093e\u0917 \u0906\u0917\u0940\u0924 \u091c\u093e\u0933\u0942 \u0928\u0915\u093e.',dont3:'\u0918\u0930\u0940 \u0915\u093f\u0902\u0935\u093e \u0926\u0941\u0915\u093e\u0928\u093e\u0924 \u0938\u0940\u0906\u0930\u091f\u0940\u092e\u0927\u0942\u0928 \u0927\u093e\u0924\u0942 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u0942 \u0928\u0915\u093e.',do1:'\u092e\u0949\u0928\u093f\u091f\u0930 \u0906\u0923\u093f \u091f\u0940\u0935\u094d\u0939\u0940 \u0936\u0915\u094d\u092f\u0924\u094b \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u092c\u0949\u0921\u0940\u0938\u0939 \u0905\u0916\u0902\u0921 \u0920\u0947\u0935\u093e.',do2:'\u092a\u093f\u0915\u094d\u091a\u0930 \u091f\u094d\u092f\u0942\u092c \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0909\u091a\u0932\u093e \u0906\u0923\u093f \u0915\u093e\u091a\u0947\u091a\u094d\u092f\u093e \u0938\u092e\u094b\u0930\u0940\u0932 \u092d\u093e\u0917\u093e\u0932\u093e \u0927\u0915\u094d\u0915\u094d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 \u0935\u093e\u091a\u0935\u093e.',do3:'\u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0938\u0940\u0906\u0930\u091f\u0940 \u092f\u0941\u0928\u093f\u091f \u0905\u0927\u093f\u0915\u0943\u0924 \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0915\u0921\u0947 \u0938\u094b\u092a\u0935\u093e.'},pcbs:{title:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 (\u092a\u0940\u0938\u0940\u092c\u0940) \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u093e\u0924\u093e\u0933\u0923\u0940',warning:'\u092c\u094b\u0930\u094d\u0921 \u091c\u093e\u0933\u0932\u094d\u092f\u093e\u0928\u0947 \u0915\u093f\u0902\u0935\u093e \u090d\u0938\u093f\u0921\u092e\u0927\u094d\u092f\u0947 \u0927\u0941\u0924\u0932\u094d\u092f\u093e\u0928\u0947 \u091c\u0940\u0935\u0918\u0947\u0923\u093e \u0935\u093f\u0937\u093e\u0930\u0940 \u0927\u0942\u0930 \u0928\u093f\u0918\u0924\u094b.',whyDangerous:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921\u092e\u0927\u094d\u092f\u0947 \u0930\u093e\u0933, \u0938\u094b\u0932\u094d\u0921\u0930 \u0906\u0923\u093f \u0936\u093f\u0938\u0947 \u0905\u0938\u0924\u0947. \u0906\u0917\u0940\u0935\u0930 \u0917\u0930\u092e \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0915\u093f\u0902\u0935\u093e \u090d\u0938\u093f\u0921 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0947\u0932\u094d\u092f\u093e\u0928\u0947 \u0935\u093f\u0937\u093e\u0930\u0940 \u0935\u093e\u092f\u0942 \u092c\u093e\u0939\u0947\u0930 \u092a\u0921\u0924\u093e\u0924 \u091c\u0947 \u092b\u0941\u092a\u094d\u092b\u0941\u0938\u093e\u0902\u0928\u093e \u0939\u093e\u0928\u0940 \u092a\u094b\u0939\u094b\u091a\u0935\u0924\u093e\u0924.',dont1:'\u090d\u0938\u093f\u0921\u0928\u0947 \u0927\u0941\u0923\u0947 \u0915\u093f\u0902\u0935\u093e \u0930\u093e\u0938\u093e\u092f\u0928\u093f\u0915 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u0942 \u0928\u0915\u093e.',dont2:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 \u0906\u0917\u0940\u0924 \u0915\u0927\u0940\u0939\u0940 \u091c\u093e\u0933\u0942 \u0928\u0915\u093e.',dont3:'\u0909\u0918\u0921\u094d\u092f\u093e \u0906\u0917\u0940\u0935\u0930 \u0938\u0941\u091f\u0947 \u092d\u093e\u0917 \u0935\u093f\u0924\u0933\u0935\u0942\u0928 \u0915\u093e\u0922\u0942 \u0928\u0915\u093e \u0935 \u0927\u0942\u0930\u093e\u0924 \u0936\u094d\u0935\u093e\u0938 \u0918\u0947\u090a \u0928\u0915\u093e.',do1:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 \u0928 \u0924\u094b\u0921\u0924\u093e, \u0905\u0916\u0902\u0921 \u0906\u0923\u093f \u0915\u094b\u0930\u0921\u0947 \u0917\u094b\u0933\u093e \u0915\u0930\u093e.',do2:'\u092a\u0940\u0938\u0940\u092c\u0940 \u0938\u094d\u0935\u091a\u094d\u091b \u092a\u094b\u0924\u094d\u092f\u093e\u0924 \u0915\u093f\u0902\u0935\u093e \u0916\u094b\u0915\u094d\u092f\u093e\u0924 \u0932\u0939\u093e\u0928 \u092e\u0941\u0932\u0947 \u0906\u0923\u093f \u0905\u0928\u094d\u0928\u093e\u092a\u093e\u0938\u0942\u0928 \u0932\u093e\u0902\u092c \u0920\u0947\u0935\u093e.',do3:'\u0938\u0930\u094d\u0915\u093f\u091f \u092c\u094b\u0930\u094d\u0921 \u0925\u0947\u091f \u0905\u0927\u093f\u0915\u0943\u0924 \u0908-\u0915\u091a\u0930\u093e \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930\u0926\u093e\u0930\u093e\u0932\u093e \u0935\u093f\u0915\u093e.'},cables:{title:'\u0915\u0947\u092c\u0932 \u0906\u0923\u093f \u0935\u093e\u092f\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0924\u093e\u0902\u092c\u0947 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092f\u0930 \u091c\u093e\u0933\u0923\u0947 \u091f\u093e\u0933\u093e',warning:'\u0924\u093e\u0902\u092c\u0947 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092f\u0930\u094d\u0938 \u0915\u0927\u0940\u0939\u0940 \u091c\u093e\u0933\u0942 \u0928\u0915\u093e. \u0915\u0947\u092c\u0932\u091a\u093e \u0927\u0942\u0930 \u0905\u0924\u094d\u092f\u0902\u0924 \u0935\u093f\u0937\u093e\u0930\u0940 \u0905\u0938\u0924\u094b.',whyDangerous:'\u0915\u0947\u092c\u0932\u091a\u0947 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u091c\u0933\u0924\u093e\u0928\u093e \u0905\u0924\u093f\u0936\u092f \u0935\u093f\u0937\u093e\u0930\u0940 \u0921\u093e\u092f\u0911\u0915\u094d\u0938\u093f\u0928 \u0927\u0942\u0930 \u0938\u094b\u0921\u0924\u0947. \u0939\u093e \u0927\u0942\u0930 \u0936\u094d\u0935\u093e\u0938\u093e\u0935\u093e\u091f\u0947 \u0906\u0924 \u0917\u0947\u0932\u094d\u092f\u093e\u0938 \u092b\u0941\u092a\u094d\u092b\u0941\u0938\u093e\u0902\u0928\u093e \u0917\u0902\u092d\u0940\u0930 \u0907\u091c\u093e \u0939\u094b\u0924\u0947 \u0906\u0923\u093f \u0939\u0935\u093e \u092a\u094d\u0930\u0926\u0942\u0937\u093f\u0924 \u0939\u094b\u0924\u0947.',dont1:'\u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0935\u093f\u0924\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0935\u093e\u092f\u0930\u094d\u0938 \u0915\u093f\u0902\u0935\u093e \u0915\u0947\u092c\u0932\u094d\u0938 \u0906\u0917\u0940\u0924 \u091c\u093e\u0933\u0942 \u0928\u0915\u093e.',dont2:'\u0909\u0918\u0921\u094d\u092f\u093e \u0906\u091a\u0947\u0935\u0930 \u0915\u093f\u0902\u0935\u093e \u0939\u0940\u091f\u0930\u0928\u0947 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0915\u093e\u0922\u0942 \u0928\u0915\u093e.',dont3:'\u0935\u093e\u092f\u0930 \u091c\u0933\u0924\u093e\u0928\u093e \u0928\u093f\u0918\u0923\u093e\u0931\u094d\u092f\u093e \u0927\u0942\u0930\u093e\u091a\u094d\u092f\u093e \u0938\u0902\u092a\u0930\u094d\u0915\u093e\u0924 \u092f\u0947\u090a \u0928\u0915\u093e.',do1:'\u0915\u0947\u092c\u0932\u094d\u0938 \u0928 \u091c\u093e\u0933\u0924\u093e, \u0905\u0916\u0902\u0921 \u0906\u0923\u093f \u0915\u094b\u0930\u0921\u094d\u092f\u093e \u0917\u094b\u0933\u093e \u0915\u0930\u093e.',do2:'\u0935\u093e\u092f\u0930\u094d\u0938 \u0928\u0940\u091f \u0917\u0941\u0902\u0921\u093e\u0933\u0942\u0928 \u092c\u0902\u0921\u0932 \u092c\u0928\u0935\u093e \u091c\u0947\u0923\u0947\u0915\u0930\u0942\u0928 \u0928\u0947-\u0906\u0923 \u0915\u0930\u0923\u0947 \u0938\u094b\u092a\u0947 \u0939\u094b\u0908\u0932.',do3:'\u0935\u093e\u092f\u0930\u094d\u0938 \u0905\u0927\u093f\u0915\u0943\u0924 \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930\u0926\u093e\u0930\u093e\u0932\u093e \u0926\u094d\u092f\u093e \u091c\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092f\u0902\u0924\u094d\u0930\u093e\u0902\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0935\u0947\u0917\u0933\u0947 \u0915\u0930\u0924\u093e\u0924.'},lcds:{title:'\u090f\u0932\u0938\u0940\u0921\u0940 \u0935 \u090f\u0932\u0908\u0921\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0935 \u092c\u0945\u0915\u0932\u093e\u0907\u091f\u091a\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u093e\u0924\u093e\u0933\u0923\u0940',warning:'\u091c\u0941\u0928\u094d\u092f\u093e \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u091a\u094d\u092f\u093e \u092c\u0945\u0915\u0932\u093e\u0907\u091f\u092e\u0927\u094d\u092f\u0947 \u092a\u093e\u0930\u093e \u0905\u0938\u0924\u094b; \u092b\u0941\u091f\u0932\u0947\u0932\u0940 \u0915\u093e\u091a \u0905\u0924\u094d\u092f\u0902\u0924 \u091f\u094b\u0915\u0926\u093e\u0930 \u0905\u0938\u0924\u0947.',whyDangerous:'\u091c\u0941\u0928\u094d\u092f\u093e \u090f\u0932\u0938\u0940\u0921\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u092e\u0927\u094d\u092f\u0947 \u092a\u093e\u0931\u094d\u092f\u093e\u091a\u0940 \u0935\u093e\u092b \u0905\u0938\u0932\u0947\u0932\u0947 \u0926\u093f\u0935\u0947 \u0905\u0938\u0924\u093e\u0924. \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092b\u0941\u091f\u0932\u094d\u092f\u093e\u0938 \u092a\u093e\u0930\u093e \u0939\u0935\u0947\u0924 \u092a\u0938\u0930\u0924\u094b \u0906\u0923\u093f \u0939\u093e\u0924\u093e\u0932\u093e \u0924\u0940\u0915\u094d\u0937\u094d\u0923 \u0915\u093e\u091a \u0932\u093e\u0917\u0942 \u0936\u0915\u0924\u0947.',dont1:'\u090f\u0932\u0938\u0940\u0921\u0940 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u0927\u0940\u0939\u0940 \u0906\u092a\u091f\u0942 \u0928\u0915\u093e \u0915\u093f\u0902\u0935\u093e \u092b\u094b\u0921\u0942 \u0928\u0915\u093e.',dont2:'\u0938\u094d\u0915\u094d\u0930\u0940\u0928\u091a\u093e \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u092b\u094d\u0930\u0947\u092e \u0915\u093f\u0902\u0935\u093e \u092d\u093e\u0917 \u0906\u0917\u0940\u0924 \u091c\u093e\u0933\u0942 \u0928\u0915\u093e.',dont3:'\u092c\u0945\u0915\u0932\u093e\u0907\u091f \u091f\u094d\u092f\u0942\u092c \u0939\u093e\u0924\u093e\u0928\u0947 \u0909\u0918\u0921\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u092f\u0924\u094d\u0928 \u0915\u0930\u0942 \u0928\u0915\u093e.',do1:'\u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0915\u093e\u0933\u091c\u0940\u092a\u0942\u0930\u094d\u0935\u0915 \u0927\u0930\u093e \u0906\u0923\u093f \u0928\u0947\u0924\u093e\u0928\u093e \u0938\u0930\u0933 \u0909\u092d\u0940 \u0920\u0947\u0935\u093e.',do2:'\u0938\u094d\u0915\u094d\u0930\u0940\u0928\u091a\u094d\u092f\u093e \u092a\u0943\u0937\u094d\u0920\u092d\u093e\u0917\u093e\u0932\u093e \u091f\u094b\u0915\u0926\u093e\u0930 \u0935\u0938\u094d\u0924\u0942\u0902\u092a\u093e\u0938\u0942\u0928 \u0906\u0923\u093f \u0926\u093e\u092c\u093e\u092a\u093e\u0938\u0942\u0928 \u0935\u093e\u091a\u0935\u093e.',do3:'\u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0905\u0927\u093f\u0915\u0943\u0924 \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093e\u0915\u0921\u0947 \u0938\u094b\u092a\u0935\u093e.'},general:{title:'\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0908-\u0915\u091a\u0930\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0938\u0930\u094d\u0935 \u092a\u094d\u0930\u0915\u093e\u0930\u091a\u094d\u092f\u093e \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u092d\u0902\u0917\u093e\u0930\u093e\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0915\u093e\u0933\u091c\u0940',warning:'\u0908-\u0915\u091a\u0931\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u0905\u0928\u0947\u0915 \u0918\u093e\u0924\u0915 \u0918\u091f\u0915 \u0905\u0938\u0924\u093e\u0924. \u0924\u094b \u0915\u0927\u0940\u0939\u0940 \u091c\u093e\u0933\u0942 \u0928\u0915\u093e, \u092b\u094b\u0921\u0942 \u0928\u0915\u093e \u0915\u093f\u0902\u0935\u093e \u0909\u0918\u0921\u094d\u092f\u093e\u0935\u0930 \u091f\u093e\u0915\u0942 \u0928\u0915\u093e.',whyDangerous:'\u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915 \u0909\u092a\u0915\u0930\u0923\u093e\u0902\u092e\u0927\u094d\u092f\u0947 \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915, \u0927\u093e\u0924\u0942 \u0906\u0923\u093f \u0918\u093e\u0924\u0915 \u0930\u0938\u093e\u092f\u0928\u0947 \u0905\u0938\u0924\u093e\u0924. \u091a\u0941\u0915\u0940\u091a\u094d\u092f\u093e \u092a\u0926\u094d\u0927\u0924\u0940\u0928\u0947 \u0924\u094b\u0921\u0932\u094d\u092f\u093e\u0938 \u0935\u093f\u0937\u093e\u0930\u0940 \u0927\u0942\u0933 \u092a\u0938\u0930\u0924\u0947 \u0906\u0923\u093f \u092e\u093e\u0924\u0940 \u0935 \u092a\u093e\u0923\u0940 \u0926\u0942\u0937\u093f\u0924 \u0939\u094b\u0924\u0947.',dont1:'\u0908-\u0915\u091a\u0930\u093e \u0909\u0918\u0921\u094d\u092f\u093e\u0935\u0930 \u091c\u093e\u0933\u0942 \u0928\u0915\u093e \u0915\u093f\u0902\u0935\u093e \u0928\u093e\u0932\u094d\u092f\u093e\u0924 \u0935 \u0930\u093f\u0915\u093e\u092e\u094d\u092f\u093e \u092e\u0948\u0926\u093e\u0928\u093e\u0924 \u091f\u093e\u0915\u0942 \u0928\u0915\u093e.',dont2:'\u0939\u093e\u0924\u094b\u0921\u094d\u092f\u093e\u0928\u0947 \u0909\u092a\u0915\u0930\u0923\u0947 \u0905\u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924\u092a\u0923\u0947 \u0924\u094b\u0921\u0942 \u0928\u0915\u093e.',dont3:'\u092c\u0945\u091f\u0930\u0940 \u0906\u0923\u093f \u0935\u093f\u0937\u093e\u0930\u0940 \u0918\u091f\u0915 \u0938\u093e\u0927\u094d\u092f\u093e \u0932\u094b\u0916\u0902\u0921-\u0924\u093e\u0902\u092c\u094d\u092f\u093e\u091a\u094d\u092f\u093e \u092d\u0902\u0917\u093e\u0930\u093e\u0924 \u092e\u093f\u0938\u0933\u0942 \u0928\u0915\u093e.',do1:'\u0908-\u0915\u091a\u0930\u093e \u0935\u093f\u0935\u093f\u0927 \u092a\u094d\u0930\u0915\u093e\u0930\u093e\u0902\u092e\u0927\u094d\u092f\u0947 (\u092c\u0945\u091f\u0930\u0940, \u092c\u094b\u0930\u094d\u0921, \u0935\u093e\u092f\u0930, \u0909\u092a\u0915\u0930\u0923\u0947) \u0935\u0947\u0917\u0933\u093e \u0920\u0947\u0935\u093e.',do2:'\u0915\u091a\u0930\u093e \u091c\u092e\u093f\u0928\u0940\u092a\u093e\u0938\u0942\u0928 \u0935\u0930, \u0915\u094b\u0930\u0921\u094d\u092f\u093e \u0906\u0923\u093f \u0906\u0921\u094b\u0936\u093e\u091a\u094d\u092f\u093e \u091c\u093e\u0917\u0940 \u0920\u0947\u0935\u093e.',do3:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0935\u093f\u0932\u094d\u0939\u0947\u0935\u093e\u091f\u0940\u0938\u093e\u0920\u0940 \u0915\u0947\u0935\u0933 \u0905\u0927\u093f\u0915\u0943\u0924 \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930\u0926\u093e\u0930\u093e\u0902\u0936\u0940\u091a \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0930\u093e.'},storage:{title:'\u0938\u093e\u0920\u0935\u0923\u0942\u0915 \u0906\u0923\u093f \u0935\u093e\u0939\u0924\u0942\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',subtitle:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0925\u092a\u094d\u092a\u0940, \u092a\u093e\u0935\u0938\u093e\u092a\u093e\u0938\u0942\u0928 \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u0906\u0923\u093f \u0935\u093e\u0939\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',warning:'\u0909\u0902\u091a \u0925\u092a\u094d\u092a\u0940 \u0915\u094b\u0938\u0933\u0932\u094d\u092f\u093e\u0938 \u0907\u091c\u093e \u0939\u094b\u090a \u0936\u0915\u0924\u0947; \u0913\u0932\u093e \u0915\u091a\u0930\u093e \u0906\u0923\u093f \u0926\u092c\u0932\u0947\u0932\u0940 \u092c\u0945\u091f\u0930\u0940 \u0906\u0917 \u0932\u093e\u0935\u0942 \u0936\u0915\u0924\u0947.',whyDangerous:'\u091c\u0921 \u0909\u092a\u0915\u0930\u0923\u093e\u0902\u091a\u0947 \u0905\u0938\u094d\u0925\u093f\u0930 \u0922\u0940\u0917 \u0915\u094b\u0938\u0933\u0942 \u0936\u0915\u0924\u093e\u0924. \u092a\u093e\u0923\u0940 \u0932\u093e\u0917\u0932\u094d\u092f\u093e\u0938 \u092c\u0945\u091f\u0930\u0940\u092e\u0927\u094d\u092f\u0947 \u0936\u0949\u0930\u094d\u091f \u0938\u0930\u094d\u0915\u093f\u091f \u0939\u094b\u090a \u0936\u0915\u0924\u0947 \u0906\u0923\u093f \u0935\u093e\u0939\u0928\u093e\u0924\u0942\u0928 \u0915\u091a\u0930\u093e \u092a\u0921\u0942\u0928 \u0905\u092a\u0918\u093e\u0924 \u0939\u094b\u090a \u0936\u0915\u0924\u094b.',dont1:'\u092e\u091c\u092c\u0942\u0924 \u0906\u0927\u093e\u0930\u093e\u0936\u093f\u0935\u093e\u092f \u091c\u0921 \u092e\u0949\u0928\u093f\u091f\u0930 \u0915\u093f\u0902\u0935\u093e \u0909\u092a\u0915\u0930\u0923\u093e\u0902\u091a\u093e \u0909\u0902\u091a \u0922\u0940\u0917 \u0932\u093e\u0935\u0942 \u0928\u0915\u093e.',dont2:'\u0908-\u0915\u091a\u0930\u093e \u092a\u093e\u0935\u0938\u093e\u0924 \u0909\u0918\u0921\u094d\u092f\u093e\u0935\u0930 \u0915\u093f\u0902\u0935\u093e \u0936\u0947\u0915\u094b\u091f\u0940/\u091a\u0941\u0932\u0940\u091c\u0935\u0933 \u0920\u0947\u0935\u0942 \u0928\u0915\u093e.',dont3:'\u0930\u093f\u0915\u094d\u0937\u093e, \u0939\u093e\u0924\u0917\u093e\u0921\u0940 \u0915\u093f\u0902\u0935\u093e \u0926\u0941\u091a\u093e\u0915\u0940\u0935\u0930 \u092d\u0902\u0917\u093e\u0930 \u0926\u094b\u0930\u0940\u0928\u0947 \u0928 \u092c\u093e\u0902\u0927\u0924\u093e \u0935\u093e\u0939\u0942\u0928 \u0928\u0947\u090a \u0928\u0915\u093e.',do1:'\u0908-\u0915\u091a\u0930\u093e \u0915\u094b\u0930\u0921\u094d\u092f\u093e, \u0939\u0935\u0947\u0936\u0940\u0930 \u0906\u0923\u093f \u092a\u093e\u0935\u0938\u093e\u092a\u093e\u0938\u0942\u0928 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u093f\u0915\u093e\u0923\u0940 \u0920\u0947\u0935\u093e.',do2:'\u0916\u0930\u093e\u092c \u0915\u093f\u0902\u0935\u093e \u0917\u0933\u0924\u0940 \u0939\u094b\u0923\u093e\u0931\u094d\u092f\u093e \u092c\u0945\u091f\u0931\u094d\u092f\u093e \u0935\u0947\u0917\u0933\u094d\u092f\u093e \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0921\u092c\u094d\u092f\u093e\u0924 \u0920\u0947\u0935\u093e.',do3:'\u0935\u093e\u0939\u0928\u093e\u0935\u0930 \u0938\u093e\u092e\u093e\u0928 \u0918\u091f\u094d\u091f \u092c\u093e\u0902\u0927\u093e \u0906\u0923\u093f \u091c\u0921 \u0938\u093e\u092e\u093e\u0928 \u0909\u091a\u0932\u0924\u093e\u0928\u093e \u0917\u0941\u0921\u0918\u0947 \u0935\u093e\u0915\u0935\u0942\u0928 \u0909\u091a\u0932\u093e.'},ppe:{title:'\u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u093e\u0927\u0928\u0947 (\u092a\u0940\u092a\u0940\u0908)',subtitle:'\u092d\u0902\u0917\u093e\u0930 \u0917\u094b\u0933\u093e \u0915\u0930\u0924\u093e\u0928\u093e \u0938\u094d\u0935\u0924\u0903\u091a\u094d\u092f\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u0923\u093e\u0938\u093e\u0920\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0938\u093e\u0927\u0928\u0947',warning:'\u0939\u093e\u0924\u092e\u094b\u091c\u0947 \u0906\u0923\u093f \u092c\u0942\u091f \u091c\u0916\u092e\u093e \u0939\u094b\u0923\u094d\u092f\u093e\u092a\u093e\u0938\u0942\u0928 \u0935\u093e\u091a\u0935\u0924\u093e\u0924. \u092a\u0940\u092a\u0940\u0908 \u0915\u091a\u0930\u093e \u091c\u093e\u0933\u0923\u0947 \u0915\u093f\u0902\u0935\u093e \u090d\u0938\u093f\u0921 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0930\u0924 \u0928\u093e\u0939\u0940.',whyDangerous:'\u0924\u0941\u091f\u0932\u0947\u0932\u0947 \u0907\u0932\u0947\u0915\u094d\u091f\u094d\u0930\u0949\u0928\u093f\u0915\u094d\u0938 \u0939\u093e\u0924\u093e\u0933\u0924\u093e\u0928\u093e \u0939\u093e\u0924 \u0915\u093e\u092a\u0923\u094d\u092f\u093e\u091a\u093e, \u0915\u093e\u091a \u091f\u094b\u091a\u0923\u094d\u092f\u093e\u091a\u093e \u0906\u0923\u093f \u0939\u093e\u0924\u093e\u0935\u0930 \u0935\u093f\u0937\u093e\u0930\u0940 \u0927\u0942\u0933 \u0932\u093e\u0917\u0923\u094d\u092f\u093e\u091a\u093e \u0927\u094b\u0915\u093e \u0905\u0938\u0924\u094b.',dont1:'\u092b\u0942\u091f\u0932\u0947\u0932\u0940 \u0915\u093e\u091a, \u0909\u0918\u0921\u094d\u092f\u093e \u0935\u093e\u092f\u0930\u094d\u0938 \u0915\u093f\u0902\u0935\u093e \u091f\u094b\u0915\u0926\u093e\u0930 \u0927\u093e\u0924\u0942 \u0909\u0918\u0921\u094d\u092f\u093e \u0939\u093e\u0924\u093e\u0902\u0928\u0940 \u0939\u093e\u0924\u093e\u0933\u0942 \u0928\u0915\u093e.',dont2:'\u092d\u0902\u0917\u093e\u0930 \u0939\u093e\u0924\u093e\u0933\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0939\u093e\u0924 \u0928 \u0927\u0941\u0924\u093e \u091c\u0947\u0935\u0923 \u0915\u0930\u0942 \u0928\u0915\u093e \u0906\u0923\u093f \u092a\u093e\u0923\u0940 \u092a\u093f\u090a \u0928\u0915\u093e.',dont3:'\u0939\u093e\u0924\u092e\u094b\u091c\u0947 \u0918\u093e\u0924\u0932\u0947 \u0924\u0930\u0940 \u0915\u091a\u0930\u093e \u091c\u093e\u0933\u0923\u0947 \u0915\u093f\u0902\u0935\u093e \u090d\u0938\u093f\u0921 \u0935\u093e\u092a\u0930\u0923\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u0938\u0924\u0947 \u2014 \u091c\u093e\u0933\u0923\u0947 \u0915\u0927\u0940\u0939\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0928\u093e\u0939\u0940.',do1:'\u092d\u0902\u0917\u093e\u0930 \u0909\u091a\u0932\u0924\u093e\u0928\u093e \u0906\u0923\u093f \u0935\u0947\u0917\u0933\u0947 \u0915\u0930\u0924\u093e\u0928\u093e \u091c\u093e\u0921 \u092e\u091c\u092c\u0942\u0924 \u0939\u093e\u0924\u092e\u094b\u091c\u0947 \u0935\u093e\u092a\u0930\u093e.',do2:'\u092a\u093e\u092f\u093e\u0924 \u092c\u0902\u0926 \u092c\u0942\u091f \u0918\u093e\u0932\u093e \u0906\u0923\u093f \u0921\u094b\u0933\u094d\u092f\u093e\u0902\u091a\u094d\u092f\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u0923\u093e\u0938\u093e\u0920\u0940 \u091a\u0937\u094d\u092e\u093e \u0935\u093e\u092a\u0930\u093e.',do3:'\u0915\u093e\u092e \u0938\u0902\u092a\u0932\u094d\u092f\u093e\u0928\u0902\u0924\u0930 \u0939\u093e\u0924 \u0938\u093e\u092c\u0923 \u0906\u0923\u093f \u092a\u093e\u0923\u094d\u092f\u093e\u0928\u0947 \u0938\u094d\u0935\u091a\u094d\u091b \u0927\u0941\u0935\u093e.'}}},recyclerDirectory:{title:'\u0930\u0940\u0938\u093e\u092f\u0915\u0932 \u0915\u0947\u0902\u0926\u094d\u0930 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e',subtitle:'\u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0906\u0923\u093f \u0972\u0917\u094d\u0930\u0940\u0917\u0947\u091f\u0930 \u0936\u094b\u0927\u093e',openDirectory:'\u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0936\u094b\u0927\u093e',searchPlaceholder:'\u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930\u091a\u0947 \u0928\u093e\u0935, \u0936\u0939\u0930 \u0915\u093f\u0902\u0935\u093e \u0938\u093e\u0939\u093f\u0924\u094d\u092f \u0936\u094b\u0927\u093e...',statusAuthorized:'\u0905\u0927\u093f\u0915\u0943\u0924',statusProvisional:'\u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u0947 \u0905\u0927\u093f\u0915\u0943\u0924',statusPending:'\u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924',statusSuspended:'\u0928\u093f\u0932\u0902\u092c\u093f\u0924',statusRejected:'\u0928\u093e\u0915\u093e\u0930\u0932\u0947',statusExpired:'\u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f / \u0915\u093e\u0932\u092c\u093e\u0939\u094d\u092f',statusInactive:'\u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f',statusUnavailable:'\u092a\u094d\u0930\u093e\u0927\u093f\u0915\u0930\u0923 \u0938\u094d\u0925\u093f\u0924\u0940 \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927',authorizedDesc:'\u0938\u0915\u094d\u0930\u0