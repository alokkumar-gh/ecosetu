ector Confirmed",recyclerConfirmed:"Recycler Confirmed",handoverConfirmed:"Handover Confirmed",statusPendingRecycler:"Pending Recycler Confirmation",statusPendingCollector:"Pending Collector Confirmation",cancelled:"Cancelled",offline:"Offline",cached:"Cached",cachedReceiptNotice:"Viewing cached handover receipt. Connect to internet for live verification.",connectToInternet:"Connect to internet to complete digital handover.",paymentNotConfirmed:"Payment not confirmed",recyclingNotConfirmed:"Recycling not confirmed",legalDisclaimer:"This digital handover record verifies physical custody transfer only. It does not certify payment completion or recycling completion.",enterConfirmedWeight:"Enter confirmed scale weight (kg)",notes:"Handover Notes",notesPlaceholder:"Enter any condition notes or scale remarks",speakDetails:"Speak Details",receiptTitle:"ECOSETU DIGITAL HANDOVER RECEIPT",transferStatus:"Transfer Status",bothPartiesConfirmed:"Both parties have digitally confirmed the material transfer.",waitingRecycler:"Awaiting authorized recycler confirmation.",waitingCollector:"Awaiting collector handover initiation.",noPhotos:"No photos attached",handoverCreatedSuccess:"Digital handover initiated successfully.",handoverConfirmedSuccess:"Material handover confirmed successfully.",invalidWeightTitle:"Invalid Weight",invalidWeightMsg:"Please enter a valid scale weight greater than 0 kg.",missingParamsMsg:"Missing required handover parameters. Please return to lot details."},transaction:{title:"Transactions",recordSale:"Record Sale / Payment",transactionDetails:"Transaction Details",referenceNumber:"Transaction Reference",finalSaleValue:"Final Sale Value",paymentMethod:"Payment Method",paymentStatus:"Payment Status",amountPaid:"Amount Paid",amountDue:"Amount Due",quotedRate:"Quoted Rate",quotedTotal:"Quoted Total",finalRate:"Final Rate",variance:"Variance vs Quote",cash:"Cash",upi:"UPI",bankTransfer:"Bank Transfer",paid:"Paid in Full",partiallyPaid:"Partially Paid",pending:"Pending",disclaimerCash:"Recording only \u2014 ECOSETU does not transfer money. Cash payment recorded by user.",disclaimerDigital:"Recording only \u2014 ECOSETU does not transfer money. Payment method recorded by user; payment is not processed or verified by ECOSETU.",disclaimerGeneral:"Recording only \u2014 ECOSETU does not transfer money.",notes:"Transaction Notes",saveTransaction:"Record Transaction",noTransactions:"No transactions recorded yet",speakSummary:"Speak Summary",offlineNotice:"Offline Mode: Displaying cached transactions.",onlineRequired:"Transaction recording requires an active internet connection.",loadingHandover:"Loading handover details...",alreadyRecordedTitle:"Sale Already Recorded",alreadyRecordedDesc:"This handover has already been recorded in your transactions ledger.",viewTransactionDetails:"View Transaction Details",handoverNotFound:"Handover details could not be found.",commercialTerms:"Commercial Terms",buyerRecycler:"Buyer / Recycler",confirmedWeight:"Confirmed Weight",agreedQuotedTotal:"Agreed Quoted Total",finalSaleValueLabel:"Final Sale Value (\u20b9)",finalSaleValueHint:"Enter final agreed amount. Change only if scale weight or terms changed.",varianceMatches:"Matches agreed quotation amount exactly.",paymentMethodTitle:"Payment Method Received",paymentStatusTitle:"Payment Settlement Status",amountReceivedSoFar:"Amount Received So Far (\u20b9)",remainingBalanceDue:"Remaining Balance Due (\u20b9)",notesOptional:"Notes (Optional)",notesPlaceholder:"Enter transaction reference, slip no., or payment notes...",recordTransactionBtn:"Record Sale in Ledger",invalidSaleAmountTitle:"Invalid Sale Amount",invalidSaleAmountMsg:"Please enter a valid final sale amount greater than 0.",invalidPaidAmountMsg:"Paid amount cannot be negative or exceed the total sale value.",offlineWarning:"You are offline. Transactions can only be recorded when connected to the internet."},earnings:{title:"Earnings Ledger",salesRecorded:"Sales Recorded",moneyReceived:"Money Received",moneyPending:"Money Pending",transactionsCount:"Transactions",pendingDuesTitle:"Pending Dues",noPendingDues:"No Pending Dues",noPendingDuesDesc:"All your recorded transactions have been fully settled.",monthlyBreakdown:"Monthly Breakdown",noMonthlyData:"No monthly earnings recorded yet",allTransactions:"Transaction History",viewEarnings:"View Earnings",speakSummary:"Speak Summary",offlineNotice:"Offline \u2014 showing cached earnings",oldestFirstNotice:"Showing oldest dues first",periodAllTime:"All Time",periodThisMonth:"This Month",periodLastMonth:"Last Month",periodThisWeek:"This Week",periodToday:"Today",filterByStatus:"Status",filterByCategory:"Category",allCategories:"All",allStatuses:"All",dueFrom:"Due from",totalDue:"Total Pending",dueAmount:"Due",paidAmount:"Received",saleAmount:"Total Sale",loading:"Loading earnings summary...",historicalPerformance:"Historical Performance",recorded:"Recorded",paid:"Paid",pending:"Pending",viewAll:"View All \u2192"},safety:{topicsTitle:"Safety Topics",tapToLearn:"Tap on a topic to read safety guidelines",emergencyNoticeTitle:"Emergency First Aid Notice",emergencyNoticeDesc:"For acute chemical exposure or severe battery thermal events, seek immediate emergency medical care.",title:"Safety Center",subtitle:"Safe handling guidance for informal collectors",centerTitle:"Collector Safety Center",centerSubtitle:"Pictorial & audio guide for safe e-waste handling. Prevention & awareness first.",whyDangerous:"Why It Is Dangerous",dontTitle:"DO NOT (Unsafe Practices)",doTitle:"DO (Safe Practices)",speakGuide:"Speak This Safety Guide",speakOverview:"Listen to Safety Overview",disclaimer:"Safety guidance is informational. Follow applicable local rules and authorized recycler instructions. Never dismantle or process hazardous scrap yourself.",offlineNotice:"Offline Mode: Complete safety guidance is available locally on your device.",learnSafety:"Learn Safety",topics:{batteries:{title:"Battery Safety",subtitle:"Safe handling for damaged & scrap batteries",warning:"Punctured or heated batteries can catch fire, explode, or leak chemicals.",whyDangerous:"Batteries contain stored electrical energy and chemical electrolytes. If punctured, crushed, or exposed to heat, they can rapidly overheat, vent fire, or leak corrosive chemicals.",dont1:"Do NOT puncture, cut, crush, open, or burn batteries.",dont2:"Do NOT expose damaged or swollen batteries to heat, direct sunlight, or sparks.",dont3:"Do NOT mix loose or leaking batteries in metal bins or scrap bags.",do1:"Visually inspect batteries from outside without opening or dismantling.",do2:"Keep visibly damaged batteries separated in a dry, non-conductive, non-metallic container.",do3:"Hand over intact and damaged batteries directly to authorized collection or recycling channels."},crts:{title:"CRT Monitor & TV Safety",subtitle:"Cathode ray picture tube handling",warning:"CRT glass tubes are under vacuum and can implode, throwing sharp fragments.",whyDangerous:"CRTs contain high-vacuum glass assemblies and hazardous heavy metals inside the funnel glass. Smashing them causes glass to violently implode inward and then scatter dangerous sharp shards.",dont1:"Do NOT smash, hammer, or break CRT picture tubes.",dont2:"Do NOT burn CRT housings, yoke assemblies, or internal components.",dont3:"Do NOT attempt casual dismantling or backyard material extraction.",do1:"Keep CRT monitors and TVs intact in their housings whenever possible.",do2:"Handle and transport picture tubes with care, protecting the glass face from sharp impacts.",do3:"Deliver CRT units whole to authorized formal recycling facilities equipped with enclosed vacuum breakers."},pcbs:{title:"Circuit Board (PCB) Safety",subtitle:"Safe storage and handling of printed circuit boards",warning:"Burning boards or soaking in acid produces lethal toxic fumes and chemical burns.",whyDangerous:"Circuit boards contain solder, resins, and heavy metals. Heating them over an open flame or washing with crude acids releases harmful toxic gases, lead fumes, and creates hazardous chemical waste.",dont1:"Do NOT use acid leaching, acid washing, or backyard chemical processing.",dont2:"Do NOT burn circuit boards or expose them to uncontrolled open flames.",dont3:"Do NOT desolder components over open fires or inhale heating fumes.",do1:"Collect and store circuit boards dry and whole without breaking them into pieces.",do2:"Keep PCBs contained in clean boxes or bags away from children, food, and water sources.",do3:"Hand circuit boards over to authorized recyclers with proper industrial recovery systems."},cables:{title:"Cable & Wiring Safety",subtitle:"Copper cable handling without burning",warning:"NEVER burn cables to recover copper. Cable smoke is toxic and harmful to breathe.",whyDangerous:"Cable insulation made of PVC and plastic releases toxic dioxin smoke and acidic fumes when burned. Inhaling this smoke can severely damage lungs and pollute the neighbourhood air.",dont1:"Do NOT burn cables, wires, or power cords in open fires to melt the plastic.",dont2:"Do NOT use open flames or heating coils to strip plastic insulation.",dont3:"Do NOT breathe smoke or fumes from burning wires.",do1:"Collect cables and wiring whole, clean, and without burning.",do2:"Keep cables dry, untangled, and bundled for transport.",do3:"Sell or hand cables to authorized recyclers who use mechanical strippers and granulators."},lcds:{title:"LCD & LED Panel Safety",subtitle:"Display panel and backlight handling",warning:"Older LCD backlights contain mercury; broken screen glass is razor sharp.",whyDangerous:"Older flat-screen displays use Cold Cathode Fluorescent Lamps (CCFL) containing toxic mercury vapor. Breaking the backlights releases mercury vapor and creates sharp glass fragments.",dont1:"Do NOT smash, puncture, or break LCD display panels.",dont2:"Do NOT burn plastic frame parts, diffuser sheets, or panel glass.",dont3:"Do NOT dismantle backlight assemblies casually without proper containment.",do1:"Handle display screens gently and keep them upright during storage and transport.",do2:"Protect screen faces from puncture, bending, and sharp drops.",do3:"Route whole display panels to authorized recyclers for safe mercury recovery."},general:{title:"General E-Waste Safety",subtitle:"Basic precautions for all electronic scrap",warning:"E-waste contains mixed hazards. Never burn, smash, or dump scrap in public spaces.",whyDangerous:"Electronic appliances contain combinations of plastics, metals, glass, and hazardous components. Uncontrolled dismantling spreads toxic dust, contaminates soil, and risks physical injuries.",dont1:"Do NOT burn electronic waste or dump it in open drains, fields, or vacant lots.",dont2:"Do NOT break appliances open with hammers or crude dismantling tools.",dont3:"Do NOT mix hazardous parts (batteries, toners, tubes) with common scrap metal.",do1:"Segregate e-waste into distinct categories: batteries, boards, cables, and appliances.",do2:"Store collected material off the ground in a covered, dry storage area.",do3:"Partner with authorized formal recyclers for safe handover and verified processing."},storage:{title:"Storage & Transport Safety",subtitle:"Safe stacking, weather protection, and vehicle transport",warning:"Unstable stacks can collapse; wet e-waste and squeezed batteries pose fire risks.",whyDangerous:"Careless stacking of heavy electronics can cause crushing injuries. Water leaks can trigger electrical short circuits in batteries, and loose loads can fall off vehicles during transport.",dont1:"Do NOT stack heavy monitors or appliances high without solid base support.",dont2:"Do NOT store e-waste outdoors in rain, damp areas, or near cooking stoves and open fires.",dont3:"Do NOT overload two-wheelers, rickshaws, or carts with unstable unstrapped scrap.",do1:"Keep all e-waste dry, well-ventilated, and protected from rain and moisture.",do2:"Isolate damaged batteries in separate non-metallic containers away from other scrap.",do3:"Securely strap loads onto transport vehicles and lift heavy items bending your knees."},ppe:{title:"Protective Equipment (PPE)",subtitle:"Basic gear for safe scrap collection",warning:"PPE protects your hands and eyes from cuts and dust. PPE does NOT make burning or acid safe.",whyDangerous:"Handling broken electronics exposes collectors to razor-sharp glass, jagged metal edges, heavy lifting strain, and toxic dust residues on hands.",dont1:"Do NOT handle broken glass, bare wires, or jagged metal with bare hands.",dont2:"Do NOT eat, drink, or smoke while handling scrap without washing hands first.",dont3:"Do NOT believe that gloves or masks make open burning or acid washing safe \u2014 burning is NEVER safe.",do1:"Wear heavy-duty puncture-resistant work gloves when lifting and sorting scrap.",do2:"Wear closed sturdy footwear and protective glasses when handling fragile or sharp items.",do3:"Wash hands thoroughly with soap and water after handling any electronic scrap."}}},recyclerDirectory:{contactLocked:"Direct Contact Locked",contactLockedDesc:"Direct phone contact becomes visible once a deal or sourcing quote is accepted.",title:"Recycler Directory",subtitle:"Discover verified formal recyclers & aggregators",openDirectory:"Browse Recyclers",searchPlaceholder:"Search recycler name, city, or material...",statusAuthorized:"Authorized",statusProvisional:"Provisional",statusPending:"Pending Review",statusSuspended:"Suspended",statusRejected:"Rejected",statusExpired:"Inactive / Expired",statusInactive:"Inactive",statusUnavailable:"Authorization status unavailable",authorizedDesc:"Active CPCB / SPCB Registration",provisionalDesc:"Conditional state authorization permit",pendingDesc:"Authorization under administrative verification",suspendedDesc:"Facility authorization suspended by administration",rejectedDesc:"Facility authorization application rejected",expiredDesc:"Registration expired or suspended",inactiveDesc:"Facility is currently inactive",unavaila