u0924',statusOffline:'\u0911\u092b\u0932\u093e\u0907\u0928',backendApiTitle:'\u092c\u0945\u0915\u090f\u0902\u0921 \u090f\u092a\u0940\u0906\u092f \u0938\u0947\u0935\u093e',backendApiDesc:'\u0930\u0947\u0902\u0921\u0930 \u0907\u0928\u094d\u092b\u094d\u0930\u093e\u0938\u094d\u091f\u094d\u0930\u0915\u094d\u091a\u0930\u0935\u0930\u0940\u0932 \u092e\u0941\u0916\u094d\u092f \u090f\u091a\u091f\u0940\u091f\u0940\u092a\u0940 \u0930\u0947\u0938\u094d\u091f \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f\u094d\u0938.',backendApiReachable:'HTTP {status} \u0920\u0940\u0915 ({latency}ms \u092a\u094d\u0930\u0924\u093f\u0938\u093e\u0926)',backendApiUnreachable:'\u092c\u0945\u0915\u090f\u0902\u0921 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u0915\u093f\u0902\u0935\u093e \u0915\u093e\u0932\u092c\u093e\u0939\u094d\u092f',backendApiOffline:'\u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0911\u092b\u0932\u093e\u0907\u0928 \u0906\u0939\u0947; \u092c\u0945\u0915\u090f\u0902\u0921\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u0924\u093e \u092f\u0947\u0924 \u0928\u093e\u0939\u0940',databaseTitle:'\u0921\u0947\u091f\u093e\u092c\u0947\u0938 (PostgreSQL / Neon)',databaseDesc:'ACID \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0938\u094d\u0925\u093f\u0924\u0940\u0938\u093e\u0920\u0940 \u0930\u093f\u0932\u0947\u0936\u0928\u0932 \u0921\u0947\u091f\u093e\u092c\u0947\u0938.',databaseExplanation:'\u092c\u0945\u0915\u090f\u0902\u0921 \u0906\u0930\u094b\u0917\u094d\u092f \u0924\u092a\u093e\u0938\u0923\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092a\u093f\u0902\u0917 \u0926\u0930\u094d\u0936\u0935\u0924 \u0928\u093e\u0939\u0940. \u092e\u094b\u092c\u093e\u0907\u0932\u0935\u0930\u0942\u0928 \u0925\u0947\u091f \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u091c\u094b\u0921\u0923\u0940 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0906\u0939\u0947.',aiServiceTitle:'\u090f\u0906\u092f \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u092e\u093e\u092f\u0915\u094d\u0930\u094b\u0938\u0930\u094d\u0935\u094d\u0939\u093f\u0938',aiServiceDesc:'\u0908-\u0915\u091a\u0930\u093e \u0936\u094d\u0930\u0947\u0923\u0940 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u0935\u094d\u0939\u093f\u091c\u0928 \u092e\u0949\u0921\u0947\u0932 \u0905\u0928\u0941\u092e\u093e\u0928.',aiServiceExplanation:'\u090f\u0906\u092f \u092e\u093e\u092f\u0915\u094d\u0930\u094b\u0938\u0930\u094d\u0935\u094d\u0939\u093f\u0938 \u090f\u0915 \u092c\u093e\u0939\u094d\u092f \u0916\u093e\u091c\u0917\u0940 \u0918\u091f\u0915 \u0906\u0939\u0947. \u0915\u094b\u0923\u0924\u0947\u0939\u0940 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0906\u0930\u094b\u0917\u094d\u092f \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f \u0915\u0949\u0928\u094d\u092b\u093f\u0917\u0930 \u0915\u0947\u0932\u0947\u0932\u0947 \u0928\u093e\u0939\u0940.',fcmTitle:'\u092a\u0941\u0936 \u0938\u0942\u091a\u0928\u093e \u0938\u094d\u0924\u0930 (FCM)',fcmDesc:'\u092b\u093e\u092f\u0930\u092c\u0947\u0938 \u0915\u094d\u0932\u093e\u0909\u0921 \u092e\u0947\u0938\u0947\u091c\u093f\u0902\u0917 \u092a\u0941\u0936 \u0938\u0942\u091a\u0928\u093e \u0935\u093f\u0924\u0930\u0923.',fcmExplanation:'\u092f\u093e \u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938\u0935\u0930\u0942\u0928 \u090f\u092b\u0938\u0940\u090f\u092e \u0935\u093f\u0924\u0930\u0923 \u0938\u094d\u0925\u093f\u0924\u0940 \u092a\u0921\u0924\u093e\u0933\u0924\u093e \u092f\u0947\u0924 \u0928\u093e\u0939\u0940. \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0942\u091a\u0928\u093e \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u093e\u0939\u0924\u0940\u0932.',mapsTitle:'\u0917\u0941\u0917\u0932 \u092e\u0945\u092a\u094d\u0938 \u090f\u0915\u0924\u094d\u0930\u0940\u0915\u0930\u0923',mapsDesc:'\u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u0928\u0915\u093e\u0936\u093e \u092a\u094d\u0930\u0938\u094d\u0924\u0941\u0924\u0940\u0915\u0930\u0923 \u0906\u0923\u093f \u092a\u093f\u0915\u0905\u092a \u092a\u093f\u0928 \u0938\u094d\u0925\u093e\u0928.',mapsExplanation:'\u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092c\u093f\u0932\u094d\u0921 \u0915\u0949\u0928\u094d\u092b\u093f\u0917\u0930\u0947\u0936\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924. \u090f\u092a\u0940\u0906\u092f \u0915\u094b\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0920\u0947\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0925\u0947\u091f \u0938\u0947\u0935\u093e \u092a\u093f\u0902\u0917 \u0935\u0917\u0933\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0940 \u0906\u0939\u0947.',networkTitle:'\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0915\u0928\u0947\u0915\u094d\u091f\u093f\u0935\u094d\u0939\u093f\u091f\u0940',networkDesc:'\u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0907\u0902\u091f\u0930\u092b\u0947\u0938 \u0906\u0923\u093f \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092a\u094b\u0939\u094b\u091a.',networkOnline:'\u091c\u094b\u0921\u0932\u0947 \u0906\u0939\u0947 ({type})',networkOffline:'\u0915\u094b\u0923\u0924\u0940\u0939\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u091c\u094b\u0921\u0923\u0940 \u0928\u093e\u0939\u0940',offlineNotice:'\u0921\u093f\u0935\u094d\u0939\u093e\u0907\u0938 \u0938\u0927\u094d\u092f\u093e \u0911\u092b\u0932\u093e\u0907\u0928 \u0906\u0939\u0947. \u0909\u092a\u0932\u092c\u094d\u0927 \u0905\u0938\u0947\u0932 \u0924\u0947\u0925\u0947 \u0915\u0945\u0936 \u0915\u0947\u0932\u0947\u0932\u0947 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0928\u093f\u0926\u093e\u0928 \u0926\u093e\u0916\u0935\u0932\u0947 \u091c\u093e\u0924 \u0906\u0939\u0947.',historicalNotice:'\u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0928\u093f\u0926\u093e\u0928 \u0938\u094d\u0928\u0945\u092a\u0936\u0949\u091f \u092a\u093e\u0939\u0924 \u0906\u0939\u093e\u0924. \u0911\u092b\u0932\u093e\u0907\u0928 \u0905\u0938\u0924\u093e\u0928\u093e \u0925\u0947\u091f \u0938\u0947\u0935\u0947\u091a\u0947 \u0906\u0930\u094b\u0917\u094d\u092f \u092a\u0921\u0924\u093e\u0933\u0924\u093e \u092f\u0947\u0924 \u0928\u093e\u0939\u0940.'}},recycler:{dashboard:{title:'\u092a\u0941\u0928\u0930\u094d\u091a\u0915\u094d\u0930\u0923\u0915\u0930\u094d\u0924\u093e \u0921\u0945\u0936\u092c\u094b\u0930\u094d\u0921',authorizedFacility:'\u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947\u0902\u0926\u094d\u0930',cpcbAuthorized:'\u0938\u0940\u092a\u0940\u0938\u0940\u092c\u0940 \u0905\u0927\u093f\u0915\u0943\u0924',facilityThroughput:'\u0938\u0941\u0935\u093f\u0927\u093e \u0925\u094d\u0930\u0942\u092a\u0941\u091f',incomingBatches:'\u092f\u0947\u0923\u093e\u0931\u094d\u092f\u093e \u0924\u0941\u0915\u0921\u094d\u092f\u093e',inProcessing:'\u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u0947\u0924',materialsRecovered:'\u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0938\u093e\u0939\u093f\u0924\u094d\u092f',totalRecycledWeight:'\u090f\u0915\u0942\u0923 \u092a\u0941\u0928\u0930\u094d\u091a\u0915\u094d\u0930\u093f\u0924 \u0935\u091c\u0928',quickActions:'\u0911\u092a\u0930\u0947\u0936\u0928\u094d\u0938 \u0935\u0930\u094d\u0915\u092b\u094d\u0932\u094b',incomingConsignments:'\u092f\u0947\u0923\u093e\u0930\u0947 \u0915\u0928\u094d\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f\u094d\u0938',incomingConsignmentsDesc:'\u092c\u0945\u091a \u0915\u0928\u094d\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f\u094d\u0938\u091a\u0947 \u092a\u0941\u0928\u0930\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u093e, \u0917\u094b\u0933\u093e\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u091a\u0947 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923 \u0924\u092a\u093e\u0938\u093e \u0906\u0923\u093f \u0938\u093e\u0939\u093f\u0924\u094d\u092f\u093e\u091a\u0940 \u0924\u092a\u093e\u0938\u0923\u0940 \u0915\u0930\u093e.',processingRecords:'\u092a\u0941\u0928\u