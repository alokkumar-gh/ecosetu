es",tabHistory:"Price History",historyTitle:"Historical Trends",historySubtitle:"Observed scrap buying rates over time",periodWeekly:"Weekly",periodMonthly:"Monthly",periodSelector:"Time Period",trendUp:"Trending Up",trendDown:"Trending Down",trendStable:"Stable Price",trendInsufficient:"Insufficient Data",latestAverage:"Latest Historical Avg",previousAverage:"Previous Period Avg",absoluteChange:"Change",percentageChange:"Change %",totalObservations:"Data Points",speakTrendButton:"\ud83d\udd0a Speak Trend",insufficientDataTitle:"Not Enough Historical Data",insufficientDataMessage:"Historical trends appear when multiple verified market records exist over time.",methodologyLabel:"HISTORICAL TREND",methodologyNotice:"Based on actual observed market prices. This is not a future price forecast or guarantee.",chartTitle:"Historical Price Chart",chartMinMax:"Min: \u20b9{{min}} \xb7 Max: \u20b9{{max}}"},valuation:{title:"Value Estimate",subtitle:"Estimate the value of your material lot",estimatedValue:"Estimated Value",estimatedRange:"Estimated Range",enterWeight:"Enter Weight",weightKg:"Weight (kg)",calculateEstimate:"Calculate Estimate",calculating:"Calculating...",estimateAvailable:"Estimate Available",estimateUnavailable:"Estimate Unavailable",unavailableReason:"No verified price data is available for this material and location.",disclaimer:"This is an estimate, not a guaranteed sale price.",methodology:"Methodology",confidence:"Data Confidence",confidenceVerified:"Based on verified market data",confidenceLimited:"Based on limited or cached data",confidenceNoData:"Insufficient data",basedOn:"Based on",approximateWeight:"Approx. weight",notGuaranteed:"Not a guaranteed price",estimateNote:"Actual sale price may vary depending on quality, condition, and negotiation.",lowEstimate:"Low Estimate",highEstimate:"High Estimate",midEstimate:"Mid Estimate",priceDataUnavailable:"Price data unavailable",checkPriceBoard:"Check Price Board for latest rates"},recyclerMatching:{title:"Recycler Matches",findRecycler:"Find Recycler",lot:"Lot",marketEstimateTitle:"Market Rate Benchmark",marketEstimateNote:"Recycler offers are shown below for comparison. Not a guaranteed transaction.",sortBy:"Sort by",sortPrice:"Offered Price",sortDistance:"Distance",sortFreshness:"Freshness",matchingEligibleRecyclers:"Searching eligible verified recyclers...",fetchFailed:"Failed to fetch recycler matches",noEligibleFound:"No Eligible Recyclers Found",noEligibleDescription:"No verified recyclers currently accept this material in your service area. Check back soon or deliver to an authorized collection hub.",offeredRate:"Offered Buying Rate",offerUnavailable:"Offer unavailable",pickupAvailable:"Pickup Available",pickupUnavailable:"Drop-off Required",pickupUnknown:"Pickup Unknown",match:"MATCHED",partialMatch:"PARTIAL MATCH",notEligible:"NOT ELIGIBLE",authorized:"Authorized",matchReasons:"Match Assessment",speakMatch:"Speak Offer",methodologyDisclosure:"Economic matching is deterministic and rule-based, evaluating authorization, material compatibility, service area, and active offered rates.",nonGuaranteeDisclaimer:"Recycler offers represent published buying rates and do not constitute a binding contract until formal quotation and digital handover.",cachedDataNotice:"Viewing previously cached matches",staleCacheWarning:"Matches cached more than 24 hours ago. Rates may have updated."},quotation:{validRateRequired:"Please enter a valid rate per kg",connectToCounter:"Connect to internet to counter offer",counterSubmitted:"Counter Offer Submitted",counterSubmittedDesc:"Your counter offer has been sent to the buyer.",title:"Recycler Quotes",quotes:"Quotes",quote:"Quote",quoteReference:"Quote Ref",sendQuote:"Send Quote",sendQuoteTitle:"Submit Commercial Quote",quotedRate:"Quoted Rate",unitPrice:"Unit Price",quantity:"Quantity",total:"Total",quotedTotal:"Quoted Total",validUntil:"Valid Until",validFrom:"Valid From",acceptQuote:"Accept Quote",rejectQuote:"Reject Quote",cancelQu