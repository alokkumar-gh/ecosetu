d\u092b\u093c\u093f\u0917\u0930 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e',statusUnknown:'\u0905\u091c\u094d\u091e\u093e\u0924',statusOffline:'\u0911\u092b\u093c\u0932\u093e\u0907\u0928',backendApiTitle:'\u092c\u0948\u0915\u090f\u0902\u0921 \u090f\u092a\u0940\u0906\u0908 \u0938\u0947\u0935\u093e',backendApiDesc:'\u0930\u0947\u0902\u0921\u0930 \u0907\u0928\u094d\u092b\u094d\u0930\u093e\u0938\u094d\u091f\u094d\u0930\u0915\u094d\u091a\u0930 \u092a\u0930 \u092e\u0941\u0916\u094d\u092f \u090f\u091a\u091f\u0940\u091f\u0940\u092a\u0940 \u0930\u0947\u0938\u094d\u091f \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f\u094d\u0938\u0964',backendApiReachable:'HTTP {status} \u0920\u0940\u0915 ({latency}ms \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e)',backendApiUnreachable:'\u092c\u0948\u0915\u090f\u0902\u0921 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u092f\u093e \u0938\u092e\u092f \u0938\u092e\u093e\u092a\u094d\u0924',backendApiOffline:'\u0921\u093f\u0935\u093e\u0907\u0938 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0939\u0948; \u092c\u0948\u0915\u090f\u0902\u0921 \u0924\u0915 \u0928\u0939\u0940\u0902 \u092a\u0939\u0941\u0902\u091a\u093e \u091c\u093e \u0938\u0915\u0924\u093e',databaseTitle:'\u0921\u0947\u091f\u093e\u092c\u0947\u0938 (PostgreSQL / Neon)',databaseDesc:'ACID \u091f\u094d\u0930\u093e\u0902\u091c\u0947\u0915\u094d\u0936\u0928\u0932 \u0938\u094d\u0925\u093f\u0924\u093f \u0939\u0947\u0924\u0941 \u0930\u093f\u0932\u0947\u0936\u0928\u0932 \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u0964',databaseExplanation:'\u092c\u0948\u0915\u090f\u0902\u0921 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u091c\u093e\u0902\u091a \u0938\u0915\u094d\u0930\u093f\u092f \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092a\u093f\u0902\u0917 \u0915\u094b \u092a\u094d\u0930\u0915\u091f \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u0947 \u0938\u0940\u0927\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0928\u093f\u0937\u093f\u0926\u094d\u0927 \u0939\u0948\u0964',aiServiceTitle:'\u090f\u0906\u0908 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u0938\u0930\u094d\u0935\u093f\u0938',aiServiceDesc:'\u0908-\u0915\u091a\u0930\u093e \u0936\u094d\u0930\u0947\u0923\u0940 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0939\u0947\u0924\u0941 \u0935\u093f\u091c\u093c\u0928 \u092e\u0949\u0921\u0932 \u0905\u0928\u0941\u092e\u093e\u0928\u0964',aiServiceExplanation:'\u090f\u0906\u0908 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u0938\u0930\u094d\u0935\u093f\u0938 \u090f\u0915 \u092c\u093e\u0939\u0930\u0940 \u0928\u093f\u091c\u0940 \u0918\u091f\u0915 \u0939\u0948\u0964 \u0915\u094b\u0908 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964',fcmTitle:'\u092a\u0941\u0936 \u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u0938\u094d\u0924\u0930 (FCM)',fcmDesc:'\u092b\u093c\u093e\u092f\u0930\u092c\u0947\u0938 \u0915\u094d\u0932\u093e\u0909\u0921 \u092e\u0948\u0938\u0947\u091c\u093f\u0902\u0917 \u092a\u0941\u0936 \u0905\u0927\u093f\u0938\u0942\u091a\u0928\u093e \u0935\u093f\u0924\u0930\u0923\u0964',fcmExplanation:'\u0907\u0938 \u0921\u093f\u0935\u093e\u0907\u0938 \u0938\u0947 \u090f\u092b\u0938\u0940\u090f\u092e \u0935\u093f\u0924\u0930\u0923 \u0938\u094d\u0925\u093f\u0924\u093f \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940\u0964 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0942\u091a\u0928\u093e\u090f\u0902 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u092c\u0928\u0940 \u0930\u0939\u0947\u0902\u0917\u0940\u0964',mapsTitle:'\u0917\u0942\u0917\u0932 \u092e\u0948\u092a\u094d\u0938 \u090f\u0915\u0940\u0915\u0930\u0923',mapsDesc:'\u092e\u0942\u0932 \u092e\u0948\u092a \u0930\u0947\u0902\u0921\u0930\u093f\u0902\u0917 \u090f\u0935\u0902 \u092a\u093f\u0915\u0905\u092a \u092a\u093f\u0928 \u092a\u094d\u0932\u0947\u0938\u092e\u0947\u0902\u091f\u0964',mapsExplanation:'\u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092c\u093f\u0932\u094d\u0921 \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930\u0947\u0936\u0928 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924\u0964 \u090f\u092a\u0940\u0906\u0908 \u0915\u094b\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0928\u0947 \u0939\u0947\u0924\u0941 \u0932\u093e\u0907\u0935 \u0938\u0947\u0935\u093e \u092a\u093f\u0902\u0917 \u091b\u094b\u0921\u093c \u0926\u0940 \u0917\u0908 \u0939\u0948\u0964',networkTitle:'\u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0915\u0928\u0947\u0915\u094d\u091f\u093f\u0935\u093f\u091f\u0940',networkDesc:'\u0921\u093f\u0935\u093e\u0907\u0938 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0907\u0902\u091f\u0930\u092b\u093c\u0947\u0938 \u090f\u0935\u0902 \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092a\u0939\u0941\u0902\u091a \u092f\u094b\u0917\u094d\u092f\u0924\u093e\u0964',networkOnline:'\u0915\u0928\u0947\u0915\u094d\u091f\u0947\u0921 ({type})',networkOffline:'\u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0928\u0939\u0940\u0902',offlineNotice:'\u0921\u093f\u0935\u093e\u0907\u0938 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0939\u0948\u0964 \u091c\u0939\u093e\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u094b, \u0915\u0948\u0936\u094d\u0921 \u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0928\u093f\u0926\u093e\u0928 \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u0964',historicalNotice:'\u0910\u0924\u093f\u0939\u093e\u0938\u093f\u0915 \u0928\u093f\u0926\u093e\u0928 \u0938\u094d\u0928\u0948\u092a\u0936\u0949\u091f \u0926\u0947\u0916\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0930\u0939\u0924\u0947 \u0939\u0941\u090f \u0938\u091c\u0940\u0935 \u0938\u0947\u0935\u093e \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964'}},recycler:{dashboard:{title:'\u0930\u0940\u0938\u093e\u0907\u0915\u094d\u0932\u0930 \u0921\u0948\u0936\u092c\u094b\u0930\u094d\u0921',authorizedFacility:'\u0905\u0927\u093f\u0915\u0943\u0924 \u0938\u0941\u0935\u093f\u0927\u093e \u0915\u0947\u0902\u0926\u094d\u0930',cpcbAuthorized:'\u0938\u0940\u092a\u0940\u0938\u0940\u092c\u0940 \u0905\u0927\u093f\u0915\u0943\u0924',facilityThroughput:'\u0938\u0941\u0935\u093f\u0927\u093e \u0925\u094d\u0930\u0942\u092a\u0941\u091f',incomingBatches:'\u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u092c\u0948\u091a',inProcessing:'\u092a\u094d\u0930\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092e\u0947\u0902',materialsRecovered:'\u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940',totalRecycledWeight:'\u0915\u0941\u0932 \u092a\u0941\u0928\u0930\u094d\u091a\u0915\u094d\u0930\u093f\u0924 \u0935\u091c\u0928',quickActions:'\u092a\u0930\u093f\u091a\u093e\u0932\u0928 \u0915\u093e\u0930\u094d\u092f\u092a\u094d\u0930\u0935\u093e\u0939',incomingConsignments:'\u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u0928\u094d\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f',incomingConsignmentsDesc:'\u092c\u0948\u091a \u0915\u0928\u094d\u0938\u093e\u0907\u0928\u092e\u0947\u0902\u091f \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902, \u0915\u0932\u0947\u0915\u094d\u091f\u0930 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u092