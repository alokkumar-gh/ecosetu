ccess:'\u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b32\u0b1f\u0b4d \u0b38\u0b2b\u0b33\u0b24\u0b3e\u0b30 \u0b38\u0b39\u0b3f\u0b24 \u0b26\u0b3e\u0b16\u0b32 \u0b39\u0b47\u0b32\u0b3e',categories:{CRT:'\u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b2e\u0b28\u0b3f\u0b1f\u0b30 \u0b0f\u0b2c\u0b02 \u0b1f\u0b3f\u0b2d\u0b3f',LCD_PANEL:'\u0b0f\u0b32\u0b38\u0b3f\u0b21\u0b3f / \u0b0f\u0b32\u0b07\u0b21\u0b3f \u0b2a\u0b4d\u0b5f\u0b3e\u0b28\u0b47\u0b32\u0b4d',PCB:'\u0b38\u0b30\u0b4d\u0b15\u0b3f\u0b1f\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21 (\u0b2a\u0b3f\u0b38\u0b3f\u0b2c\u0b3f)',CABLE:'\u0b24\u0b3e\u0b30 \u0b0f\u0b2c\u0b02 \u0b15\u0b47\u0b2c\u0b41\u0b32\u0b4d',BATTERY:'\u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40',MOTOR:'\u0b2e\u0b4b\u0b1f\u0b30 \u0b0f\u0b2c\u0b02 \u0b15\u0b0f\u0b32\u0b4d',MAGNET_ASSEMBLY:'\u0b1a\u0b41\u0b2e\u0b4d\u0b2c\u0b15\u0b40\u0b5f \u0b05\u0b38\u0b47\u0b2e\u0b4d\u0b2c\u0b32\u0b3f',MIXED_PLASTIC:'\u0b2e\u0b3f\u0b36\u0b4d\u0b30\u0b3f\u0b24 \u0b07-\u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15\u0b4d',MOBILE_PHONE:'\u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b2b\u0b4b\u0b28\u0b4d',LAPTOP:'\u0b32\u0b3e\u0b2a\u0b1f\u0b2a\u0b4d',MONITOR:'\u0b15\u0b2e\u0b4d\u0b2a\u0b4d\u0b5f\u0b41\u0b1f\u0b30 \u0b2e\u0b28\u0b3f\u0b1f\u0b30',PRINTER:'\u0b2a\u0b4d\u0b30\u0b3f\u0b23\u0b4d\u0b1f\u0b30 \u0b0f\u0b2c\u0b02 \u0b38\u0b4d\u0b15\u0b3e\u0b28\u0b30',KEYBOARD_MOUSE:'\u0b15\u0b3f\u0b2c\u0b4b\u0b30\u0b4d\u0b21 \u0b0f\u0b2c\u0b02 \u0b2e\u0b3e\u0b09\u0b38\u0b4d',DESKTOP_COMPUTER:'\u0b21\u0b47\u0b38\u0b4d\u0b15\u0b1f\u0b2a\u0b4d \u0b15\u0b2e\u0b4d\u0b2a\u0b4d\u0b5f\u0b41\u0b1f\u0b30',TABLET:'\u0b1f\u0b3e\u0b2c\u0b32\u0b47\u0b1f\u0b4d \u0b0f\u0b2c\u0b02 \u0b07-\u0b30\u0b3f\u0b21\u0b30',OTHER:'\u0b05\u0b28\u0b4d\u0b5f\u0b3e\u0b28\u0b4d\u0b5f \u0b2d\u0b19\u0b4d\u0b17\u0b3e \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40'},subcategories:{COLOR_CRT:'\u0b30\u0b19\u0b4d\u0b17\u0b40\u0b28 \u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f',BW_CRT:'\u0b15\u0b33\u0b3e-\u0b27\u0b33\u0b3e \u0b38\u0b3f\u0b06\u0