092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u092a\u0941\u0928\u0930\u094d\u0935\u093e\u092a\u0930\u0915\u0930\u094d\u0924\u094d\u092f\u093e\u0902\u0936\u0940 \u091c\u094b\u0921\u0924\u0947.",suspendedNotice:"\u26a0\ufe0f \u0924\u0941\u092e\u091a\u0947 \u0938\u0902\u0915\u0932\u0915 \u0916\u093e\u0924\u0947 \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947. \u0915\u0943\u092a\u092f\u093e \u0938\u092e\u0930\u094d\u0925\u0928\u093e\u0936\u0940 \u0938\u0902\u092a\u0930\u094d\u0915 \u0938\u093e\u0927\u093e.",pendingNotice:"\ud83d\udd50 \u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u0924\u0947 \u092a\u094d\u0930\u0936\u093e\u0938\u0915\u0940\u092f \u092a\u0921\u0924\u093e\u0933\u0923\u0940\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u0947\u0924 \u0906\u0939\u0947. \u092a\u094d\u0930\u0932\u0902\u092c\u093f\u0924 \u0905\u0938\u0924\u093e\u0928\u093e \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u093e.",deactivatedNotice:"\u26a0\ufe0f \u0924\u0941\u092e\u091a\u0947 \u0916\u093e\u0924\u0947 \u0928\u093f\u0937\u094d\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u0906\u0932\u0947 \u0906\u0939\u0947."},browse:{title:"\u0909\u092a\u0932\u092c\u094d\u0927 \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e",subtitle:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u0930\u093f\u0938\u0930\u093e\u0924\u0940\u0932 \u0918\u0930\u092a\u094b\u091a \u092a\u093f\u0915\u0905\u092a\u0938\u093e\u0920\u0940 \u0924\u092f\u093e\u0930 \u0905\u0938\u0932\u0947\u0932\u094d\u092f\u093e \u0916\u0941\u0932\u094d\u092f\u093e \u0938\u0902\u0915\u0932\u0928 \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e",items:"\u0935\u0938\u094d\u0924\u0942",item:"\u0935\u0938\u094d\u0924\u0942",availableBadge:"\u0909\u092a\u0932\u092c\u094d\u0927",approximateLocation:"\u0905\u0902\u0926\u093e\u091c\u094