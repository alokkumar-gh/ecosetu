b4d\u0b1f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',pickupLocation:'\u0b2a\u0b3f\u0b15\u0b05\u0b2a\u0b4d \u0b38\u0b4d\u0b25\u0b3e\u0b28',useCurrentLocation:'\u0b2e\u0b4b\u0b30 \u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b2e\u0b3e\u0b28\u0b30 \u0b38\u0b4d\u0b25\u0b3e\u0b28 \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41',locPermissionRequired:'\u0b38\u0b4d\u0b25\u0b3e\u0b28 \u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15',locPermissionDenied:'\u0b38\u0b4d\u0b25\u0b3e\u0b28 \u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b2a\u0b4d\u0b30\u0b24\u0b4d\u0b5f\u0b3e\u0b16\u0b4d\u0b5f\u0b3e\u0b28 \u0b15\u0b30\u0b3e\u0b17\u0b32\u0b3e',locPermissionHelp:'\u0b2e\u0b4d\u0b5f\u0b3e\u0b2a\u0b4d \u0b15\u0b41 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b18\u0b30 \u0b09\u0b2a\u0b30\u0b47 \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b3f\u0b24 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b4d\u0b25\u0b3e\u0b28 \u0b05\u0b28\u0b41\u0b2e\u0b24\u0b3f \u0b38\u0b15\u0b4d\u0b37\u0b2e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',locUnavailable:'\u0b38\u0b4d\u0b25\u0b3e\u0b28 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b28\u0b3e\u0b39\u0b3f\u0b01',movePin:'\u0b2a\u0b3f\u0b28\u0b4d \u0b18\u0b41\u0b1e\u0b4d\u0b1a\u0b3e\u0b28\u0b4d\u0b24\u0b41',selectedLocation:'\u0b1a\u0b5f\u0b28\u0b3f\u0b24 \u0b2a\u0b3f\u0b15\u0b05\u0b2a\u0b4d \u0b38\u0b4d\u0b25\u0b3e\u0b28',mapLoading:'\u0b2e\u0b4d\u0b5f\u0b3e\u0b2a\u0b4d \u0b32\u0b4b\u0b21\u0b4d \u0b39\u0b47\u0b09\u0b1b\u0b3f...',mapUnavailable:'\u0b2e\u0b4d\u0b5f\u0b3e\u0b2a\u0b4d \u0b05\u0b28\u0b41\u0b2a\u0b32\u0b2c\u0b4d\u0b27 (\u0b05\u0b2b\u0b32\u0b3e\u0b07\u0b28\u0b4d)',offlineMapHelp:'\u0b28\u0b47\u0b1f\u0b71\u0b3e\u0b30\u0b4d\u0b15 \u0b38\u0b02\u0b2f\u0b4b\u0b17 \u0b2c\u0b3f\u0b1a\u0b4d\u0b1b\u0b3f\u0b28\u0b4d\u0b28\u0964 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b0f\u0b2c\u0b02 \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b26\u0b47\u0b36\u0b3e\u0b19\u0b4d\u0b15 \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b2d\u0b3e\u0b2c\u0b47 \u0b38\u0b02\u0b30\u0b15\u0b4d\u0b37\u0b3f\u0b24\u0964',latitude:'\u0b05\u0b15\u0b4d\u0b37\u0b3e\u0b02\u0b36',longitude:'\u0b26\u0b4d\u0b30\u0b3e\u0b18\u0b3f\u0b2e\u0b3e',addressType:'\u0b20\u0b3f\u0b15\u0b23\u0b3e\u0b30 \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30',houseNumber:'\u0b18\u0b30 / \u0b15\u0b4b\u0b20\u0b3e / \u0b2b\u0b4d\u0b32\u0b3e\u0b1f',street:'\u0b30\u0b3e\u0b38\u0b4d\u0b24\u0b3e / \u0b05\u0b1e\u0b4d\u0b1a\u0b33',landmark:'\u0b28\u0b3f\u0b15\u0b1f\u0b38\u0b4d\u0b25 \u0b38\u0b4d\u0b25\u0b3e\u0b28 (\u0b32\u0b4d\u0b5f\u0b3e\u0b23\u0b4d\u0b21\u0b2e\u0b3e\u0b30\u0b4d\u0b15)',city:'\u0b17\u0b4d\u0b30\u0b3e\u0b2e / \u0b38\u0b39\u0b30',district:'\u0b1c\u0b3f\u0b32\u0b4d\u0b32\u0b3e',state:'\u0b30\u0b3e\u0b1c\u0b4d\u0b5f',pincode:'\u0b2a\u0b3f\u0b28\u0b4d \u0b15\u0b4b\u0b21\u0b4d',home:'\u0b18\u0b30',office:'\u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b3e\u0b33\u0b5f',other:'\u0b05\u0b28\u0b4d\u0b5f\u0b3e\u0b28\u0b4d\u0b5f'},requests:{title:'\u0b2e\u0b4b\u0b30 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27',subtitle:'\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b15\u0b2c\u0b3e\u0b21\u0b3c\u0b3f\u0b71\u0b3e\u0b32\u0b3e\u0b19\u0b4d\u0b15 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b18\u0b30\u0b41 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b1f\u0b4d\u0b30\u0b3e\u0b15\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',filterAll:'\u0b38\u0b2e\u0b38\u0b4d\u0b24',filterActive:'\u0b38\u0b15\u0b4d\u0b30\u0b3f\u0b5f',filterCollected:'\u0b38\u0b02\u0b17\u0b43\u0b39\u0b40\u0b24',filterCancelled:'\u0b2c\u0b3e\u0b24\u0b3f\u0b32',noRequestsTitle:'\u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b28\u0b3e\u0b39\u0b3f\u0b01',noRequestsMessage:'\u0b0f\u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b15\u0b4c\u0b23\u0b38\u0b3f \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b06\u0b30\u0b2e\u0b4d\u0b2d \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2a\u0b4d\u0b30\u0b25\u0b2e \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41!',noRequestsFilterMessage:'\u0b15\u0b4c\u0b23\u0b38\u0b3f {filter} \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2e\u0b3f\u0b33\u0b3f\u0b32\u0b3e \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',submitItemBtn:'+ \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b26\u0b3e\u0b16\u0b32',viewAllBtn:'\u0b38\u0b2c\u0b41 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41',viewDetails:'\u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41 \u2192',cancelRequest:'\u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41',assignedCollectorNotice:'\ud83e\udd1d \u0b28\u0b3f\u0b2f\u0b41\u0b15\u0b4d\u0b24: \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b05\u0b28\u0b4c\u0b2a\u0b1a\u0b3e\u0b30\u0b3f\u0b15 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39\u0b15\u0b3e\u0b30\u0b40 (\u0b15\u0b2c\u0b3e\u0b21\u0b3c\u0b3f\u0b71\u0b3e\u0b32\u0b3e)',offlineNotice:'\u0b05\u0b2b\u0b32\u0b3e\u0b07\u0b28\u0b4d \u0b2e\u0b4b\u0b21\u0b4d: \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b15\u0b4d\u0b5f\u0b3e\u0b36\u0b4d \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b26\u0b30\u0b4d\u0b36\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f\u0964',fetchError:'\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b32\u0b4b\u0b21\u0b4d \u0b39\u0b4b\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b32\u0b3e \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b2a\u0b41\u0b28\u0b03 \u0b1a\u0b47\u0b37\u0b4d\u0b1f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',cancelModalTitle:'\u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41',cancelModalSubtitle:'\u0b06\u0b2a\u0b23 \u0b28\u0b3f\u0b36\u0b4d\u0b1a\u0b3f\u0b24 \u0b15\u0b3f \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 #{id} \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b1a\u0b3e\u0b39\u0b3e\u0b01\u0b28\u0b4d\u0b24\u0b3f? \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b39\u0b47\u0b32\u0b47 \u0b28\u0b3f\u0b2f\u0b41\u0b15\u0b4d\u0b24 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39\u0b15\u0b3e\u0b30\u0b40\u0b19\u0b4d\u0b15\u0b41 \u0b1c\u0b23\u0b3e\u0b07 \u0b26\u0b3f\u0b06\u0b2f\u0b3f\u0b2c\u0964',cancelReasonLabel:'\u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30 \u0b15\u0b3e\u0b30\u0b23 *',cancelReasonPlaceholder:'\u0b2f\u0b25\u0b3e: \u0b38\u0b2e\u0b5f \u0b05\u0b38\u0b41\u0b2c\u0b3f\u0b27\u0b3e, \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b2a\u0b42\u0b30\u0b4d\u0b2c\u0b30\u0b41 \u0b2a\u0b4d\u0b30\u0b26\u0b3e\u0b28 \u0b38\u0b30\u0b3f\u0b1b\u0b3f',cancelReasonRequired:'\u0b26\u0b5f\u0b3e\u0b15\u0b30\u0b3f \u0b0f\u0b39\u0b3f \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30 \u0b15\u0b3e\u0b30\u0b23 \u0b26\u0b30\u0b4d\u0b36\u0b3e\u0b28\u0b4d\u0b24\u0b41\u0964',keepRequest:'\u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41',confirmCancel:'\u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b28\u0b3f\u0b36\u0b4d\u0b1a\u0b3f\u0b24 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41',cancelSuccessTitle:'\u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b39\u0b47\u0b32\u0b3e',cancelSuccessMessage:'\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b38\u0b2b\u0b33\u0b24\u0b3e\u0b30 \u0b38\u0b39 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b39\u0b47\u0b32\u0b3e\u0964',cancelError:'\u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30\u0b47 \u0b2c\u0b3f\u0b2b\u0b33\u0964 \u0b2a\u0b41\u0b28\u0b03 \u0b1a\u0b47\u0b37\u0b4d\u0b1f\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964',cancelOfflineError:'\u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b15\u0b4d\u0b30\u0b3f\u0b5f \u0b07\u0b23\u0b4d\u0b1f\u0b30\u0b28\u0b47\u0b1f\u0b4d \u0b06\u0b2c\u0b36\u0b4d\u0b5f\u0b15\u0964',statusDraftDesc:'\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b0f\u0b2a\u0b30\u0b4d\u0b2f\u0b4d\u0b5f\u0b28\u0b4d\u0b24 \u0b26\u0b3e\u0b16\u0b32 \u0b39\u0b4b\u0b07\u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964',statusSubmittedDesc:'\u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b15\u0b2c\u0b3e\u0b21\u0b3c\u0b3f\u0b71\u0b3e\u0b32\u0b3e \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b05\u0b2a\u0b47\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f\u0964',statusAcceptedDesc:'\u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39\u0b15\u0b3e\u0b30\u0b40 \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b3f\u0b1b\u0b28\u0b4d\u0b24\u0b3f\u0964 \u0b2a\u0b3f\u0b15\u0b05\u0b2a\u0b4d \u0b28\u0b3f\u0b30\u0b4d\u0b26\u0b4d\u0b27\u0b3e\u0b30\u0b23 \u0b15\u0b30\u0b3e\u0b2f\u0b3f\u0b2c\u0964',statusPickupScheduledDesc:'{date} \u0b30\u0b47 \u0b2a\u0b3f\u0b15\u0b05\u0b2a\u0b4d \u0b27\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b1b\u0b3f\u0964',statusPickedUpDesc:'\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b24\u0b41 \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b1b\u0b3f\u0964',statusCancelledDesc:'\u0b0f\u0b39\u0b3f \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b2c\u0b3e\u0b24\u0b3f\u0b32 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b32\u0b3e\u0964',statusExpiredDesc:'\u0b0f\u0b39\u0b3f \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27\u0b30 \u0b38\u0b2e\u0b5f \u0b38\u0b2e\u0b3e\u0b2a\u0b4d\u0b24 \u0b39\u0b4b\u0b07\u0b1b\u0b3f\u0964