u0930 \u0906\u0923\u093f \u092a\u094d\u0930\u092d\u093e\u0935 \u092a\u0939\u093e",open_language_settings:"\u092d\u093e\u0937\u093e \u092c\u0926\u0932\u093e",open_profile:"\u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c \u0909\u0918\u0921\u093e"},intents:{who_is_eco_saathi:{answer:"\u0928\u092e\u0938\u094d\u0924\u0947! \u092e\u0940 \u0907\u0915\u094b-\u0938\u093e\u0925\u0940 \u0906\u0939\u0947, \u0924\u0941\u092e\u091a\u093e \u0907\u0915\u094b\u0938\u0947\u0924\u0942 \u0938\u0939\u093e\u092f\u094d\u092f\u0915. \u092e\u0940 \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u092d\u0902\u0917\u093e\u0930 \u0935\u093f\u0915\u094d\u0930\u0940, \u092d\u093e\u0935 \u0924\u092a\u093e\u0938\u0923\u0947, \u0938\u0941\u0930\u0915\u094d\u0937\u0947\u091a\u0947 \u0928\u093f\u092f\u092e \u0938\u092e\u091c\u0942\u0928 \u0918\u0947\u0923\u0947 \u0906\u0923\u093f \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u094d\u092f\u093e\u0924 \u092e\u0926\u0924 \u0915\u0930\u0924\u094b."},what_is_ecosetu:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0942 \u0928\u093e\u0917\u0930\u093f\u0915, \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u092d\u0902\u0917\u093e\u0930 \u0917\u094b\u0933\u093e \u0915\u0930\u0923\u093e\u0930\u0947 \u0906\u0923\u093f \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930\u094d\u0938\u0928\u093e \u091c\u094b\u0921\u0942\u0928 \u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924, \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u0915 \u0906\u0923\u093f \u0914\u092a\u091a\u093e\u0930\u093f\u0915 \u0908-\u0915\u091a\u0930\u093e \u092e\u0942\u0932\u094d\u092f \u0936\u0943\u0902\u0916\u0932\u093e \u0924\u092f\u093e\u0930 \u0915\u0930\u0924\u094b."},support_help:{answer:"\u0924\u093e\u0924\u0921\u0940\u091a\u094d\u092f\u093e \u092e\u0926\u0924\u0940\u0938\u093e\u0920\u0940 \u0924\u0941\u092e\u094d\u0939\u0940 \u0935\u093f\u0935\u093e\u0926 \u0935 \u0938\u092a\u094b\u0930\u094d\u091f \u0938\u0947\u0902\u091f\u0930\u092e\u0927\u094d\u092f\u0947 \u0924\u0915\u094d\u0930\u093e\u0930 \u0928\u094b\u0902\u0926\u0935\u0942 \u0936\u0915\u0924\u093e \u0915\u093f\u0902\u0935\u093e support@ecosetu.org \u0935\u0930 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e."},ai_classes:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0942 \u090f\u0906\u092f \u0915\u0945\u092e\u0947\u0930\u093e \u092e\u094b\u092c\u093e\u0908\u0932 \u092b\u094b\u0928, \u091f\u0945\u092c\u094d\u0932\u0947\u091f \u0906\u0923\u093f \u0915\u0940\u092c\u094b\u0930\u094d\u0921/\u092e\u093e\u090a\u0938 \u0906\u092a\u094b\u0906\u092a \u0913\u0933\u0916\u0924\u094b. \u0907\u0924\u0930 \u0967\u0969 \u0936\u094d\u0930\u0947\u0923\u0940\u0902\u0938\u093e\u0920\u0940 (\u092a\u0940\u0938\u0940\u092c\u0940, \u092c\u0945\u091f\u0930\u0940, \u0915\u0947\u092c\u0932 \u0907\u0924\u094d\u092f\u093e\u0926\u0940) \u0924\u0941\u092e\u094d\u0939\u0940 \u092f\u093e\u0926\u0940\u0924\u0942\u0928 \u0938\u0939\u091c \u0928\u093f\u0935\u0921 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e."},ai_manual_selection:{answer:"\u091c\u0930 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0908-\u0915\u091a\u0930\u093e \u0935\u0938\u094d\u0924\u0942\u091a\u0940 \u090f\u0906\u092f\u0928\u0947 \u0913\u0933\u0916 \u092a\u091f\u0935\u0932\u0940 \u0928\u093e\u0939\u0940, \u0924\u0930 \u0921\u094d\u0930\u0949\u092a\u0921\u093e\u0909\u0928 \u092f\u093e\u0926\u0940\u0924\u0942\u0928 \u092f\u094b\u0917\u094d\u092f \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u093e \u0906\u0923\u093f \u0905\u0902\u0926\u093e\u091c\u0947 \u0935\u091c\u0928 \u091f\u093e\u0915\u093e."},ai_accuracy:{answer:"\u090f\u0906\u092f \u0913\u0933\u0916 \u0939\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u094b\u092f\u0940\u0938\u093e\u0920\u0940 \u0926\u093f\u0932\u0947\u0932\u0940 \u092e\u0926\u0924 \u0906\u0939\u0947. \u092f\u093e\u092e\u0941\u0933\u0947 \u0905\u0902\u0924\u093f\u092e \u0915\u093f\u0902\u092e\u0924 \u0920\u0930\u0924 \u0928\u093e\u0939\u0940; \u0924\u0941\u092e\u094d\u0939\u093e\u0932\u093e \u0924\u092a\u0936\u0940\u0932 \u092c\u0926\u0932\u0923\u094d\u092f\u093e\u091a\u093e \u092a\u0942\u0930\u094d\u0923 \u0905\u0927\u093f\u0915\u093e\u0930 \u0906\u0939\u0947."},price_board:{answer:"\u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u094d\u0930\u093e\u0908\u0938 \u092c\u094b\u0930\u094d\u0921\u0935\u0930 \u0938\u0927\u094d\u092f\u093e\u091a\u0947 \u092c\u0947\u0902\u091a\u092e\u093e\u0930\u094d\u0915 \u0938\u094d\u0915\u094d\u0930\u0945\u092a \u0926\u0930 \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u093e. \u0939\u0947 \u0926\u0930 \u092a\u094d\u0930\u093e\u0926\u0947\u0936\u093f\u0915 \u092e\u093e\u0917\u0923\u0940\u0928\u0941\u0938\u093e\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0947\u0932\u0947 \u091c\u093e\u0924\u093e\u0924."},todays_price:{answer:"\u0938\u094d\u0915\u094d\u0930\u0945\u092a\u091a\u0947 \u0926\u0930 \u0938\u093e\u0939\u093f\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0906\u0923\u093f \u0936\u0941\u0926\u094d\u0927\u0924\u0947\u0928\u0941\u0938\u093e\u0930 \u0920\u0930\u0924\u093e\u0924. \u0925\u0947\u091f \u092c\u093e\u091c\u093e\u0930\u092d\u093e\u0935 \u092a\u093e\u0939\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u093e\u0908\u0938 \u092c\u094b\u0930\u094d\u0921 \u0909\u0918\u0921\u0924 \u0906\u0939\u0947..."},price_determination:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0942\u0935\u0930 \u0915\u093f\u092e\u0924\u0940 \u0915\u0932\u0947\u0915\u094d\u091f\u0930\u094d\u0938 \u0906\u0923\u093f \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930\u094d\u0938 \u092f\u093e\u0902\u091a\u094d\u092f\u093e\u0924 \u092a\u0930\u0938\u094d\u092a\u0930 \u0935\u093e\u091f\u093e\u0918\u093e\u091f\u0940\u0928\u0947 \u0920\u0930\u0924\u093e\u0924, \u091c\u094d\u092f\u093e\u0924 \u092a\u094d\u0930\u093e\u0908\u0938 \u092c\u094b\u0930\u094d\u0921 \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u0915 \u0938\u0902\u0926\u0930\u094d\u092d \u092e\u094d\u0939\u0923\u0942\u0928 \u0915\u093e\u092e \u0915\u0930\u0924\u094b."},how_to_create_lot:{answer:"\u0908-\u0915\u091a\u0930\u093e \u0935\u093f\u0915\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 '\u0935\u093f\u0915\u093e' \u0935\u0930 \u091f\u0945\u092a \u0915\u0930\u093e, \u0938\u093e\u0939\u093f\u0924\u094d\u092f\u093e\u091a\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u0928\u093f\u0935\u0921\u093e, \u090f\u0906\u092f \u0915\u0945\u092e\u0947\u0931\u094d\u092f\u093e\u0928\u0947 \u092b\u094b\u091f\u094b \u0918\u094d\u092f\u093e, \u0905\u0902\u0926\u093e\u091c\u0947 \u0935\u091c\u0928 \u091f\u093e\u0915\u093e \u0906\u0923\u093f \u0932\u0949\u091f \u092a\u094d\u0930\u0938\u093f\u0926\u094d\u0927 \u0915\u0930\u093e."},my_lots_status:{answer:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0938\u0915\u094d\u0930\u093f\u092f \u0932\u0949\u091f\u094d\u0938\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0924 \u0906\u0939\u0947..."},lot_categories:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0942 \u0967\u096c \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 \u0908-\u0915\u091a\u0930\u093e \u0936\u094d\u0930\u0947\u0923\u0940\u0902\u0928\u093e \u0938\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0924\u094b, \u091c\u094d\u092f\u093e\u092e\u0927\u094d\u092f\u0947 \u092a\u0940\u0938\u0940\u092c\u0940, \u092c\u0945\u091f\u0931\u094d\u092f\u093e, \u0915\u0947\u092c\u0932\u094d\u0938, \u0938\u0940\u0906\u0930\u091f\u0940, \u090f\u0932\u0938\u0940\u0921\u0940, \u092e\u094b\u092c\u093e\u0908\u0932 \u0906\u0923\u093f \u0932\u0945\u092a\u091f\u0949\u092a \u0938\u092e\u093e\u0935\u093f\u0937\u094d\u091f \u0906\u0939\u0947\u0924."},citizen_give_ewaste:{answer:"\u0924\u0941\u092e\u091a\u093e \u091c\u0941\u0928\u093e \u0908-\u0915\u091a\u0930\u093e \u0926\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 '\u0926\u094d\u092f\u093e' \u0935\u0930 \u091f\u0945\u092a \u0915\u0930\u093e, \u092b\u094b\u091f\u094b \u0918\u094d\u092f\u093e, \u0924\u0941\u092e\u091a\u093e \u092a\u0924\u094d\u0924\u093e \u0928\u093f\u0935\u0921\u093e \u0906\u0923\u093f \u0938\u094d\u0925\u093e\u0928\u093f\u0915 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0932\u0947\u0915\u094d\u091f\u0930 \u0924\u094b \u0918\u0947\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u092f\u0947\u0908\u0932."},citizen_requests_status:{answer:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0935\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u093f\u0915\u0905\u092a \u0935\u093f\u0928\u0902\u0924\u094d\u092f\u093e\u0902\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0924 \u0906\u0939\u0947..."},marketplace_browse:{answer:"\u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930\u094d\u0938 \u092e\u093e\u0930\u094d\u0915\u0947\u091f\u092a\u094d\u0932\u0947\u0938\u0935\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0938\u094d\u0915\u094d\u0930\u0945\u092a \u0932\u0949\u091f\u094d\u0938 \u092a\u093e\u0939\u0942 \u0936\u0915\u0924\u093e\u0924 \u0906\u0923\u093f \u0925\u0947\u091f \u0916\u0930\u0947\u0926\u0940\u091a\u094d\u092f\u093e \u092c\u094b\u0932\u0940 \u0932\u093e\u0935\u0942 \u0936\u0915\u0924\u093e\u0924."},view_offers:{answer:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0932\u0949\u091f\u094d\u0938\u0938\u093e\u0920\u0940 \u0906\u0932\u0947\u0932\u094d\u092f\u093e \u092c\u094b\u0932\u0940 \u0906\u0923\u093f \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0911\u092b\u0930\u094d\u0938 \u0924\u092a\u093e\u0938\u0924 \u0906\u0939\u0947..."},negotiate_offer:{answer:"\u091c\u0947\u0935\u094d\u0939\u093e \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0932\u0949\u091f\u0935\u0930 \u092c\u094b\u0932\u0940 \u0932\u093e\u0935\u0924\u094b, \u0924\u0947\u0935\u094d\u0939\u093e \u0924\u0941\u092e\u094d\u0939\u0940 '\u0921\u0940\u0932\u094d\u0938' \u0935\u093f\u092d\u093e\u0917\u093e\u0924 \u091c\u093e\u090a\u0928 \u0911\u092b\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0942 \u0936\u0915\u0924\u093e \u0915\u093f\u0902\u0935\u093e \u0924\u0941\u092e\u091a\u093e \u0915\u093e\u0909\u0902\u091f\u0930-\u0926\u0930 \u092a\u093e\u0920\u0935\u0942 \u0936\u0915\u0924\u093e."},handover_protocol:{answer:"\u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092e\u093e\u0932 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923\u093e\u0926\u0930\u092e\u094d\u092f\u093e\u0928 \u0915\u0932\u0947\u0915\u094d\u091f\u0930 \u0906\u0923\u093f \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930 \u0935\u091c\u0928\u093e\u091a\u0940 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0915\u0930\u0924\u093e\u0924 \u0906\u0923\u093f \u091c\u0940\u092a\u0940\u090f\u0938 \u0932\u094b\u0915\u0947\u0936\u0928 \u0935 \u0938\u0902\u0926\u0930\u094d\u092d \u0915\u094b\u0921\u0938\u0939 \u0921\u093f\u0932\u093f\u0935\u094d\u0939\u0930\u0940\u091a\u0940 \u092a\u0941\u0937\u094d\u091f\u0940 \u0915\u0930\u0924\u093e\u0924."},handover_qr_code:{answer:"\u0916\u0930\u0947\u0926\u0940\u0926\u093e\u0930\u093e\u0938\u094b\u092c\u0924 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u092a\u0942\u0930\u094d\u0923 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0938\u0915\u094d\u0930\u093f\u092f \u0921\u0940\u0932\u094d\u0938 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930 \u0926\u093f\u0938\u0923\u093e\u0930\u093e \u0921\u093f\u091c\u093f\u091f\u0932 \u0938\u0902\u0926\u0930\u094d\u092d \u0915\u094b\u0921 \u0935\u093e\u092a\u0930\u093e."},payment_methods:{answer:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0939\u0938\u094d\u0924\u093e\u0902\u0924\u0930\u0923\u093e\u0928\u0902\u0924\u0930 \u092a\u0948\u0938\u0947 \u0930\u094b\u0916 (\u0915\u0945\u0936), \u092f\u0942\u092a\u0940\u0906\u092f \u0915\u093f\u0902\u0935\u093e \u0925\u0947\u091f \u092c\u0901\u0915 \u091f\u094d\u0930\u093e\u0928\u094d\u0938\u092b\u0930\u0926\u094d\u0935\u093e\u0930\u0947 \u092a\u0930\u0938\u094d\u092a\u0930 \u0926\u093f\u0932\u0947 \u091c\u093e\u090a \u0936\u0915\u0924\u093e\u0924."},payment_status:{answer:"\u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0935\u0932\u0947\u0932\u094d\u092f\u093e \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0902\u091a\u0940 \u0906\u0923\u093f \u092a\u0947\u092e\u0947\u0902\u091f\u091a\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0924 \u0906\u0939\u0947..."},payment_non_custodial:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0942 \u090f\u0915 \u0928\u0949\u0928-\u0915\u0938\u094d\u091f\u094b\u0921\u093f\u092f\u0932 \u092a\u094d\u0932\u0945\u091f\u092b\u0949\u0930\u094d\u092e \u0906\u0939\u0947 \u091c\u094b \u092a\u0948\u0938\u0947 \u0905\u0921\u0935\u0942\u0928 \u0928 \u0920\u0947\u0935\u0924\u093e \u0915\u0947\u0935\u0933 \u0905\u0927\u093f\u0915\u0943\u0924 \u0935\u094d\u092f\u0935\u0939\u093e\u0930\u093e\u0902\u091a\u0940 \u0928\u094b\u0902\u0926 \u0920\u0947\u0935\u0924\u094b."},view_earnings:{answer:"\u0924\u0941\u092e\u091a\u0940 \u090f\u0915\u0942\u0923 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u092e\u093e\u0908 \u0906\u0923\u093f \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0907\u0924\u093f\u0939\u093e\u0938 \u092e\u093f\u0933\u0935\u0924 \u0906\u0939\u0947..."},safety_battery:{answer:"\u091a\u0947\u0924\u093e\u0935\u0923\u0940: \u092b\u0941\u0917\u0932\u0947\u0932\u0940 \u0932\u093f\u0925\u093f\u092f\u092e-\u0906\u092f\u0928 \u092c\u0945\u091f\u0930\u0940 \u0915\u0927\u0940\u0939\u0940 \u0926\u093e\u092c\u0942 \u0928\u0915\u093e, \u092b\u094b\u0921\u0942 \u0928\u0915\u093e \u0915\u093f\u0902\u0935\u093e \u092a\u093e\u0923\u0940 \u0935 \u0909\u0937\u094d\u0923\u0924\u0947\u091a\u094d\u092f\u093e \u0938\u0902\u092a\u0930\u094d\u0915\u093e\u0924 \u0906\u0923\u0942 \u0928\u0915\u093e. \u0924\u0940 \u0915\u094b\u0930\u0921\u094d\u092f\u093e \u0921\u092c\u094d\u092f\u093e\u0924 \u0920\u0947\u0935\u093e."},safety_burning:{answer:"\u0927\u094b\u0915\u093e: \u0924\u093e\u0902\u092c\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0915\u0947\u092c\u0932\u094d\u0938 \u0915\u093f\u0902\u0935\u093e \u092a\u094d\u0932\u093e\u0938\u094d\u091f\u093f\u0915 \u0915\u0927\u0940\u0939\u0940 \u091c\u093e\u0933\u0942 \u0928\u0915\u093e. \u0909\u0918\u0921\u094d\u092f\u093e\u0935\u0930 \u091c\u093e\u0933\u0932\u094d\u092f\u093e\u0928\u0947 \u0935\u093f\u0937\u093e\u0930\u0940 \u0927\u0942\u0930 \u0906\u0923\u093f \u0936\u093f\u0938\u0947 \u092c\u093e\u0939\u0947\u0930 \u092a\u0921\u0924\u0947. \u092b\u0915\u094d\u0924 \u0905\u0927\u093f\u0915\u0943\u0924 \u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930\u0932\u093e \u0935\u093f\u0915\u093e."},safety_acid:{answer:"\u0917\u0902\u092d\u0940\u0930 \u0927\u094b\u0915\u093e: \u0938\u094b\u0928\u0947 \u0915\u093e\u0922\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0918\u0930\u0940 \u0972\u0938\u093f\u0921 \u0915\u093f\u0902\u0935\u093e \u0930\u0938\u093e\u092f\u0928\u0947 \u0935\u093e\u092a\u0930\u0942 \u0928\u0915\u093e. \u0938\u093e\u092f\u0928\u093e\u0908\u0921 \u0906\u0923\u093f \u0972\u0938\u093f\u0921\u092e\u0941\u0933\u0947 \u092a\u094d\u0930\u093e\u0923\u0918\u093e\u0924\u0915 \u0935\u093f\u0937\u092c\u093e\u0927\u093e \u0939\u094b\u0924\u0947 \u0906\u0923\u093f \u092a\u093e\u0923\u0940 \u0926\u0942\u0937\u093f\u0924 \u0939\u094b\u0924\u0947."},safety_ppe:{answer:"\u0908-\u0915\u091a\u0930\u093e \u0939\u093e\u0924\u093e\u0933\u0924\u093e\u0928\u093e \u0928\u0947\u0939\u092e\u0940 \u091c\u093e\u0921 \u0939\u093e\u0924\u092e\u094b\u091c\u0947, \u092e\u093e\u0938\u094d\u0915 \u0906\u0923\u093f \u0921\u094b\u0933\u094d\u092f\u093e\u0902\u091a\u0947 \u0938\u0902\u0930\u0915\u094d\u0937\u0923 \u0915\u0930\u0923\u093e\u0930\u0947 \u091a\u0937\u094d\u092e\u0947 \u0935\u093e\u092a\u0930\u093e."},safety_crt:{answer:"\u0916\u092c\u0930\u0926\u093e\u0930\u0940: \u091c\u0941\u0928\u0947 \u091f\u0940\u0935\u094d\u0939\u0940 \u0906\u0923\u093f \u0938\u0940\u0906\u0930\u091f\u0940 \u092e\u0949\u0928\u093f\u091f\u0930 \u0928\u093e\u091c\u0942\u0915 \u0905\u0938\u0924\u093e\u0924 \u0906\u0923\u093f \u0924\u094d\u092f\u093e\u0924 \u0935\u093f\u0937\u093e\u0930\u0940 \u0936\u093f\u0938\u0947 \u0905\u0938\u0924\u0947. \u0938\u0940\u0906\u0930\u091f\u0940 \u0915\u093e\u091a \u0915\u0927\u0940\u0939\u0940 \u092b\u094b\u0921\u0942 \u0928\u0915\u093e."},report_dispute:{answer:"\u0935\u091c\u0928\u093e\u0924 \u0924\u092b\u093e\u0935\u0924 \u0915\u093f\u0902\u0935\u093e \u092a\u0948\u0936\u093e\u0902\u091a\u0940 \u0915\u092e\u0924\u0930\u0924\u093e \u0905\u0938\u0932\u094d\u092f\u093e\u0938, \u0924\u0941\u092e\u094d\u0939\u0940 \u092b\u094b\u091f\u094b \u092a\u0941\u0930\u093e\u0935\u094d\u092f\u093e\u0938\u0939 \u0924\u094d\u0935\u0930\u093f\u0924 \u0924\u0915\u094d\u0930\u093e\u0930 \u0924\u093f\u0915\u0940\u091f \u0928\u094b\u0902\u0926\u0935\u0942 \u0936\u0915\u0924\u093e."},dispute_policy:{answer:"\u0924\u0915\u094d\u0930\u093e\u0930\u0940\u0902\u091a\u0940 \u091a\u094c\u0915\u0936\u0940 \u0907\u0915\u094b\u0938\u0947\u0924\u0942 \u0972\u0921\u092e\u093f\u0928\u0926\u094d\u0935\u093e\u0930\u0947 \u0926\u094b\u0928\u094d\u0939\u0940 \u092c\u093e\u091c\u0942\u0902\u091a\u0947 \u0911\u0921\u093f\u091f \u0932\u0949\u0917, \u091c\u0940\u092a\u0940\u090f\u0938 \u0906\u0923\u093f \u092a\u093e\u0935\u0924\u094d\u092f\u093e \u0924\u092a\u093e\u0938\u0942\u0928 \u0915\u0947\u0932\u0940 \u091c\u093e\u0924\u0947."},recycler_verification:{answer:"\u0930\u0940\u0938\u093e\u092f\u0915\u0932\u0930\u094d\u0938\u0928\u093e \u0907\u0915\u094b\u0938\u0947\u0924\u0942\u0935\u0930 \u0932\u0949\u091f\u094d\u0938 \u0916\u0930\u0947\u0926\u0940 \u0915\u0930\u0923\u094d\u092f\u093e\u092a\u0942\u0930\u094d\u0935\u0940 \u0935\u0948\u0927 \u0938\u0940\u092a\u0940\u0938\u0940\u092c\u0940/\u090f\u0938\u092a\u0940\u0938\u0940\u092c\u0940 \u092a\u0930\u0935\u093e\u0928\u093e \u0906\u0923\u093f \u091c\u0940\u090f\u0938\u091f\u0940 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0926\u0947\u0923\u0947 \u092c\u0902\u0927\u0928\u0915\u093e\u0930\u0915 \u0906\u0939\u0947."},green_certificate:{answer:"\u092f\u0936\u0938\u094d\u0935\u0940\u0930\u093f\u0924\u094d\u092f\u093e \u092a\u0941\u0928\u0930\u094d\u091a\u0915\u094d\u0930\u093f\u0924 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0908-\u0915\u091a\u0931\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0927\u093f\u0915\u0943\u0924 \u0917\u094d\u0930\u0940\u0928 \u0938\u0930\u094d\u091f\u093f\u092b\u093f\u0915\u0947\u091f \u0906\u0923\u093f \u0935\u093e\u091a\u0935\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u093e\u0930\u094d\u092c\u0928 \u0909\u0924\u094d\u0938\u0930\u094d\u091c\u0928\u093e\u091a\u0940 (CO2) \u0928\u094b\u0902\u0926 \u092e\u093f\u0933\u0924\u0947."},offline_mode:{answer:"\u0907\u0915\u094b\u0938\u0947\u0924\u0942 \u0911\u092b\u0932\u093e\u0907\u0928 \u0926\u0947\u0916\u0940\u0932 \u091a\u093e\u0932\u0924\u094b! \u0924\u0941\u092e\u094d\u0939\u0940 \u0907\u0902\u091f\u0930\u0928\u0947\u091f\u0936\u093f\u0935\u093e\u092f \u0932\u0949\u091f \u0924\u092f\u093e\u0930 \u0915\u0930\u0942 \u0936\u0915\u0924\u093e; \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0906\u0932\u094d\u092f\u093e\u0935\u0930 \u0921\u0947\u091f\u093e \u0906\u092a\u094b\u0906\u092a \u0938\u093f\u0902\u0915 \u0939\u094b\u0908\u0932."},change_language:{answer:"\u0924\u0941\u092e\u094d\u0939\u0940 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932\u092e\u0927\u0942\u0928 \u0915\u0947\u0935\u094d\u0939\u093e\u0939\u0940 \u0907\u0902\u0917\u094d\u0930\u091c\u0940, \u0939\u093f\u0902\u0926\u0940, \u092e\u0930\u093e\u0920\u0940 \u0915\u093f\u0902\u0935\u093e \u0909\u0921\u093f\u092f\u093e \u092d\u093e\u0937\u093e \u0928\u093f\u0935\u0921\u0942 \u0936\u0915\u0924\u093e."},profile_settings:{answer:"\u0924\u0941\u092e\u094d\u0939\u0940 \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0935\u0930\u0942\u0928 \u0924\u0941\u092e\u091a\u0947 \u0928\u093e\u0935, \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u094d\u0930\u092e\u093e\u0902\u0915 \u0906\u0923\u093f \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0942 \u0936\u0915\u0924\u093e."},verification_status:{answer:"\u0972\u0921\u092e\u093f\u0928\u0915\u0921\u0947 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0916\u093e\u0924\u094d\u092f\u093e\u091a\u0940 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0938\u094d\u0925\u093f\u0924\u0940 \u0924\u092a\u093e\u0938\u0924 \u0906\u0939\u0947..."},unknown:{answer:"\u092e\u093e\u091d\u094d\u092f\u093e\u0915\u0921\u0947 \u092f\u093e\u0938\u093e\u0920\u0940 \u092a\u0921\u0924\u093e\u0933\u0932\u0947\u0932\u0947 \u0909\u0924\u094d\u0924\u0930 \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u0938\u094d\u0915\u094d\u0930\u0945\u092a\u091a\u0947 \u092d\u093e\u0935, \u0932\u0949\u091f \u0924\u092f\u093e\u0930 \u0915\u0930\u0923\u0947, \u0935\u094d\u092f\u0935\u0939\u093e\u0930, \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u093f\u0902\u0935\u093e \u092d\u093e\u0937\u093e \u092c\u0926\u0932\u0923\u094d\u092f\u093e\u092c\u0926\u094d\u0926\u0932 \u0935\u093f\u091a\u093e\u0930\u093e."}}}}},481,[]);
