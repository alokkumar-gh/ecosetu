tus} \u0920\u0940\u0915 ({latency}ms \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e)",backendApiUnreachable:"\u092c\u0948\u0915\u090f\u0902\u0921 \u0938\u0947\u0935\u093e \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u092f\u093e \u0938\u092e\u092f \u0938\u092e\u093e\u092a\u094d\u0924",backendApiOffline:"\u0921\u093f\u0935\u093e\u0907\u0938 \u0911\u092b\u093c\u0932\u093e\u0907\u0928 \u0939\u0948; \u092c\u0948\u0915\u090f\u0902\u0921 \u0924\u0915 \u0928\u0939\u0940\u0902 \u092a\u0939\u0941\u0902\u091a\u093e \u091c\u093e \u0938\u0915\u0924\u093e",databaseTitle:"\u0921\u0947\u091f\u093e\u092c\u0947\u0938 (PostgreSQL / Neon)",databaseDesc:"ACID \u091f\u094d\u0930\u093e\u0902\u091c\u0947\u0915\u094d\u0936\u0928\u0932 \u0938\u094d\u0925\u093f\u0924\u093f \u0939\u0947\u0924\u0941 \u0930\u093f\u0932\u0947\u0936\u0928\u0932 \u0921\u0947\u091f\u093e\u092c\u0947\u0938\u0964",databaseExplanation:"\u092c\u0948\u0915\u090f\u0902\u0921 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u091c\u093e\u0902\u091a \u0938\u0915\u094d\u0930\u093f\u092f \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u092a\u093f\u0902\u0917 \u0915\u094b \u092a\u094d\u0930\u0915\u091f \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u092e\u094b\u092c\u093e\u0907\u0932 \u0938\u0947 \u0938\u0940\u0927\u093e \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u0928\u093f\u0937\u093f\u0926\u094d\u0927 \u0939\u0948\u0964",aiServiceTitle:"\u090f\u0906\u0908 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u0938\u0930\u094d\u0935\u093f\u0938",aiServiceDesc:"\u0908-\u0915\u091a\u0930\u093e \u0936\u094d\u0930\u0947\u0923\u0940 \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0939\u0947\u0924\u0941 \u0935\u093f\u091c\u093c\u0928 \u092e\u0949\u0921\u0932 \u0905\u0928\u0941\u092e\u093e\u0928\u0964",aiServiceExplanation:"\u090f\u0906\u0908 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u0938\u0930\u0