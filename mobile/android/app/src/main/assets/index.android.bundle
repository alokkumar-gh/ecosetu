on:"\u0938\u0942\u091a\u0928\u093e \u0935\u093e\u092a\u0930\u093e",chooseManually:"\u0938\u094d\u0935\u0924\u0903 \u0928\u093f\u0935\u0921\u093e",checkingPhoto:"\u092b\u094b\u091f\u094b \u0924\u092a\u093e\u0938\u0924 \u0906\u0939\u0947...",aiProcessingTimeNotice:"\u0930\u0947\u0902\u0921\u0930 \u0915\u094d\u0932\u093e\u0909\u0921\u0935\u0930 AI \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923\u093e\u0938\u093e\u0920\u0940 \u090f\u0915 \u092e\u093f\u0928\u093f\u091f\u093e\u092a\u0930\u094d\u092f\u0902\u0924 \u0935\u0947\u0933 \u0932\u093e\u0917\u0942 \u0936\u0915\u0924\u094b...",suggestionUnavailable:"\u090f\u0906\u092f \u0938\u0947\u0935\u093e \u0924\u093e\u0924\u094d\u092a\u0941\u0930\u0924\u0940 \u0905\u0928\u0941\u092a\u0932\u092c\u094d\u0927 \u0906\u0939\u0947. \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u094d\u0935\u0924\u0903 \u0928\u093f\u0935\u0921\u093e.",serviceUnavailableTitle:"\u090f\u0906\u092f \u0938\u0947\u0935\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u093e\u0939\u0940",couldNotIdentify:"\u0939\u0940 \u0935\u0938\u094d\u0924\u0942 \u0913\u0933\u0916\u0924\u093e \u0906\u0932\u0940 \u0928\u093e\u0939\u0940",couldNotConfidentlyIdentify:"\u0906\u0924\u094d\u092e\u0935\u093f\u0936\u094d\u0935\u093e\u0938\u093e\u0928\u0947 \u0913\u0933\u0916\u0924\u093e \u0906\u0932\u0947 \u0928\u093e\u0939\u0940",noMatchingEwaste:"\u0915\u094b\u0923\u0924\u093e\u0939\u0940 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0908-\u0915\u091a\u0930\u093e \u0906\u0922\u0933\u0932\u093e \u0928\u093e\u0939\u0940. \u0915\u0943\u092a\u092f\u093e \u0936\u094d\u0930\u0947\u0923\u0940 \u0938\u094d\u0935\u0924\u0903 \u0928\u093f\u0935\u0921\u093e.",manualVerificationNeeded:"\u092e\u0945\u0928\u094d\u092f\u0941\u0905\u0932 \u092a\u0921\u0924\u093e\u0933\u0923\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0906\u0939\u0947",matchConfidence:"{percent}% \u091c\u0941\u0933\u0923\u0940",aiTimeoutError:"AI \u0935\u093f\u0928\u0902\u0924\u0940\u091a\u0940 \u0935\u0947\u0933 \u0938\u09