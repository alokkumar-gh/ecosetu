u0b30\u0b3f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41",view_my_lots:"\u0b2e\u0b4b \u0b32\u0b1f\u0b4d \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41",citizen_submit:"\u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b26\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41",view_requests:"\u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27 \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41",open_marketplace:"\u0b2e\u0b3e\u0b30\u0b4d\u0b15\u0b47\u0b1f\u0b2a\u0b4d\u0b32\u0b47\u0b38\u0b4d \u0b16\u0b4b\u0b1c\u0b28\u0b4d\u0b24\u0b41",open_deals:"\u0b21\u0b3f\u0b32\u0b4d \u0b0f\u0b2c\u0b02 \u0b05\u0b2b\u0b30\u0b4d \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41",view_transactions:"\u0b15\u0b3e\u0b30\u0b2c\u0b3e\u0b30 \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41",open_earnings:"\u0b2e\u0b4b \u0b30\u0b4b\u0b1c\u0b17\u0b3e\u0b30 \u0b16\u0b4b\u0b32\u0b28\u0b4d\u0b24\u0b41",open_safety_center:"\u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30 \u0b16\u0b4b\u0b32\u0b28\u0b4d\u0b24\u0b41",view_traceability:"\u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23\u0b2a\u0b24\u0b4d\u0b30 \u0b0f\u0b2c\u0b02 \u0b2a\u0b4d\u0b30\u0b2d\u0b3e\u0b2c \u0b26\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41",open_language_settings:"\u0b2d\u0b3e\u0b37\u0b3e \u0b2c\u0b26\u0b33\u0b3e\u0b28\u0b4d\u0b24\u0b41",open_profile:"\u0b2a\u0b4d\u0b30\u0b4b\u0b2b\u0b3e\u0b07\u0b32\u0b4d \u0b38\u0b47\u0b1f\u0b3f\u0b02 \u0b16\u0b4b\u0b32\u0b28\u0b4d\u0b24\u0b41"},intents:{who_is_eco_saathi:{answer:"\u0b28\u0b2e\u0b38\u0b4d\u0b15\u0b3e\u0b30! \u0b2e\u0b41\u0b01 \u0b07\u0b15\u0b4b-\u0b38\u0b3e\u0b25\u0b40, \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41 \u0b38\u0b39\u0b3e\u0b5f\u0b15\u0964 \u0b2e\u0b41\u0b01 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15\u0b41 \u0b2d\u0b19\u0b4d\u0b17\u0b3e\u0b30\u0b41\u0b1c\u0b3e \u0b2c\u0b3f\u0b15\u0b4d\u0b30\u0b3f, \u0b26\u0b30 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a, \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b28\u0b3f\u0b5f\u0b2e \u0b2c\u0b41\u0b1d\u0b3f\u0b2c\u0b3e \u0b0f\u0b2c\u0b02 \u0b15\u0b3e\u0b30\u0b2c\u0b3e\u0b30 \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b28\u0b3e\u0b30\u0b47 \u0b38\u0b3e\u0b39\u0b3e\u0b2f\u0b4d\u0b5f \u0b15\u0b30\u0b47\u0964"},what_is_ecosetu:{answer:"\u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41 \u0b28\u0b3e\u0b17\u0b30\u0b3f\u0b15, \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b15\u0b2c\u0b3e\u0b21\u0b3f\u0b2c\u0b3e\u0b32\u0b3e \u0b0f\u0b2c\u0b02 \u0b38\u0b4d\u0b71\u0b40\u0b15\u0b43\u0b24\u0b3f\u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b24 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b41 \u0b2f\u0b4b\u0b21\u0b3c\u0b3f \u0b0f\u0b15 \u0b28\u0b3f\u0b30\u0b3e\u0b2a\u0b26, \u0b38\u0b4d\u0b71\u0b1a\u0b4d\u0b1b \u0b0f\u0b2c\u0b02 \u0b06\u0b28\u0b41\u0b37\u0b4d\u0b20\u0b3e\u0b28\u0b3f\u0b15 \u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b2e\u0b42\u0b32\u0b4d\u0b5f \u0b36\u0b43\u0b19\u0b4d\u0b16\u0b33\u0b3e \u0b17\u0b20\u0b28 \u0b15\u0b30\u0b47\u0964"},support_help:{answer:"\u0b1c\u0b30\u0b41\u0b30\u0b40 \u0b38\u0b39\u0b3e\u0b5f\u0b24\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b2a\u0b23 \u0b2c\u0b3f\u0b2c\u0b3e\u0b26 \u0b13 \u0b38\u0b39\u0b3e\u0b5f\u0b24\u0b3e \u0b15\u0b47\u0b28\u0b4d\u0b26\u0b4d\u0b30\u0b30\u0b47 \u0b05\u0b2d\u0b3f\u0b2f\u0b4b\u0b17 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e support@ecosetu.org \u0b30\u0b47 \u0b2f\u0b4b\u0b17\u0b3e\u0b2f\u0b4b\u0b17 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},ai_classes:{answer:"\u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41 \u0b0f\u0b06\u0b07 \u0b15\u0b4d\u0b5f\u0b3e\u0b2e\u0b47\u0b30\u0b3e \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b2b\u0b4b\u0b28\u0b4d, \u0b1f\u0b3e\u0b2c\u0b32\u0b47\u0b1f\u0b4d \u0b0f\u0b2c\u0b02 \u0b15\u0b3f\u0b2c\u0b4b\u0b30\u0b4d\u0b21/\u0b2e\u0b3e\u0b09\u0b38\u0b4d \u0b38\u0b4d\u0b71\u0b24\u0b03 \u0b1a\u0b3f\u0b39\u0b4d\u0b28\u0b1f \u0b15\u0b30\u0b47\u0964 \u0b05\u0b28\u0b4d\u0b5f \u0b67\u0b69\u0b1f\u0b3f \u0b2c\u0b30\u0b4d\u0b17 (\u0b2a\u0b3f\u0b38\u0b3f\u0b2c\u0b3f, \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40, \u0b24\u0b3e\u0b30 \u0b07\u0b24\u0b4d\u0b5f\u0b3e\u0b26\u0b3f) \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b2a\u0b23 \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e\u0b30\u0b41 \u0b38\u0b39\u0b1c\u0b30\u0b47 \u0b2c\u0b3e\u0b1b\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},ai_manual_selection:{answer:"\u0b2f\u0b26\u0b3f \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b0f\u0b06\u0b07 \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b1a\u0b3f\u0b39\u0b4d\u0b28\u0b1f \u0b39\u0b4b\u0b07\u0b28\u0b2a\u0b3e\u0b30\u0b47, \u0b24\u0b47\u0b2c\u0b47 \u0b21\u0b4d\u0b30\u0b2a\u0b21\u0b3e\u0b09\u0b28\u0b4d \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e\u0b30\u0b41 \u0b09\u0b2a\u0b2f\u0b41\u0b15\u0b4d\u0b24 \u0b2c\u0b30\u0b4d\u0b17 \u0b2c\u0b3e\u0b1b\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b06\u0b28\u0b41\u0b2e\u0b3e\u0b28\u0b3f\u0b15 \u0b13\u0b1c\u0b28 \u0b32\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964"},ai_accuracy:{answer:"\u0b0f\u0b06\u0b07 \u0b1a\u0b3f\u0b39\u0b4d\u0b28\u0b1f \u0b15\u0b47\u0b2c\u0b33 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b41\u0b2c\u0b3f\u0b27\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b0f\u0b15 \u0b38\u0b39\u0b3e\u0b5f\u0b15 \u0b2c\u0b4d\u0b5f\u0b2c\u0b38\u0b4d\u0b25\u0b3e\u0964 \u0b0f\u0b39\u0b3e \u0b1a\u0b42\u0b21\u0b3c\u0b3e\u0b28\u0b4d\u0b24 \u0b2e\u0b42\u0b32\u0b4d\u0b5f \u0b38\u0b4d\u0b25\u0b3f\u0b30 \u0b15\u0b30\u0b47 \u0b28\u0b3e\u0b39\u0b3f\u0b01; \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2a\u0b3e\u0b16\u0b30\u0b47 \u0b2c\u0b3f\u0b2c\u0b30\u0b23\u0b40 \u0b38\u0b02\u0b36\u0b4b\u0b27\u0b28 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b30 \u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b05\u0b27\u0b3f\u0b15\u0b3e\u0b30 \u0b05\u0b1b\u0b3f\u0964"},price_board:{answer:"\u0b06\u0b2a\u0b23 \u0b2a\u0b4d\u0b30\u0b3e\u0b07\u0b38\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21\u0b30\u0b47 \u0b2c\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b2e\u0b3e\u0b28\u0b30 \u0b2c\u0b47\u0b1e\u0b4d\u0b1a\u0b2e\u0b3e\u0b30\u0b4d\u0b15 \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3e\u0b2a\u0b4d \u0b26\u0b30 \u0b26\u0b47\u0b16\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964 \u0b0f\u0b39\u0b3f \u0b26\u0b30 \u0b06\u0b1e\u0b4d\u0b1a\u0b33\u0b3f\u0b15 \u0b1a\u0b3e\u0b39\u0b3f\u0b26\u0b3e \u0b05\u0b28\u0b41\u0b2f\u0b3e\u0b5f\u0b40 \u0b05\u0b2a\u0b21\u0b47\u0b1f\u0b4d \u0b39\u0b41\u0b0f\u0964"},todays_price:{answer:"\u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3e\u0b2a\u0b4d \u0b26\u0b30 \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40\u0b30 \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b30 \u0b0f\u0b2c\u0b02 \u0b36\u0b41\u0b26\u0b4d\u0b27\u0b24\u0b3e \u0b09\u0b2a\u0b30\u0b47 \u0b28\u0b3f\u0b30\u0b4d\u0b2d\u0b30 \u0b15\u0b30\u0b47\u0964 \u0b38\u0b3f\u0b27\u0b3e\u0b38\u0b33\u0b16 \u0b2c\u0b1c\u0b3e\u0b30 \u0b26\u0b30 \u0b26\u0b47\u0b16\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b2a\u0b4d\u0b30\u0b3e\u0b07\u0b38\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21 \u0b16\u0b4b\u0b32\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f..."},price_determination:{answer:"\u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41\u0b30\u0b47 \u0b26\u0b30 \u0b15\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b30 \u0b0f\u0b2c\u0b02 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30 \u0b2e\u0b27\u0b4d\u0b5f\u0b30\u0b47 \u0b2a\u0b3e\u0b30\u0b38\u0b4d\u0b2a\u0b30\u0b3f\u0b15 \u0b06\u0b32\u0b4b\u0b1a\u0b28\u0b3e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b38\u0b4d\u0b25\u0b3f\u0b30 \u0b39\u0b41\u0b0f, \u0b2f\u0b47\u0b09\u0b01\u0b25\u0b3f\u0b30\u0b47 \u0b2a\u0b4d\u0b30\u0b3e\u0b07\u0b38\u0b4d \u0b2c\u0b4b\u0b30\u0b4d\u0b21 \u0b0f\u0b15 \u0b38\u0b4d\u0b71\u0b1a\u0b4d\u0b1b \u0b38\u0b42\u0b1a\u0b15 \u0b2d\u0b3e\u0b2c\u0b30\u0b47 \u0b15\u0b3e\u0b30\u0b4d\u0b2f\u0b4d\u0b5f \u0b15\u0b30\u0b47\u0964"},how_to_create_lot:{answer:"\u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b2c\u0b3f\u0b15\u0b4d\u0b30\u0b3f \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 '\u0b2c\u0b3f\u0b15\u0b4d\u0b30\u0b3f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41' \u0b09\u0b2a\u0b30\u0b47 \u0b1f\u0b4d\u0b5f\u0b3e\u0b2a\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41, \u0b38\u0b3e\u0b2e\u0b17\u0b4d\u0b30\u0b40 \u0b2c\u0b3e\u0b1b\u0b28\u0b4d\u0b24\u0b41, \u0b0f\u0b06\u0b07 \u0b15\u0b4d\u0b5f\u0b3e\u0b2e\u0b47\u0b30\u0b3e\u0b30\u0b47 \u0b2b\u0b1f\u0b4b \u0b09\u0b20\u0b3e\u0b28\u0b4d\u0b24\u0b41, \u0b13\u0b1c\u0b28 \u0b32\u0b47\u0b16\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b32\u0b1f\u0b4d \u0b2a\u0b4d\u0b30\u0b15\u0b3e\u0b36 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964"},my_lots_status:{answer:"\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b38\u0b15\u0b4d\u0b30\u0b3f\u0b5f \u0b32\u0b1f\u0b4d \u0b0f\u0b2c\u0b02 \u0b24\u0b3e\u0b32\u0b3f\u0b15\u0b3e\u0b30 \u0b38\u0b4d\u0b25\u0b3f\u0b24\u0b3f \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f..."},lot_categories:{answer:"\u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41 \u0b67\u0b6c\u0b1f\u0b3f \u0b2e\u0b3e\u0b28\u0b15 \u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b2c\u0b30\u0b4d\u0b17\u0b15\u0b41 \u0b38\u0b2e\u0b30\u0b4d\u0b25\u0b28 \u0b15\u0b30\u0b47, \u0b2f\u0b47\u0b09\u0b01\u0b25\u0b3f\u0b30\u0b47 \u0b2a\u0b3f\u0b38\u0b3f\u0b2c\u0b3f, \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40, \u0b24\u0b3e\u0b30, \u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f, \u0b0f\u0b32\u0b38\u0b3f\u0b21\u0b3f, \u0b2e\u0b4b\u0b2c\u0b3e\u0b07\u0b32\u0b4d \u0b0f\u0b2c\u0b02 \u0b32\u0b3e\u0b2a\u0b1f\u0b2a\u0b4d \u0b05\u0b28\u0b4d\u0b24\u0b30\u0b4d\u0b2d\u0b41\u0b15\u0b4d\u0b24\u0964"},citizen_give_ewaste:{answer:"\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2a\u0b41\u0b30\u0b41\u0b23\u0b3e \u0b07\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b4d\u0b30\u0b4b\u0b28\u0b3f\u0b15\u0b4d\u0b38 \u0b26\u0b47\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 '\u0b26\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b41' \u0b09\u0b2a\u0b30\u0b47 \u0b1f\u0b4d\u0b5f\u0b3e\u0b2a\u0b4d \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41, \u0b2b\u0b1f\u0b4b \u0b09\u0b20\u0b3e\u0b28\u0b4d\u0b24\u0b41, \u0b20\u0b3f\u0b15\u0b23\u0b3e \u0b2c\u0b3e\u0b1b\u0b28\u0b4d\u0b24\u0b41 \u0b0f\u0b2c\u0b02 \u0b38\u0b4d\u0b25\u0b3e\u0b28\u0b40\u0b5f \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a\u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b24 \u0b15\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b30 \u0b24\u0b3e\u0b39\u0b3e \u0b38\u0b02\u0b17\u0b4d\u0b30\u0b39 \u0b15\u0b30\u0b3f\u0b2c\u0b3e\u0b15\u0b41 \u0b06\u0b38\u0b3f\u0b2c\u0b47\u0964"},citizen_requests_status:{answer:"\u0b06\u0b2a\u0b23 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b2a\u0b3f\u0b15\u0b05\u0b2a\u0b4d \u0b05\u0b28\u0b41\u0b30\u0b4b\u0b27\u0b30 \u0b38\u0b4d\u0b25\u0b3f\u0b24\u0b3f \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f..."},marketplace_browse:{answer:"\u0b38\u0b4d\u0b71\u0b40\u0b15\u0b43\u0b24\u0b3f\u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b24 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30\u0b2e\u0b3e\u0b28\u0b47 \u0b2e\u0b3e\u0b30\u0b4d\u0b15\u0b47\u0b1f\u0b2a\u0b4d\u0b32\u0b47\u0b38\u0b30\u0b47 \u0b09\u0b2a\u0b32\u0b2c\u0b4d\u0b27 \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3e\u0b2a\u0b4d \u0b32\u0b1f\u0b4d \u0b26\u0b47\u0b16\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b0f\u0b2c\u0b02 \u0b38\u0b3f\u0b27\u0b3e\u0b38\u0b33\u0b16 \u0b15\u0b4d\u0b30\u0b5f \u0b2c\u0b3f\u0b21\u0b4d \u0b26\u0b47\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},view_offers:{answer:"\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b32\u0b1f\u0b4d \u0b2a\u0b3e\u0b07\u0b01 \u0b06\u0b38\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b2c\u0b3f\u0b21\u0b4d \u0b0f\u0b2c\u0b02 \u0b05\u0b2b\u0b30\u0b4d \u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f..."},negotiate_offer:{answer:"\u0b2f\u0b47\u0b24\u0b47\u0b2c\u0b47\u0b33\u0b47 \u0b1c\u0b23\u0b47 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30 \u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b32\u0b1f\u0b4d \u0b09\u0b2a\u0b30\u0b47 \u0b2c\u0b3f\u0b21\u0b4d \u0b26\u0b3f\u0b05\u0b28\u0b4d\u0b24\u0b3f, \u0b06\u0b2a\u0b23 '\u0b21\u0b3f\u0b32\u0b4d' \u0b2c\u0b3f\u0b2d\u0b3e\u0b17\u0b30\u0b47 \u0b2f\u0b3e\u0b07 \u0b05\u0b2b\u0b30\u0b4d \u0b17\u0b4d\u0b30\u0b39\u0b23 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b28\u0b3f\u0b1c\u0b30 \u0b15\u0b3e\u0b09\u0b23\u0b4d\u0b1f\u0b30-\u0b30\u0b47\u0b1f\u0b4d \u0b2a\u0b20\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},handover_protocol:{answer:"\u0b2a\u0b4d\u0b30\u0b24\u0b4d\u0b5f\u0b15\u0b4d\u0b37 \u0b2e\u0b3e\u0b32 \u0b39\u0b38\u0b4d\u0b24\u0b3e\u0b28\u0b4d\u0b24\u0b30 \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b15\u0b32\u0b47\u0b15\u0b4d\u0b1f\u0b30 \u0b0f\u0b2c\u0b02 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30 \u0b13\u0b1c\u0b28 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b3f \u0b0f\u0b2c\u0b02 \u0b1c\u0b3f\u0b2a\u0b3f\u0b0f\u0b38 \u0b32\u0b4b\u0b15\u0b47\u0b38\u0b28 \u0b13 \u0b30\u0b47\u0b2b\u0b30\u0b47\u0b28\u0b4d\u0b38 \u0b15\u0b4b\u0b21\u0b4d \u0b38\u0b39\u0b3f\u0b24 \u0b21\u0b47\u0b32\u0b3f\u0b2d\u0b30\u0b40 \u0b28\u0b3f\u0b36\u0b4d\u0b1a\u0b3f\u0b24 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b3f\u0964"},handover_qr_code:{answer:"\u0b15\u0b4d\u0b30\u0b47\u0b24\u0b3e\u0b19\u0b4d\u0b15 \u0b38\u0b39\u0b3f\u0b24 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b38\u0b2e\u0b4d\u0b2a\u0b42\u0b30\u0b4d\u0b23\u0b4d\u0b23 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b38\u0b15\u0b4d\u0b30\u0b3f\u0b5f \u0b21\u0b3f\u0b32\u0b4d \u0b38\u0b4d\u0b15\u0b4d\u0b30\u0b3f\u0b28\u0b30\u0b47 \u0b26\u0b47\u0b16\u0b3e\u0b2f\u0b3e\u0b09\u0b25\u0b3f\u0b2c\u0b3e \u0b21\u0b3f\u0b1c\u0b3f\u0b1f\u0b3e\u0b32\u0b4d \u0b30\u0b47\u0b2b\u0b30\u0b47\u0b28\u0b4d\u0b38 \u0b15\u0b4b\u0b21\u0b4d \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964"},payment_methods:{answer:"\u0b2f\u0b3e\u0b1e\u0b4d\u0b1a\u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b24 \u0b39\u0b38\u0b4d\u0b24\u0b3e\u0b28\u0b4d\u0b24\u0b30 \u0b2a\u0b30\u0b47 \u0b1f\u0b19\u0b4d\u0b15\u0b3e \u0b28\u0b17\u0b26 (\u0b15\u0b4d\u0b5f\u0b3e\u0b36\u0b4d), \u0b5f\u0b41\u0b2a\u0b3f\u0b06\u0b07 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2c\u0b4d\u0b5f\u0b3e\u0b19\u0b4d\u0b15 \u0b1f\u0b4d\u0b30\u0b3e\u0b28\u0b4d\u0b38\u0b2b\u0b30 \u0b2e\u0b3e\u0b27\u0b4d\u0b5f\u0b2e\u0b30\u0b47 \u0b38\u0b3f\u0b27\u0b3e\u0b38\u0b33\u0b16 \u0b2a\u0b48\u0b20 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b07\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0964"},payment_status:{answer:"\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b30\u0b47\u0b15\u0b30\u0b4d\u0b21 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b15\u0b3e\u0b30\u0b2c\u0b3e\u0b30 \u0b0f\u0b2c\u0b02 \u0b2a\u0b47\u0b2e\u0b47\u0b23\u0b4d\u0b1f \u0b38\u0b4d\u0b25\u0b3f\u0b24\u0b3f \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f..."},payment_non_custodial:{answer:"\u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41 \u0b0f\u0b15 \u0b28\u0b28\u0b4d-\u0b15\u0b37\u0b4d\u0b1f\u0b4b\u0b21\u0b3f\u0b06\u0b32\u0b4d \u0b2a\u0b4d\u0b32\u0b3e\u0b1f\u0b2b\u0b30\u0b4d\u0b2e \u0b2f\u0b3e\u0b39\u0b3e \u0b1f\u0b19\u0b4d\u0b15\u0b3e \u0b05\u0b1f\u0b15\u0b3e\u0b07 \u0b28\u0b30\u0b16\u0b3f \u0b15\u0b47\u0b2c\u0b33 \u0b06\u0b28\u0b41\u0b37\u0b4d\u0b20\u0b3e\u0b28\u0b3f\u0b15 \u0b15\u0b3e\u0b30\u0b2c\u0b3e\u0b30\u0b30 \u0b05\u0b21\u0b3f\u0b1f\u0b4d \u0b30\u0b47\u0b15\u0b30\u0b4d\u0b21 \u0b30\u0b16\u0b47\u0964"},view_earnings:{answer:"\u0b06\u0b2a\u0b23\u0b19\u0b4d\u0b15 \u0b2e\u0b4b\u0b1f \u0b38\u0b24\u0b4d\u0b5f\u0b3e\u0b2a\u0b3f\u0b24 \u0b30\u0b4b\u0b1c\u0b17\u0b3e\u0b30 \u0b0f\u0b2c\u0b02 \u0b15\u0b3e\u0b30\u0b2c\u0b3e\u0b30 \u0b07\u0b24\u0b3f\u0b39\u0b3e\u0b38 \u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b24 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b09\u0b1b\u0b3f..."},safety_battery:{answer:"\u0b1a\u0b47\u0b24\u0b3e\u0b2c\u0b28\u0b40: \u0b2b\u0b41\u0b32\u0b3f\u0b2f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b32\u0b3f\u0b25\u0b3f\u0b5f\u0b2e-\u0b06\u0b5f\u0b28 \u0b2c\u0b4d\u0b5f\u0b3e\u0b1f\u0b47\u0b30\u0b40\u0b15\u0b41 \u0b15\u0b47\u0b2c\u0b47 \u0b1a\u0b3e\u0b2a\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01, \u0b15\u0b23\u0b3e \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b3e\u0b23\u0b3f \u0b13 \u0b09\u0b24\u0b4d\u0b24\u0b3e\u0b2a \u0b38\u0b02\u0b38\u0b4d\u0b2a\u0b30\u0b4d\u0b36\u0b30\u0b47 \u0b06\u0b23\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b0f\u0b39\u0b3e\u0b15\u0b41 \u0b36\u0b41\u0b16\u0b3f\u0b32\u0b3e \u0b2a\u0b3e\u0b24\u0b4d\u0b30\u0b30\u0b47 \u0b30\u0b16\u0b28\u0b4d\u0b24\u0b41\u0964"},safety_burning:{answer:"\u0b2c\u0b3f\u0b2a\u0b26: \u0b24\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b24\u0b3e\u0b30 \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b2a\u0b4d\u0b32\u0b3e\u0b37\u0b4d\u0b1f\u0b3f\u0b15 \u0b15\u0b47\u0b2c\u0b47 \u0b2a\u0b4b\u0b21\u0b3c\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b16\u0b4b\u0b32\u0b3e\u0b30\u0b47 \u0b2a\u0b4b\u0b21\u0b3c\u0b3f\u0b2c\u0b3e \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b27\u0b42\u0b06\u0b01 \u0b0f\u0b2c\u0b02 \u0b38\u0b40\u0b38\u0b3e \u0b28\u0b3f\u0b30\u0b4d\u0b17\u0b24 \u0b39\u0b41\u0b0f\u0964 \u0b15\u0b47\u0b2c\u0b33 \u0b38\u0b4d\u0b71\u0b40\u0b15\u0b43\u0b24\u0b3f\u0b2a\u0b4d\u0b30\u0b3e\u0b2a\u0b4d\u0b24 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30\u0b19\u0b4d\u0b15\u0b41 \u0b2c\u0b3f\u0b15\u0b4d\u0b30\u0b3f \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41\u0964"},safety_acid:{answer:"\u0b17\u0b41\u0b30\u0b41\u0b24\u0b30 \u0b2c\u0b3f\u0b2a\u0b26: \u0b38\u0b41\u0b28\u0b3e \u0b2c\u0b3e\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2a\u0b3e\u0b07\u0b01 \u0b18\u0b30\u0b47 \u0b0f\u0b38\u0b3f\u0b21\u0b4d \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b30\u0b3e\u0b38\u0b3e\u0b5f\u0b28\u0b3f\u0b15 \u0b2a\u0b4d\u0b30\u0b15\u0b4d\u0b30\u0b3f\u0b5f\u0b3e \u0b2c\u0b4d\u0b5f\u0b2c\u0b39\u0b3e\u0b30 \u0b15\u0b30\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964 \u0b38\u0b4d\u0b5f\u0b3e\u0b28\u0b3e\u0b07\u0b21\u0b4d \u0b0f\u0b2c\u0b02 \u0b0f\u0b38\u0b3f\u0b21\u0b4d \u0b2a\u0b4d\u0b30\u0b3e\u0b23\u0b18\u0b3e\u0b24\u0b40 \u0b0f\u0b2c\u0b02 \u0b1c\u0b33 \u0b2a\u0b4d\u0b30\u0b26\u0b42\u0b37\u0b3f\u0b24 \u0b15\u0b30\u0b47\u0964"},safety_ppe:{answer:"\u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b2a\u0b30\u0b3f\u0b1a\u0b3e\u0b33\u0b28\u0b3e \u0b38\u0b2e\u0b5f\u0b30\u0b47 \u0b38\u0b30\u0b4d\u0b2c\u0b26\u0b3e \u0b2e\u0b4b\u0b1f\u0b3e \u0b17\u0b4d\u0b32\u0b4b\u0b2d\u0b4d\u0b38, \u0b2e\u0b3e\u0b38\u0b4d\u0b15 \u0b0f\u0b2c\u0b02 \u0b38\u0b41\u0b30\u0b15\u0b4d\u0b37\u0b3e \u0b1a\u0b37\u0b2e\u0b3e \u0b2a\u0b3f\u0b28\u0b4d\u0b27\u0b28\u0b4d\u0b24\u0b41\u0964"},safety_crt:{answer:"\u0b38\u0b3e\u0b2c\u0b27\u0b3e\u0b28: \u0b2a\u0b41\u0b30\u0b41\u0b23\u0b3e \u0b1f\u0b3f\u0b2d\u0b3f \u0b0f\u0b2c\u0b02 \u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b2e\u0b28\u0b3f\u0b1f\u0b30 \u0b2d\u0b19\u0b4d\u0b17\u0b41\u0b30 \u0b0f\u0b2c\u0b02 \u0b0f\u0b25\u0b3f\u0b30\u0b47 \u0b2c\u0b3f\u0b37\u0b3e\u0b15\u0b4d\u0b24 \u0b38\u0b40\u0b38\u0b3e \u0b25\u0b3e\u0b0f\u0964 \u0b38\u0b3f\u0b06\u0b30\u0b1f\u0b3f \u0b15\u0b3e\u0b1a\u0b15\u0b41 \u0b15\u0b47\u0b2c\u0b47 \u0b2d\u0b3e\u0b19\u0b4d\u0b17\u0b28\u0b4d\u0b24\u0b41 \u0b28\u0b3e\u0b39\u0b3f\u0b01\u0964"},report_dispute:{answer:"\u0b13\u0b1c\u0b28\u0b30\u0b47 \u0b24\u0b3e\u0b30\u0b24\u0b2e\u0b4d\u0b5f \u0b15\u0b3f\u0b2e\u0b4d\u0b2c\u0b3e \u0b1f\u0b19\u0b4d\u0b15\u0b3e \u0b15\u0b2e \u0b39\u0b47\u0b32\u0b47, \u0b06\u0b2a\u0b23 \u0b2b\u0b1f\u0b4b \u0b2a\u0b4d\u0b30\u0b2e\u0b3e\u0b23 \u0b38\u0b39\u0b3f\u0b24 \u0b24\u0b41\u0b30\u0b28\u0b4d\u0b24 \u0b05\u0b2d\u0b3f\u0b2f\u0b4b\u0b17 \u0b1f\u0b3f\u0b15\u0b47\u0b1f\u0b4d \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47\u0964"},dispute_policy:{answer:"\u0b05\u0b2d\u0b3f\u0b2f\u0b4b\u0b17 \u0b17\u0b41\u0b21\u0b3c\u0b3f\u0b15 \u0b09\u0b2d\u0b5f \u0b2a\u0b15\u0b4d\u0b37\u0b30 \u0b05\u0b21\u0b3f\u0b1f\u0b4d \u0b32\u0b17\u0b4d, \u0b1c\u0b3f\u0b2a\u0b3f\u0b0f\u0b38 \u0b0f\u0b2c\u0b02 \u0b30\u0b38\u0b3f\u0b26 \u0b2f\u0b3e\u0b1e\u0b4d\u0b1a \u0b15\u0b30\u0b3f \u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41 \u0b06\u0b21\u0b2e\u0b3f\u0b28\u0b4d \u0b26\u0b4d\u0b71\u0b3e\u0b30\u0b3e \u0b38\u0b2e\u0b3e\u0b27\u0b3e\u0b28 \u0b15\u0b30\u0b3e\u0b2f\u0b3e\u0b0f\u0964"},recycler_verification:{answer:"\u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41\u0b30\u0b47 \u0b32\u0b1f\u0b4d \u0b15\u0b3f\u0b23\u0b3f\u0b2c\u0b3e \u0b2a\u0b42\u0b30\u0b4d\u0b2c\u0b30\u0b41 \u0b30\u0b3f\u0b38\u0b3e\u0b07\u0b15\u0b4d\u0b32\u0b30\u0b2e\u0b3e\u0b28\u0b19\u0b4d\u0b15\u0b41 \u0b2c\u0b48\u0b27 \u0b38\u0b3f\u0b2a\u0b3f\u0b38\u0b3f\u0b2c\u0b3f/\u0b0f\u0b38\u0b2a\u0b3f\u0b38\u0b3f\u0b2c\u0b3f \u0b32\u0b3e\u0b07\u0b38\u0b47\u0b28\u0b4d\u0b38 \u0b0f\u0b2c\u0b02 \u0b1c\u0b3f\u0b0f\u0b38\u0b1f\u0b3f \u0b28\u0b2e\u0b4d\u0b2c\u0b30 \u0b26\u0b3e\u0b16\u0b32 \u0b15\u0b30\u0b3f\u0b2c\u0b3e \u0b2c\u0b3e\u0b27\u0b4d\u0b5f\u0b24\u0b3e\u0b2e\u0b42\u0b33\u0b15\u0964"},green_certificate:{answer:"\u0b38\u0b2b\u0b33\u0b24\u0b3e\u0b30 \u0b38\u0b39\u0b3f\u0b24 \u0b2a\u0b41\u0b28\u0b03\u0b1a\u0b15\u0b4d\u0b30\u0b23 \u0b39\u0b4b\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b2a\u0b4d\u0b30\u0b24\u0b4d\u0b5f\u0b47\u0b15 \u0b07-\u0b2c\u0b30\u0b4d\u0b1c\u0b4d\u0b5f \u0b2a\u0b3e\u0b07\u0b01 \u0b0f\u0b15 \u0b38\u0b30\u0b15\u0b3e\u0b30\u0b40 \u0b17\u0b4d\u0b30\u0b40\u0b28 \u0b38\u0b3e\u0b30\u0b4d\u0b1f\u0b3f\u0b2b\u0b3f\u0b15\u0b47\u0b1f\u0b4d \u0b0f\u0b2c\u0b02 \u0b2c\u0b1e\u0b4d\u0b1a\u0b3f\u0b25\u0b3f\u0b2c\u0b3e \u0b15\u0b3e\u0b30\u0b4d\u0b2c\u0b28 \u0b28\u0b3f\u0b30\u0b4d\u0b17\u0b2e\u0b28 (CO2) \u0b30\u0b47\u0b15\u0b30\u0b4d\u0b21 \u0b2e\u0b3f\u0b33\u0b47\u0964"},offline_mode:{answer:"\u0b07\u0b15\u0b4b\u0b38\u0b47\u0b24\u0b41 \u0b05\u0b2b\u0b32\u0b3e\u0b07\u0b28\u0b30\u0b47 \u0b2e\u0b27\u0b4d\u0b5f \u0b15\u0b3e\u0b2e \u0b15\u0b30\u0b47! \u0b06\u0b2a\u0b23 \u0b07\u0b23\u0b4d\u0b1f\u0b30\u0b28\u0b47\u0b1f\u0b4d \u0b2c\u0b3f\u0b28\u0b3e \u0b32\u0b1f\u0b4d \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b15\u0b30\u0b3f\u0b2a\u0b3e\u0b30\u0b3f\u0b2c\u0b47; \u0b28\u0b47\u0b1f\u0b71\u0b3e\u0b30\u0b4d\u0b15 \u0b06\u0b38\u0b3f\u0b32\u0b47 \u0b21\u0b3e\u0b1f\u0b3e \u0b06\u0b2a\u0b47 \u0b06\u0b2a\u0b47 \u0b38\u0b3f\u0b19\u0b4d\u0b15\u0b4d \u0b39\u0b4b\u0b07\u0b2f\u0b3f\u0b2c\u096